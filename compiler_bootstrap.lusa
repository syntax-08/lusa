-- compiler_bootstrap.lusa — Module 8.5 C11 backend.
--
-- Public API
-- ----------
--   local Compiler = require("compiler_bootstrap")
--   local c_source = Compiler.emit_c(ast)
--   local result   = Compiler.bootstrap(lexer, parser, source)
--   local ok       = Compiler.write_c("out.c", c_source)
--
-- The backend no longer emits PE/ELF images or x86_64 instructions.  It
-- performs a static type-checking pass, then lowers the typed AST to a
-- portable C11 translation unit.  The generated file uses the host C
-- toolchain for the final native executable.
--
-- Supported scalar types: i32, u32, i128 and f32.  `bool`, `string` and
-- homogeneous array tables are supported as helper types.  Untyped integer
-- literals default to i32 and untyped decimal literals default to f32.
--
-- Ownership remains static: owned heap locals receive a drop at lexical
-- scope exit, before return/break, and before assignment overwrites a value.
-- A move clears the source slot and cancels that source's drop.  `borrow`
-- aliases without ownership; `clone` performs a deep copy.  Before emission,
-- the checker tracks moved bindings, immutable borrow sites, and mutable
-- method receivers.  It rejects use-after-move (`E1001`), moves or writes
-- while aliased (`E1002`), and writes through an immutable alias (`E1004`)
-- without emitting any runtime borrow machinery.
--
-- `unsafe do ... end` disables borrow/mutation checks and enables the volatile
-- raw-pointer intrinsics unsafe_ptr_cast, unsafe_read_mem and unsafe_write_mem.
-- Generated C uses `*(volatile uint32_t *)(uintptr_t)a`.

local Compiler = {}

local COMPILER_VERSION = 3
Compiler.Version = COMPILER_VERSION
Compiler.Targets = { c = "c11" }

local function transfer(value)
    return value
end

local function fail(line, column, message)
    error("bootstrap:" .. tostring(line or 0) .. ":" .. tostring(column or 0)
        .. ": " .. message)
end

local function type_fail(code, line, column, message, expected, found)
    local parts = {
        "error[" .. code .. "]: " .. message,
        "  --> lusa:" .. tostring(line or 0) .. ":" .. tostring(column or 0)
    }
    if expected ~= nil then
        parts[#parts + 1] = "   = expected `" .. tostring(expected) .. "`"
    end
    if found ~= nil then
        parts[#parts + 1] = "   = found    `" .. tostring(found) .. "`"
    end
    error(table.concat(parts, "\n"))
end

local function is_integer(n)
    return type(n) == "number" and n == math.floor(n)
end

local function number_node(value, line, column, is_float)
    local float_kind = is_float == true or not is_integer(value)
    return {
        tag = "Number",
        value = value,
        float = float_kind,
        line = line,
        column = column
    }
end

local function bool_node(value, line, column)
    return {tag = "Bool", value = value, line = line, column = column}
end

local function string_node(value, raw, interpolated, line, column)
    return {
        tag = "String",
        value = value,
        raw = raw,
        interpolated = interpolated,
        line = line,
        column = column
    }
end

local function node_float(expr)
    if expr.tag ~= "Number" then
        return false
    end
    return expr.float == true or not is_integer(expr.value)
end

-- Literals above the f64 exact-integer range must not be folded: the C
-- emitter keeps their original digit string for an exact lusa_i128.
local function exact_big_int(expr)
    if expr == nil or expr.tag ~= "Number" or expr.int == nil then
        return false
    end
    -- 15 decimal digits always fit in f64's exact-integer range; any longer
    -- literal (or a hex spelling with the same length) is kept unfolded.
    return #expr.int > 15
end

-- =========================================================================
-- AST optimizer (ownership: every helper consumes its node argument)
-- =========================================================================

local function opt_expr(expr)
    local tag = expr.tag
    local line = expr.line
    local column = expr.column

    if tag == "Nil" or tag == "Bool" or tag == "Number"
        or tag == "String" or tag == "Name" then
        return expr
    end

    if tag == "Paren" then
        return opt_expr(expr.value)
    end

    if tag == "Unary" then
        -- Do not rewrite unary nodes: exact integer literals must retain their
        -- `int` spelling, and the checker/emitter handle `-`, `not` and `#`.
        return expr
    end

    if tag == "Binary" then
        local op = expr.op
        local lhs = opt_expr(expr.lhs)
        local rhs = opt_expr(expr.rhs)

        if lhs.tag == "Number" and rhs.tag == "Number"
            and not exact_big_int(lhs) and not exact_big_int(rhs) then
            local a = lhs.value
            local b = rhs.value
            local float_kind = node_float(lhs) or node_float(rhs)
            if op == "+" then
                return number_node(a + b, line, column, float_kind)
            end
            if op == "-" then
                return number_node(a - b, line, column, float_kind)
            end
            if op == "*" then
                return number_node(a * b, line, column, float_kind)
            end
            if op == "/" and b ~= 0 then
                return number_node(a / b, line, column, true)
            end
            if op == "//" and b ~= 0 then
                return number_node(math.floor(a / b), line, column, false)
            end
            if op == "%" and b ~= 0 then
                return number_node(a - math.floor(a / b) * b, line, column,
                    float_kind)
            end
            if op == "^" and b >= 0 and is_integer(b) then
                return number_node(a ^ b, line, column, float_kind)
            end
            if op == "==" then return bool_node(a == b, line, column) end
            if op == "~=" then return bool_node(a ~= b, line, column) end
            if op == "<" then return bool_node(a < b, line, column) end
            if op == "<=" then return bool_node(a <= b, line, column) end
            if op == ">" then return bool_node(a > b, line, column) end
            if op == ">=" then return bool_node(a >= b, line, column) end
        end

        if op == ".." and lhs.tag == "String" and rhs.tag == "String" then
            return string_node(lhs.value .. rhs.value, nil, false, line, column)
        end

        if op == "==" or op == "~=" then
            local known = false
            local equal = false
            local lt = lhs.tag
            local rt = rhs.tag
            if lt == rt then
                if lt == "Bool" or lt == "String" then
                    known = true
                    equal = lhs.value == rhs.value
                elseif lt == "Nil" then
                    known = true
                    equal = true
                end
            end
            if known then
                if op == "==" then return bool_node(equal, line, column) end
                return bool_node(not equal, line, column)
            end
        end

        return {
            tag = "Binary", op = op, lhs = lhs, rhs = rhs,
            line = line, column = column
        }
    end

    if tag == "Logical" then
        local op = expr.op
        local lhs = opt_expr(expr.lhs)
        if lhs.tag == "Bool" then
            if op == "and" then
                if lhs.value then return opt_expr(expr.rhs) end
                return lhs
            end
            if op == "or" then
                if lhs.value then return lhs end
                return opt_expr(expr.rhs)
            end
        end
        local rhs = opt_expr(expr.rhs)
        return {
            tag = "Logical", op = op, lhs = lhs, rhs = rhs,
            line = line, column = column
        }
    end

    if tag == "Call" then
        local callee = opt_expr(expr.callee)
        local args = expr.args
        local out = {}
        local i = 1
        while i <= #args do
            out[#out + 1] = opt_expr(args[i])
            i = i + 1
        end
        return {
            tag = "Call", callee = callee, args = out,
            line = line, column = column
        }
    end

    if tag == "Clone" or tag == "Borrow" or tag == "Move" then
        local value = opt_expr(expr.value)
        return {
            tag = tag, value = value, line = line, column = column
        }
    end

    if tag == "Table" then
        local items = expr.items
        local out = {}
        local i = 1
        while i <= #items do
            out[#out + 1] = opt_expr(items[i])
            i = i + 1
        end
        local keys = expr.keys
        if keys == nil then
            keys = {}
            local j = 1
            while j <= #out do
                keys[j] = nil
                j = j + 1
            end
        end
        return {
            tag = "Table", items = out, keys = keys,
            line = line, column = column
        }
    end

    if tag == "Index" then
        return {
            tag = "Index",
            table = opt_expr(expr.table),
            index = opt_expr(expr.index),
            line = line, column = column
        }
    end

    return expr
end

local opt_stmt

local function opt_block(body)
    local out = {}
    local i = 1
    while i <= #body do
        local stmt = body[i]
        local tag = stmt.tag
        out[#out + 1] = opt_stmt(stmt)
        if tag == "Return" or tag == "Break" then
            break
        end
        i = i + 1
    end
    return out
end

opt_stmt = function(stmt)
    local tag = stmt.tag
    local line = stmt.line
    local column = stmt.column

    if tag == "Local" then
        local values = stmt.values
        local out = {}
        local i = 1
        while i <= #values do
            out[#out + 1] = opt_expr(values[i])
            i = i + 1
        end
        return {
            tag = "Local", names = stmt.names, types = stmt.types,
            values = out, line = line, column = column
        }
    end

    if tag == "Assign" then
        local values = stmt.values
        local out = {}
        local i = 1
        while i <= #values do
            out[#out + 1] = opt_expr(values[i])
            i = i + 1
        end
        return {
            tag = "Assign", targets = stmt.targets, values = out,
            line = line, column = column
        }
    end

    if tag == "Function" then
        local params = {}
        local i = 1
        while i <= #stmt.params do
            params[#params + 1] = stmt.params[i]
            i = i + 1
        end
        return {
            tag = "Function",
            name = stmt.name,
            receiver = stmt.receiver,
            params = params,
            return_type = stmt.return_type,
            body = opt_block(stmt.body),
            line = line, column = column
        }
    end

    if tag == "CallStmt" then
        return {
            tag = "CallStmt", value = opt_expr(stmt.value),
            line = line, column = column
        }
    end

    if tag == "If" then
        local branches = stmt.branches
        -- `match` lowers a lone binding/wildcard arm to an `If` with only an
        -- `else` branch; there is no condition to optimize or emit.
        if #branches == 0 then
            if stmt.else_body == nil then
                return {tag = "Do", body = {}, line = line, column = column}
            end
            return {
                tag = "Do", body = opt_block(stmt.else_body),
                line = line, column = column
            }
        end
        local first_cond = opt_expr(branches[1].cond)
        if first_cond.tag == "Bool" then
            if first_cond.value then
                return {
                    tag = "Do", body = opt_block(branches[1].body),
                    line = line, column = column
                }
            end
            if #branches == 1 then
                if stmt.else_body == nil then
                    return {tag = "Do", body = {}, line = line, column = column}
                end
                return {
                    tag = "Do", body = opt_block(stmt.else_body),
                    line = line, column = column
                }
            end
            local rest = {}
            local j = 2
            while j <= #branches do
                rest[#rest + 1] = branches[j]
                j = j + 1
            end
            return opt_stmt({
                tag = "If", branches = rest, else_body = stmt.else_body,
                line = line, column = column
            })
        end

        local out = {}
        local i = 1
        while i <= #branches do
            local branch = branches[i]
            local cond
            if i == 1 then
                cond = first_cond
            else
                cond = opt_expr(branch.cond)
            end
            out[#out + 1] = {cond = cond, body = opt_block(branch.body)}
            i = i + 1
        end
        local else_body = nil
        if stmt.else_body ~= nil then
            else_body = opt_block(stmt.else_body)
        end
        return {
            tag = "If", branches = out, else_body = else_body,
            line = line, column = column
        }
    end

    if tag == "While" then
        local cond = opt_expr(stmt.cond)
        if cond.tag == "Bool" and not cond.value then
            return {tag = "Do", body = {}, line = line, column = column}
        end
        return {
            tag = "While", cond = cond, body = opt_block(stmt.body),
            line = line, column = column
        }
    end

    if tag == "Repeat" then
        return {
            tag = "Repeat", body = opt_block(stmt.body),
            cond = opt_expr(stmt.cond), line = line, column = column
        }
    end

    if tag == "Do" then
        return {
            tag = "Do", body = opt_block(stmt.body),
            line = line, column = column
        }
    end

    if tag == "Return" then
        local values = stmt.values
        local out = {}
        local i = 1
        while i <= #values do
            out[#out + 1] = opt_expr(values[i])
            i = i + 1
        end
        return {
            tag = "Return", values = out, line = line, column = column
        }
    end

    if tag == "Break" then
        return stmt
    end

    return stmt
end

local function optimize_impl(move_ast)
    if type(move_ast) ~= "table" or move_ast.tag ~= "Program" then
        error("bootstrap: optimize expects a Program AST")
    end
    local line = move_ast.line
    local column = move_ast.column
    local body = opt_block(move_ast.body)
    return {
        tag = "Program", body = body, line = line, column = column
    }
end

function Compiler.optimize(move_ast)
    return optimize_impl(move_ast)
end

-- =========================================================================
-- Static type checker
-- =========================================================================
--
-- The checker runs before any C text is produced.  It annotates the optimized
-- AST with resolved type names so the emitter never has to guess.  Errors use
-- Cargo-style `error[E....]` diagnostics and abort the compilation.

local TYPE_NAMES = {
    i32 = true, u32 = true, i128 = true, f32 = true,
    bool = true, string = true, table = true,
    ["nil"] = true, void = true, auto = true
}

local function table_element(type_name)
    if type_name == nil then
        return nil
    end
    if string.sub(type_name, 1, 6) == "table<"
        and string.sub(type_name, #type_name, #type_name) == ">" then
        return string.sub(type_name, 7, #type_name - 1)
    end
    return nil
end

-- ---- raw pointer and struct types (module 11) ----------------------------

-- Struct layouts are populated while checking top-level declarations.  The
-- table must exist before `is_struct_type` is defined so every helper closes
-- over the same local.
local check_structs = {}

local function pointer_element(type_name)
    if type_name == nil then
        return nil
    end
    if string.sub(type_name, 1, 7) == "*const " then
        return string.sub(type_name, 8)
    end
    if string.sub(type_name, 1, 5) == "*mut " then
        return string.sub(type_name, 6)
    end
    return nil
end

local function is_pointer_type(type_name)
    return pointer_element(type_name) ~= nil
end

local function is_mut_pointer(type_name)
    return type_name ~= nil and string.sub(type_name, 1, 5) == "*mut "
end

-- ---- fixed-size arrays (module 16) ---------------------------------------

-- `[T; N]` is spellt `array<T,N>` by both parsers.  The element spelling is
-- kept verbatim and canonicalised in one place, exactly like `table<T>`.
local function array_info(type_name)
    if type_name == nil then
        return nil
    end
    if string.sub(type_name, 1, 6) ~= "array<" then
        return nil
    end
    if string.sub(type_name, #type_name, #type_name) ~= ">" then
        return nil
    end
    local body = string.sub(type_name, 7, #type_name - 1)
    local comma = string.find(body, ",", 1, true)
    if comma == nil then
        return nil
    end
    local element = string.sub(body, 1, comma - 1)
    local length = tonumber(string.sub(body, comma + 1))
    if element == "" or length == nil then
        return nil
    end
    return element, math.floor(length)
end

local function is_array_type(type_name)
    return array_info(type_name) ~= nil
end

local function is_struct_type(type_name)
    return type_name ~= nil and check_structs[type_name] ~= nil
end

local function canonical_type(name, line, column)
    if name == "auto" then
        return "auto"
    end
    if name == "coroutine" then
        return name
    end
    if TYPE_NAMES[name] == true then
        return name
    end
    local array_element, array_length = array_info(name)
    if array_element ~= nil then
        if array_length < 1 or array_length > 1048576 then
            type_fail("E0301", line, column,
                "array length must be between 1 and 1048576, found "
                .. tostring(array_length))
        end
        local canonical = canonical_type(array_element, line, column)
        if canonical == "void" or canonical == "nil" or canonical == "auto" then
            type_fail("E0301", line, column,
                "invalid array element type `" .. tostring(canonical) .. "`")
        end
        return "array<" .. canonical .. "," .. tostring(array_length) .. ">"
    end
    local element = table_element(name)
    if element ~= nil then
        local canonical = canonical_type(element, line, column)
        if canonical == "void" or canonical == "nil" or canonical == "auto" then
            type_fail("E0301", line, column,
                "invalid table element type `" .. tostring(canonical) .. "`")
        end
        return "table<" .. canonical .. ">"
    end
    if is_pointer_type(name) then
        local element = pointer_element(name)
        local canonical = canonical_type(element, line, column)
        if canonical == "void" or canonical == "nil" or canonical == "auto" then
            type_fail("E0301", line, column,
                "invalid raw pointer element type `"
                .. tostring(canonical) .. "`")
        end
        if string.sub(name, 1, 5) == "*mut " then
            return "*mut " .. canonical
        end
        return "*const " .. canonical
    end
    if is_struct_type(name) then
        return name
    end
    type_fail("E0301", line, column,
        "unknown type `" .. tostring(name) .. "`")
end

local function is_numeric(type_name)
    return type_name == "i32" or type_name == "u32"
        or type_name == "i128" or type_name == "f32"
end

local function is_integer_type(type_name)
    return type_name == "i32" or type_name == "u32" or type_name == "i128"
end

local function struct_owns_heap(type_name)
    local pending = {type_name}
    local seen = {}
    local cursor = 1
    while cursor <= #pending do
        local current = pending[cursor]
        cursor = cursor + 1
        if seen[current] ~= true then
            seen[current] = true
            local layout = borrow check_structs[current]
            if layout ~= nil then
                local i = 1
                while i <= #layout.order do
                    local field_name = clone layout.order[i]
                    local field_slot = borrow layout.fields[field_name]
                    if field_slot == nil then
                        fail(0, 0, "internal: missing struct field "
                            .. tostring(current) .. "." .. tostring(field_name))
                    end
                    local field_type = field_slot.type
                    if field_type == "string" or field_type == "table"
                        or table_element(field_type) ~= nil then
                        return true
                    end
                    if check_structs[field_type] ~= nil
                        and seen[field_type] ~= true then
                        pending[#pending + 1] = field_type
                    end
                    i = i + 1
                end
            end
        end
    end
    return false
end

local function is_heap_type(type_name)
    if type_name == "string" or type_name == "table"
        or type_name == "coroutine" or type_name == "gmatch"
        or table_element(type_name) ~= nil then
        return true
    end
    local array_element = array_info(type_name)
    if array_element ~= nil then
        -- A fixed array embeds its elements, so it owns heap elements and
        -- needs a drop loop at scope exit.
        return is_heap_type(array_element)
    end
    if type_name == nil or check_structs[type_name] == nil then
        return false
    end
    -- Structs are value types in C, but a struct that owns strings, tables, or
    -- nested heap-bearing structs needs the same move/drop tracking as those
    -- fields.  Scalar-only structs remain plain copyable values.
    return struct_owns_heap(type_name)
end

local function is_table_type(type_name)
    return type_name == "table" or table_element(type_name) ~= nil
end

local function is_void(type_name)
    return type_name == "void"
end

-- A literal integer is polymorphic enough to satisfy any integer annotation,
-- exactly as an unsuffixed Rust literal does.  Non-literals must match.
local function literal_int(expr)
    if expr == nil then
        return nil
    end
    if expr.tag == "Paren" then
        return literal_int(expr.value)
    end
    if expr.tag == "Unary" and expr.op == "-" then
        local value = literal_int(expr.value)
        if value ~= nil then
            return -value
        end
        return nil
    end
    if expr.tag == "Number" and expr.float ~= true then
        return expr.value
    end
    return nil
end

local function integer_fits(type_name, value)
    if type_name == "i32" then
        return value >= -2147483648 and value <= 2147483647
    end
    if type_name == "u32" then
        return value >= 0 and value <= 4294967295
    end
    if type_name == "i128" then
        return value >= -1.0e38 and value <= 1.0e38
    end
    return false
end

local function assignable(target, source, expr)
    if target == source then
        return true
    end
    local target_elem, target_len = array_info(target)
    if target_elem ~= nil then
        local source_elem, source_len = array_info(source)
        if source_elem == nil or source_len ~= target_len then
            return false
        end
        if expr ~= nil and expr.tag == "Array" then
            local item_types = expr.item_types or {}
            local i = 1
            while i <= #item_types do
                if not assignable(target_elem, item_types[i], expr.items[i]) then
                    return false
                end
                i = i + 1
            end
            return true
        end
        return target_elem == source_elem
    end
    if array_info(source) ~= nil then
        return false
    end
    if source == "nil" then
        return target == "nil"
            or (is_heap_type(target) and not is_struct_type(target))
    end
    if is_pointer_type(target) then
        -- integer addresses (literals or integer expressions) may initialize
        -- or be assigned into raw pointers; the emitter inserts the cast.
        if is_integer_type(source) then
            return true
        end
        return false
    end
    if is_struct_type(target) and source == "nil" then
        return false
    end
    if is_integer_type(target) then
        local value = literal_int(expr)
        if value ~= nil and integer_fits(target, value) then
            return true
        end
    end
    if target == "f32" then
        local value = literal_int(expr)
        if value ~= nil then
            return true
        end
    end
    if is_table_type(target) and source == "nil" then
        return true
    end
    return false
end

local function coerce_literal(expr, target)
    if expr == nil then
        return nil
    end
    local target_elem, _ = array_info(target)
    if target_elem ~= nil then
        if expr.tag == "Array" then
            local items = expr.items
            local types = expr.item_types or {}
            local i = 1
            while i <= #items do
                items[i] = coerce_literal(items[i], target_elem)
                types[i] = target_elem
                i = i + 1
            end
            expr.items = items
            expr.item_types = types
            expr.ctype = target
        end
        return expr
    end
    if expr.tag == "Paren" then
        expr.value = coerce_literal(expr.value, target)
        expr.ctype = target
        return expr
    end
    if expr.tag == "Unary" and expr.op == "-" then
        expr.value = coerce_literal(expr.value, target)
        expr.ctype = target
        return expr
    end
    if expr.tag == "Number" and is_numeric(target) then
        expr.ctype = target
        if target == "f32" then
            expr.float = true
        end
        return expr
    end
    if expr.tag == "Table" and table_element(target) ~= nil then
        local current = table_element(expr.ctype or "")
        if current == "nil" or current == nil then
            expr.ctype = target
            expr.elem_type = table_element(target)
            expr.elem_kind = nil
        end
    end
    return expr
end

local check_scopes = {}
local check_scope_count = 0
local check_states = {}
local check_next_state = 0
local check_globals = {}
local check_global_order = {}
local check_functions = {}
local check_function_order = {}
local check_struct_order = {}
local check_loop_depth = 0
local check_unsafe_depth = 0
local check_return_type = "i32"
local check_in_function = false
local check_current_function = nil

local function scope_enter()
    check_scope_count = check_scope_count + 1
    check_scopes[check_scope_count] = {vars = {}, order = {}, aliases = {}}
end

local function new_check_state()
    check_next_state = check_next_state + 1
    check_states[check_next_state] = {
        moved = false,
        borrows = {},
        mutable_borrow = false,
        mutable_site = nil
    }
    return check_next_state
end

local function state_of(entry_id)
    if entry_id == nil then return nil end
    local state = check_states[entry_id]
    if state ~= nil then
        local copy = clone state
        check_states[entry_id] = state
        return copy
    end
    return nil
end

local function scope_leave()
    local scope = check_scopes[check_scope_count]
    if scope ~= nil then
        local aliases = scope.aliases or {}
        local i = 1
        while i <= #aliases do
            local alias = aliases[i]
            local state = state_of(alias.owner_id)
            if state ~= nil then
                local out = {}
                local j = 1
                while j <= #state.borrows do
                    if state.borrows[j].alias_id ~= alias.alias_id then
                        out[#out + 1] = state.borrows[j]
                    end
                    j = j + 1
                end
                state.borrows = out
                check_states[alias.owner_id] = state
            end
            i = i + 1
        end
    end
    check_scopes[check_scope_count] = nil
    check_scope_count = check_scope_count - 1
end

local function scope_declare(name, type_name, own, borrowed, schema,
                              mutable, elem_type)
    local entry = {
        name = name,
        type = type_name,
        own = own == true,
        borrowed = borrowed == true,
        mutable = mutable == true,
        schema = schema,
        elem_type = elem_type,
        id = new_check_state()
    }
    local scope = check_scopes[check_scope_count]
    scope.vars[name] = clone entry
    local order = scope.order
    order[#order + 1] = clone entry
    scope.order = order
    check_scopes[check_scope_count] = scope
end

local function scope_lookup(name)
    local i = check_scope_count
    while i >= 1 do
        local scope = check_scopes[i]
        local entry = scope.vars[name]
        if entry ~= nil then
            local copy = clone entry
            scope.vars[name] = entry
            check_scopes[i] = scope
            return copy
        end
        check_scopes[i] = scope
        i = i - 1
    end
    return nil
end

local function value_lookup(name)
    local local_entry = scope_lookup(name)
    if local_entry ~= nil then
        return local_entry
    end
    local global = check_globals[name]
    if global ~= nil then
        local copy = clone global
        check_globals[name] = global
        return copy
    end
    return nil
end

local function declare_global(name, type_name, line, column, schema, elem_type)
    if type_name == "void" or type_name == "auto" then
        type_fail("E0301", line, column,
            "global `" .. name .. "` cannot have type `" .. tostring(type_name) .. "`")
    end
    local entry = {
        name = name,
        type = type_name,
        own = is_heap_type(type_name),
        borrowed = false,
        mutable = false,
        global = true,
        schema = schema,
        elem_type = elem_type,
        moved = false,
        id = new_check_state()
    }
    check_globals[name] = clone entry
    check_global_order[#check_global_order + 1] = clone entry
    return clone entry
end

local check_expr
local check_block
local check_stmt
local check_method_call

local function check_mismatch(line, column, context, expected, found)
    type_fail("E0308", line, column, "mismatched types in " .. context,
        expected, found)
end

-- ---- static ownership / borrow analysis --------------------------------

local function ownership_fail(code, line, column, message, note)
    local parts = {
        "error[" .. code .. "]: " .. message,
        "  --> lusa:" .. tostring(line or 0) .. ":" .. tostring(column or 0)
    }
    if note ~= nil then
        parts[#parts + 1] = "   = borrowed by `" .. tostring(note.by)
            .. "` at lusa:" .. tostring(note.line) .. ":" .. tostring(note.column)
    end
    error(table.concat(parts, "\n"))
end

local function is_move_type(type_name)
    return is_heap_type(type_name) and type_name ~= "string"
end

local function note_from_state(state)
    if state == nil then return nil end
    if #state.borrows > 0 then
        return state.borrows[1]
    end
    return state.mutable_site
end

local function check_entry_read(entry_id, name, line, column)
    local state = state_of(entry_id)
    if state == nil then return end
    if state.moved then
        ownership_fail("E1001", line, column,
            "use of moved-out value `" .. tostring(name) .. "`")
    end
    if state.mutable_borrow and check_unsafe_depth == 0 then
        ownership_fail("E1002", line, column,
            "cannot read `" .. tostring(name)
            .. "` while it is mutably borrowed by a method call",
            state.mutable_site)
    end
end

local function mark_entry_moved(entry_id, name, line, column)
    local state = state_of(entry_id)
    if state == nil then return end
    if state.moved then
        ownership_fail("E1001", line, column,
            "use of moved-out value `" .. tostring(name) .. "`")
    end
    local note = note_from_state(clone state)
    if note ~= nil and check_unsafe_depth == 0 then
        ownership_fail("E1002", line, column,
            "cannot move out of `" .. tostring(name)
            .. "` because it is borrowed",
            note)
    end
    state.moved = true
    check_states[entry_id] = state
end

local function reset_entry_state(entry_id)
    local state = state_of(entry_id)
    if state == nil then return end
    state.moved = false
    check_states[entry_id] = state
end

local function root_name_of(expr)
    local current = expr
    while current ~= nil
        and (current.tag == "Field" or current.tag == "Index") do
        current = current.table
    end
    if current ~= nil and current.tag == "Name" then
        return current.entry_id, current.entry_name or current.name
    end
    return nil, nil
end

local function add_immutable_borrow(owner_id, owner_name, alias_name,
                                    alias_id, line, column)
    local state = state_of(owner_id)
    if state == nil then return end
    if state.moved then
        ownership_fail("E1001", line, column,
            "cannot borrow moved-out value `" .. tostring(owner_name) .. "`")
    end
    if state.mutable_borrow then
        ownership_fail("E1002", line, column,
            "cannot borrow `" .. tostring(owner_name)
            .. "` while it is mutably borrowed",
            state.mutable_site)
    end
    state.borrows[#state.borrows + 1] = {
        by = alias_name,
        alias_id = alias_id,
        line = line,
        column = column
    }
    check_states[owner_id] = state
end

local function register_scope_alias(alias_name, owner_id, alias_id)
    local scope = check_scopes[check_scope_count]
    scope.aliases[#scope.aliases + 1] = {
        by = alias_name,
        owner_id = owner_id,
        alias_id = alias_id
    }
    check_scopes[check_scope_count] = scope
end

local function begin_mutable_borrow(entry, line, column)
    if entry == nil or entry.entry_id == nil then return nil end
    local state = state_of(entry.entry_id)
    if state == nil then return nil end
    if state.moved then
        ownership_fail("E1001", line, column,
            "use of moved-out value `" .. tostring(entry.entry_name) .. "`")
    end
    if entry.borrowed and entry.mutable ~= true then
        ownership_fail("E1004", line, column,
            "cannot call a mutating method through immutable borrow `"
            .. tostring(entry.entry_name) .. "`")
    end
    local note = note_from_state(clone state)
    if note ~= nil then
        ownership_fail("E1002", line, column,
            "cannot mutably borrow `" .. tostring(entry.entry_name)
            .. "` while another borrow is active",
            note)
    end
    state.mutable_borrow = true
    state.mutable_site = { by = entry.entry_name, line = line, column = column }
    check_states[entry.entry_id] = state
    return entry.entry_id
end

local function end_mutable_borrow(entry_id)
    if entry_id == nil then return end
    local state = state_of(entry_id)
    if state == nil then return end
    state.mutable_borrow = false
    state.mutable_site = nil
    check_states[entry_id] = state
end

local function consume_expr(checked, line, column)
    if checked == nil then return end
    if checked.tag == "Paren" then
        consume_expr(checked.value, line, column)
        return
    end
    if checked.tag ~= "Name" then return end
    if checked.own == false or not is_move_type(checked.ctype) then return end
    mark_entry_moved(checked.entry_id, checked.entry_name or checked.name,
        line or checked.line, column or checked.column)
end

local function check_owner_write(checked, line, column)
    if checked == nil or checked.tag ~= "Name" then return end
    local state = state_of(checked.entry_id)
    if state == nil then return end
    local note = note_from_state(clone state)
    if note ~= nil then
        ownership_fail("E1002", line, column,
            "cannot write `" .. tostring(checked.entry_name or checked.name)
            .. "` while it is borrowed",
            note)
    end
end

local function check_condition(expr, context)
    local checked, found = check_expr(expr)
    if found ~= "bool" then
        check_mismatch(checked.line, checked.column, context, "bool", found)
    end
    return checked, found
end

local function check_coroutine_arg(expr, expected, context)
    local checked, actual = check_expr(expr)
    if not assignable(expected, actual, clone checked) then
        check_mismatch(checked.line, checked.column, context, expected, actual)
    end
    return coerce_literal(checked, expected)
end

local function check_coroutine_handle(expr, context)
    local checked, actual = check_expr(expr)
    if actual ~= "coroutine" then
        check_mismatch(checked.line, checked.column, context,
            "coroutine", actual)
    end
    if checked.tag ~= "Name" then
        type_fail("E0319", checked.line, checked.column,
            "native coroutine handles must be named locals")
    end
    return checked
end

local function check_coroutine_call(expr, method)
    local args = expr.args or {}
    if method == "create" then
        if #args ~= 1 then
            type_fail("E0311", expr.line, expr.column,
                "`coroutine.create` takes one named function, found "
                .. tostring(#args))
        end
        local target = args[1]
        if target.tag ~= "Name" then
            type_fail("E0312", target.line, target.column,
                "native `coroutine.create` requires a direct named function")
        end
        local signature = borrow check_functions[target.name]
        if signature == nil then
            type_fail("E0310", target.line, target.column,
                "cannot find function `" .. target.name .. "` in this scope")
        end
        if signature.receiver ~= nil then
            type_fail("E0319", target.line, target.column,
                "native coroutines cannot use method receivers")
        end
        if #signature.params ~= 0 then
            type_fail("E0319", target.line, target.column,
                "native coroutine entry functions must take no parameters")
        end
        if signature.ret ~= "i32" then
            type_fail("E0319", target.line, target.column,
                "native coroutine entry functions must return `i32`")
        end
        expr.builtin = "coroutine_create"
        expr.fn_name = target.name
        expr.ctype = "coroutine"
        expr.elem_type = "i32"
        expr.own = true
        expr.args = {}
        return expr, "coroutine"
    end

    if method == "yield" then
        if check_current_function == nil then
            type_fail("E0319", expr.line, expr.column,
                "`coroutine.yield` can only appear inside a function")
        end
        if #args > 1 then
            type_fail("E0311", expr.line, expr.column,
                "`coroutine.yield` takes at most one `i32` value")
        end
        if #args == 1 then
            expr.args = { check_coroutine_arg(args[1], "i32",
                "`coroutine.yield` value") }
        else
            expr.args = {}
        end
        expr.builtin = "coroutine_yield"
        expr.ctype = "i32"
        return expr, "i32"
    end

    if method == "status" then
        if #args ~= 1 then
            type_fail("E0311", expr.line, expr.column,
                "`coroutine.status` takes one coroutine")
        end
        expr.args = { check_coroutine_handle(args[1],
            "`coroutine.status` handle") }
        expr.builtin = "coroutine_status"
        expr.ctype = "string"
        expr.own = true
        return expr, "string"
    end

    if method == "close" then
        if #args ~= 1 then
            type_fail("E0311", expr.line, expr.column,
                "`coroutine.close` takes one coroutine")
        end
        expr.args = { check_coroutine_handle(args[1],
            "`coroutine.close` handle") }
        expr.builtin = "coroutine_close"
        expr.ctype = "bool"
        return expr, "bool"
    end

    if method == "isyieldable" then
        if #args ~= 0 then
            type_fail("E0311", expr.line, expr.column,
                "`coroutine.isyieldable` takes no arguments")
        end
        expr.builtin = "coroutine_isyieldable"
        expr.ctype = "bool"
        return expr, "bool"
    end

    if method == "resume" then
        type_fail("E0317", expr.line, expr.column,
            "native `coroutine.resume` must be used as a local initializer: "
            .. "`local ok, value = coroutine.resume(co, arg)` or "
            .. "`local ok, value, err = coroutine.resume(co, arg)`")
    end

    type_fail("E0319", expr.line, expr.column,
        "unsupported native coroutine operation `" .. tostring(method) .. "`")
end

-- ---- Module 13 string patterns -------------------------------------------

local function string_unwrap(expr)
    local current = expr
    while current ~= nil and current.tag == "Paren" do
        current = current.value
    end
    return current
end

local function string_literal(expr)
    local value = string_unwrap(expr)
    if value ~= nil and value.tag == "String"
        and value.interpolated ~= true then
        return value.value
    end
    return nil
end

local function pattern_fail(message, line, column)
    type_fail("E0323", line, column, "malformed string pattern: " .. message)
end

local function scan_pattern_set(pat, start, line, column)
    local i = start + 1
    if string.sub(pat, i, i) == "^" then i = i + 1 end
    if string.sub(pat, i, i) == "]" then i = i + 1 end
    while i <= #pat do
        local c = string.sub(pat, i, i)
        if c == "]" then
            return i + 1
        elseif c == "%" then
            if i == #pat then
                pattern_fail("'%' at end of character set", line, column)
            end
            i = i + 2
        else
            i = i + 1
        end
    end
    pattern_fail("missing ']' in character set", line, column)
end

local function analyze_pattern(pat, line, column)
    local captures = 0
    local open = 0
    local i = 1
    while i <= #pat do
        local c = string.sub(pat, i, i)
        if c == "%" then
            if i == #pat then
                pattern_fail("'%' at end of pattern", line, column)
            end
            local escaped = string.sub(pat, i + 1, i + 1)
            if escaped == "b" then
                if i + 3 > #pat then
                    pattern_fail("'%b' needs two characters", line, column)
                end
                i = i + 4
            elseif escaped == "f" then
                if string.sub(pat, i + 2, i + 2) ~= "[" then
                    pattern_fail("'%f' must be followed by a set", line, column)
                end
                i = scan_pattern_set(pat, i + 2, line, column)
            elseif escaped >= "0" and escaped <= "9" then
                local index = tonumber(escaped)
                if index == 0 or index > captures then
                    pattern_fail("back reference %" .. escaped
                        .. " has no earlier capture", line, column)
                end
                i = i + 2
            else
                i = i + 2
            end
        elseif c == "[" then
            i = scan_pattern_set(pat, i, line, column)
        elseif c == "(" then
            captures = captures + 1
            if captures > 32 then
                pattern_fail("too many captures (maximum is 32)", line, column)
            end
            if string.sub(pat, i + 1, i + 1) == ")" then
                i = i + 2
            else
                open = open + 1
                i = i + 1
            end
        elseif c == ")" then
            if open == 0 then
                pattern_fail("unmatched ')'", line, column)
            end
            open = open - 1
            i = i + 1
        else
            i = i + 1
        end
    end
    if open > 0 then
        pattern_fail("unfinished capture", line, column)
    end
    return captures
end

local function analyze_replacement(replacement, captures, line, column)
    local i = 1
    while i <= #replacement do
        if string.sub(replacement, i, i) ~= "%" then
            i = i + 1
        else
            if i == #replacement then
                type_fail("E0323", line, column,
                    "invalid use of '%' in replacement string")
            end
            local escaped = string.sub(replacement, i + 1, i + 1)
            if escaped == "%" then
                i = i + 2
            elseif escaped >= "0" and escaped <= "9" then
                local index = tonumber(escaped)
                if index > captures then
                    type_fail("E0324", line, column,
                        "replacement references capture %" .. escaped
                        .. " but the pattern has " .. tostring(captures)
                        .. " capture(s)",
                        "capture index <= " .. tostring(captures),
                        "%" .. escaped)
                end
                i = i + 2
            else
                type_fail("E0323", line, column,
                    "invalid replacement escape `%" .. escaped
                    .. "`; use `%0`..`%9` or `%%`")
            end
        end
    end
end

local string_methods = {
    find = true,
    ["match"] = true,
    gmatch = true,
    gsub = true
}

local function string_api_name(expr)
    if expr == nil then return nil end
    if expr.tag == "Call" and expr.callee ~= nil
        and expr.callee.tag == "Field" and expr.callee.table ~= nil
        and expr.callee.table.tag == "Name"
        and expr.callee.table.name == "string" then
        return expr.callee.field_name
    end
    if expr.tag == "MethodCall" then
        return expr.name
    end
    return nil
end

local function is_string_api(expr)
    local name = string_api_name(expr)
    return name ~= nil and string_methods[name] == true
end

local function check_string_operand(expr, line, column, what)
    local checked, actual = check_expr(expr)
    if actual ~= "string" then
        check_mismatch(line, column, what, "string", actual)
    end
    return checked
end

local function check_integer_operand(expr, line, column, what)
    local checked, actual = check_expr(expr)
    if actual ~= "i32" and actual ~= "u32" then
        check_mismatch(line, column, what, "i32", actual)
    end
    return coerce_literal(checked, "i32")
end

local function check_boolean_operand(expr, line, column, what)
    local checked, actual = check_expr(expr)
    if actual ~= "bool" then
        check_mismatch(line, column, what, "bool", actual)
    end
    return checked
end

-- `context` is "expression", "local" or "gmatch".  Gmatch is only legal in a
-- generic `for`, while find/gsub additionally support two-name local forms.
local function check_string_operation(expr, checked_source, source_type,
                                      args, name, context)
    if source_type ~= "string" then
        check_mismatch(expr.line, expr.column,
            "string method receiver", "string", source_type)
    end
    local min_args = 1
    local max_args = 1
    if name == "find" then
        min_args = 1
        max_args = 3
    elseif name == "match" then
        min_args = 1
        max_args = 2
    elseif name == "gsub" then
        min_args = 2
        max_args = 3
    elseif name == "gmatch" then
        if context ~= "gmatch" then
            type_fail("E0317", expr.line, expr.column,
                "native `string.gmatch` must be used as a generic `for` iterator")
        end
    end
    if #args < min_args or #args > max_args then
        local expected = tostring(min_args)
        if min_args ~= max_args then
            expected = tostring(min_args) .. " to " .. tostring(max_args)
        end
        type_fail("E0311", expr.line, expr.column,
            "`string." .. name .. "` expects " .. expected
            .. " argument(s) after the subject, found " .. tostring(#args))
    end

    local pattern_expr = args[1]
    local pattern_line = pattern_expr.line
    local pattern_column = pattern_expr.column
    local checked_pattern = check_string_operand(pattern_expr,
        pattern_line, pattern_column,
        "`string." .. name .. "` pattern")
    local capture_count = nil
    local literal = string_literal(clone checked_pattern)
    if literal ~= nil then
        capture_count = analyze_pattern(literal,
            checked_pattern.line, checked_pattern.column)
    end

    local source_copy = clone checked_source
    local pattern_copy = clone checked_pattern
    expr.builtin = "string_" .. name
    expr.string_source = checked_source
    expr.string_pattern = checked_pattern
    expr.string_capture_count = capture_count
    expr.args = { source_copy, pattern_copy }

    if name == "find" then
        if #args >= 2 then
            local init = args[2]
            local init_line = init.line
            local init_column = init.column
            local checked_init = check_integer_operand(init,
                init_line, init_column, "`string.find` init")
            local init_copy = clone checked_init
            expr.string_init = checked_init
            expr.args[#expr.args + 1] = init_copy
        end
        if #args >= 3 then
            local plain_arg = args[3]
            local plain_line = plain_arg.line
            local plain_column = plain_arg.column
            local checked_plain = check_boolean_operand(plain_arg,
                plain_line, plain_column, "`string.find` plain flag")
            local plain_copy = clone checked_plain
            expr.string_plain = checked_plain
            expr.args[#expr.args + 1] = plain_copy
        end
        expr.ctype = "i32"
        expr.own = false
        return expr, "i32"
    end

    if name == "match" then
        if #args >= 2 then
            local init = args[2]
            local init_line = init.line
            local init_column = init.column
            local checked_init = check_integer_operand(init,
                init_line, init_column, "`string.match` init")
            local init_copy = clone checked_init
            expr.string_init = checked_init
            expr.args[#expr.args + 1] = init_copy
        end
        expr.ctype = "string"
        expr.own = true
        return expr, "string"
    end

    if name == "gsub" then
        local replacement_expr = args[2]
        local replacement_line = replacement_expr.line
        local replacement_column = replacement_expr.column
        local checked_replacement = check_string_operand(replacement_expr,
            replacement_line, replacement_column,
            "`string.gsub` replacement")
        local replacement_line_checked = checked_replacement.line
        local replacement_column_checked = checked_replacement.column
        local replacement_copy = clone checked_replacement
        expr.string_replacement = checked_replacement
        expr.args[#expr.args + 1] = replacement_copy
        if #args >= 3 then
            local limit = args[3]
            local limit_line = limit.line
            local limit_column = limit.column
            local checked_limit = check_integer_operand(limit,
                limit_line, limit_column, "`string.gsub` limit")
            local limit_copy = clone checked_limit
            expr.string_limit = checked_limit
            expr.args[#expr.args + 1] = limit_copy
        end
        local replacement_literal = string_literal(clone expr.string_replacement)
        if replacement_literal ~= nil then
            analyze_replacement(replacement_literal,
                capture_count == nil and 9 or capture_count,
                replacement_line_checked, replacement_column_checked)
        end
        expr.ctype = "string"
        expr.own = true
        return expr, "string"
    end

    expr.ctype = "gmatch"
    expr.own = true
    return expr, "gmatch"
end

local function check_call(expr)
    local callee = borrow expr.callee
    if callee.tag == "Field" then
        local receiver = borrow callee.table
        if receiver.tag == "Name" and receiver.name == "coroutine" then
            return check_coroutine_call(expr, callee.field_name)
        end
        if receiver.tag == "Name" and receiver.name == "string" then
            if string_methods[callee.field_name] ~= true then
                type_fail("E0319", expr.line, expr.column,
                    "unsupported native string operation `"
                    .. tostring(callee.field_name) .. "`")
            end
            if #expr.args < 1 then
                type_fail("E0311", expr.line, expr.column,
                    "`string." .. callee.field_name
                    .. "` requires a subject string")
            end
            local source_expr = clone expr.args[1]
            local checked_source, source_type = check_expr(source_expr)
            local rest = {}
            local i = 2
            while i <= #expr.args do
                rest[#rest + 1] = clone expr.args[i]
                i = i + 1
            end
            return check_string_operation(expr, checked_source, source_type,
                rest, callee.field_name, "expression")
        end
    end
    if callee.tag ~= "Name" then
        type_fail("E0312", expr.line, expr.column,
            "only direct calls to named functions are supported by the C backend")
    end
    local name = callee.name
    local args = expr.args
    local i = 1

    if name == "unsafe_ptr_cast" or name == "unsafe_read_mem"
        or name == "unsafe_write_mem"
        or name == "unsafe_alloc"
        or name == "volatile_read" or name == "volatile_write"
        or name == "unsafe_nop" or name == "unsafe_asm"
        or name == "asm" then
        if check_unsafe_depth == 0 then
            local intrinsic_kind = "raw pointer intrinsic"
            if name == "asm" then
                intrinsic_kind = "inline assembly"
            end
            type_fail("E0316", expr.line, expr.column,
                intrinsic_kind .. " `" .. name
                .. "` is only allowed inside an `unsafe` block")
        end
        if name == "volatile_read" or name == "volatile_write" then
            local wanted = 1
            if name == "volatile_write" then
                wanted = 2
            end
            if #args ~= wanted then
                type_fail("E0311", expr.line, expr.column,
                    "`" .. name .. "` takes " .. tostring(wanted)
                    .. " argument(s), found " .. tostring(#args))
            end
            local checked_addr, addr_type = check_expr(args[1])
            local addr_line = checked_addr.line
            local addr_column = checked_addr.column
            args[1] = checked_addr
            local element = pointer_element(addr_type)
            if element == nil then
                if not is_integer_type(addr_type) then
                    check_mismatch(addr_line, addr_column,
                        "volatile address", "integer or raw pointer", addr_type)
                end
                -- A bare integer address has no element type; default to the
                -- register width used by the other raw-memory intrinsics.
                element = "u32"
            end
            if element ~= "u32" and element ~= "i32" and element ~= "i128"
                and element ~= "f32" and element ~= "bool" then
                type_fail("E0312", addr_line, addr_column,
                    "volatile access supports scalar elements only, found `"
                    .. tostring(element) .. "`")
            end
            if name == "volatile_write" then
                local checked_value, value_type = check_expr(args[2])
                if not assignable(element, value_type, clone checked_value) then
                    check_mismatch(checked_value.line, checked_value.column,
                        "volatile value", element, value_type)
                end
                checked_value = coerce_literal(checked_value, element)
                args[2] = checked_value
                expr.ctype = "void"
            else
                expr.ctype = element
            end
            expr.builtin = name
            expr.elem_type = element
            expr.args = args
            local result_type = expr.ctype
            return expr, result_type
        end
        if name == "unsafe_nop" then
            if #args ~= 0 then
                type_fail("E0311", expr.line, expr.column,
                    "`unsafe_nop` takes no arguments, found "
                    .. tostring(#args))
            end
            expr.ctype = "void"
            expr.builtin = name
            expr.args = args
            return expr, "void"
        end
        if name == "unsafe_asm" or name == "asm" then
            local label = "`unsafe_asm`"
            if name == "asm" then
                label = "`asm!`"
            end
            if #args ~= 1 then
                type_fail("E0311", expr.line, expr.column,
                    label .. " takes one string argument, found "
                    .. tostring(#args))
            end
            local checked_text, text_type = check_expr(args[1])
            if text_type ~= "string" then
                check_mismatch(checked_text.line, checked_text.column,
                    label .. " text", "string", text_type)
            end
            if checked_text.tag ~= "String" then
                type_fail("E0312", checked_text.line, checked_text.column,
                    label .. " requires a string literal")
            end
            local asm_text = checked_text.value or ""
            if asm_text == "" then
                type_fail("E0312", checked_text.line, checked_text.column,
                    label .. " text must not be empty")
            end
            if string.find(asm_text, '"', 1, true) ~= nil
                or string.find(asm_text, "\\", 1, true) ~= nil
                or string.find(asm_text, "\n", 1, true) ~= nil
                or string.find(asm_text, "\r", 1, true) ~= nil then
                type_fail("E0312", checked_text.line, checked_text.column,
                    label .. " text must not contain quotes, backslashes, or newlines")
            end
            args[1] = checked_text
            expr.ctype = "void"
            expr.builtin = name
            expr.args = args
            expr.asm_text = asm_text
            return expr, "void"
        end
        if name == "unsafe_alloc" then
            if #args ~= 1 then
                type_fail("E0311", expr.line, expr.column,
                    "`unsafe_alloc` takes one `u32` byte count, found "
                    .. tostring(#args))
            end
            local checked_bytes, bytes_type = check_expr(args[1])
            if not is_integer_type(bytes_type) then
                check_mismatch(checked_bytes.line, checked_bytes.column,
                    "`unsafe_alloc` size", "integer", bytes_type)
            end
            args[1] = checked_bytes
            expr.ctype = "*mut u32"
            expr.builtin = name
            expr.args = args
            return expr, "*mut u32"
        end
        local wanted = 1
        if name == "unsafe_write_mem" then
            wanted = 2
        end
        if #args ~= wanted then
            type_fail("E0311", expr.line, expr.column,
                "`" .. name .. "` takes " .. tostring(wanted)
                .. " argument(s), found " .. tostring(#args))
        end
        local checked_addr, addr_type = check_expr(args[1])
        args[1] = checked_addr
        if not is_integer_type(addr_type) and not is_pointer_type(addr_type) then
            check_mismatch(args[1].line, args[1].column,
                "raw pointer address", "integer or raw pointer", addr_type)
        end
        if name == "unsafe_write_mem" then
            local checked_value, value_type = check_expr(args[2])
            args[2] = checked_value
            if not is_integer_type(value_type) then
                check_mismatch(args[2].line, args[2].column,
                    "raw memory value", "integer", value_type)
            end
            expr.ctype = "void"
            expr.builtin = name
            expr.args = args
            return expr, "void"
        end
        expr.builtin = name
        expr.args = args
        if name == "unsafe_read_mem" then
            expr.ctype = "u32"
            return expr, "u32"
        end
        expr.ctype = "i128"
        return expr, "i128"
    end

    if name == "error" then
        if #args ~= 1 then
            type_fail("E0311", expr.line, expr.column,
                "`error` takes one string argument, found "
                .. tostring(#args))
        end
        local checked_message, message_type = check_expr(args[1])
        if message_type ~= "string" then
            check_mismatch(checked_message.line, checked_message.column,
                "`error` message", "string", message_type)
        end
        expr.args = { checked_message }
        expr.builtin = "error"
        expr.ctype = "void"
        return expr, "void"
    end

    if name == "assert" then
        if #args < 1 or #args > 2 then
            type_fail("E0311", expr.line, expr.column,
                "`assert` takes one condition and an optional message, found "
                .. tostring(#args))
        end
        local checked_condition, condition_type = check_expr(args[1])
        if condition_type ~= "bool" then
            check_mismatch(checked_condition.line, checked_condition.column,
                "`assert` condition", "bool", condition_type)
        end
        local checked_message = nil
        if #args == 2 then
            local message_type
            checked_message, message_type = check_expr(args[2])
            if message_type ~= "string" then
                check_mismatch(checked_message.line, checked_message.column,
                    "`assert` message", "string", message_type)
            end
        end
        expr.args = { checked_condition }
        if checked_message ~= nil then
            expr.args[2] = checked_message
        end
        expr.builtin = "assert"
        expr.ctype = "void"
        return expr, "void"
    end

    if name == "print" then
        while i <= #args do
            local checked_arg, arg_type = check_expr(args[i])
            if arg_type == "void" then
                type_fail("E0308", checked_arg.line, checked_arg.column,
                    "`print` cannot print a void expression")
            end
            if is_struct_type(arg_type) then
                type_fail("E0308", checked_arg.line, checked_arg.column,
                    "`print` cannot print a struct value")
            end
            args[i] = checked_arg
            i = i + 1
        end
        expr.ctype = "void"
        expr.builtin = "print"
        expr.args = args
        return expr, "void"
    end

    if name == "pcall" then
        type_fail("E0317", expr.line, expr.column,
            "native pcall must be used as a local initializer: "
            .. "`local ok, err = pcall(f, ...)` or "
            .. "`local ok, result, err = pcall(f, ...)`")
    end

    local signature = borrow check_functions[name]
    if signature == nil then
        type_fail("E0310", expr.line, expr.column,
            "cannot find function `" .. name .. "` in this scope")
    end
    if #args ~= #signature.params then
        type_fail("E0311", expr.line, expr.column,
            "function `" .. name .. "` takes " .. tostring(#signature.params)
            .. " argument(s) but " .. tostring(#args) .. " were supplied")
    end
    i = 1
    while i <= #args do
        local checked_arg, arg_type = check_expr(args[i])
        local param_type = signature.params[i].type
        if not assignable(param_type, arg_type, clone checked_arg) then
            check_mismatch(checked_arg.line, checked_arg.column,
                "argument " .. tostring(i) .. " of `" .. name .. "`",
                param_type, arg_type)
        end
        checked_arg = coerce_literal(checked_arg, param_type)
        if checked_arg.tag ~= "Clone" and checked_arg.tag ~= "Borrow"
            and checked_arg.tag ~= "Move" then
            consume_expr(clone checked_arg, checked_arg.line, checked_arg.column)
        end
        args[i] = checked_arg
        i = i + 1
    end
    expr.ctype = signature.ret
    expr.fn_name = name
    expr.args = args
    return expr, signature.ret
end

check_method_call = function(expr)
    local checked_obj, obj_type = check_expr(expr.obj)
    local receiver_tag = checked_obj.tag
    local receiver_name = checked_obj.name
    expr.obj = clone checked_obj
    if obj_type == "string" then
        local method_name = expr.name
        if string_methods[method_name] ~= true then
            type_fail("E0319", expr.line, expr.column,
                "unsupported native string method `" .. tostring(method_name) .. "`")
        end
        local method_args = clone expr.args
        return check_string_operation(expr, checked_obj, obj_type,
            method_args, method_name, "expression")
    end
    if not is_table_type(obj_type) then
        check_mismatch(expr.line, expr.column, "method receiver",
            "table", obj_type)
    end
    if receiver_tag ~= "Name" then
        type_fail("E0318", expr.line, expr.column,
            "method dispatch requires a named table receiver")
    end
    local key = receiver_name .. ":" .. expr.name
    if receiver_name == "self" and check_current_function ~= nil
        and check_current_function.receiver ~= nil then
        -- Inside a method, `self:other()` resolves through the enclosing
        -- receiver's method namespace.
        key = check_current_function.receiver .. ":" .. expr.name
    end
    local signature = borrow check_functions[key]
    if signature == nil then
        type_fail("E0318", expr.line, expr.column,
            "cannot find method `" .. tostring(expr.name)
            .. "` for receiver `" .. tostring(receiver_name) .. "`")
    end
    local args = expr.args
    if #args ~= #signature.params - 1 then
        type_fail("E0311", expr.line, expr.column,
            "method `" .. expr.name .. "` takes "
            .. tostring(#signature.params - 1) .. " argument(s) but "
            .. tostring(#args) .. " were supplied")
    end
    local borrow_id = nil
    if receiver_name ~= "self" and check_unsafe_depth == 0 then
        borrow_id = begin_mutable_borrow(checked_obj, expr.line, expr.column)
    end
    local i = 1
    while i <= #args do
        local checked_arg, arg_type = check_expr(args[i])
        local param = borrow signature.params[i + 1]
        if not assignable(param.type, arg_type, clone checked_arg) then
            check_mismatch(checked_arg.line, checked_arg.column,
                "argument " .. tostring(i) .. " of method `" .. expr.name .. "`",
                param.type, arg_type)
        end
        checked_arg = coerce_literal(checked_arg, param.type)
        if checked_arg.tag ~= "Clone" and checked_arg.tag ~= "Borrow"
            and checked_arg.tag ~= "Move" then
            consume_expr(clone checked_arg, checked_arg.line, checked_arg.column)
        end
        args[i] = checked_arg
        i = i + 1
    end
    end_mutable_borrow(borrow_id)
    expr.ctype = signature.ret
    expr.fn_key = key
    expr.args = args
    return expr, signature.ret
end

local function check_table(expr)
    local items = expr.items
    local keys = expr.keys or {}
    local schema = {}
    local elem_type = nil
    local has_keyed = false
    local i = 1
    while i <= #items do
        local checked_item, item_type = check_expr(items[i])
        if item_type == "void" then
            type_fail("E0308", checked_item.line, checked_item.column,
                "table element cannot have type `void`")
        end
        if item_type == "i128" then
            type_fail("E0312", checked_item.line, checked_item.column,
                "i128 table elements are not supported by the C ABI")
        end
        if checked_item.tag ~= "Clone" and checked_item.tag ~= "Borrow"
            and checked_item.tag ~= "Move" then
            consume_expr(clone checked_item, checked_item.line, checked_item.column)
        end
        local key = keys[i]
        if key ~= nil then
            has_keyed = true
            schema[key] = {
                type = item_type,
                schema = checked_item.schema
            }
        else
            if elem_type == nil then
                if item_type == "nil" then
                    elem_type = "nil"
                else
                    elem_type = item_type
                end
            elseif elem_type == "nil" and item_type ~= "nil" then
                elem_type = item_type
            elseif item_type ~= elem_type then
                if assignable(elem_type, item_type, clone checked_item) then
                    checked_item = coerce_literal(checked_item, elem_type)
                else
                    check_mismatch(checked_item.line, checked_item.column,
                        "table literal element", elem_type, item_type)
                end
            end
        end
        items[i] = checked_item
        i = i + 1
    end
    local result_type
    if has_keyed then
        result_type = "table"
    else
        if elem_type == nil then
            elem_type = "nil"
        end
        if elem_type == "i128" then
            type_fail("E0312", expr.line, expr.column,
                "i128 table elements are not supported by the C ABI")
        end
        result_type = "table<" .. elem_type .. ">"
    end
    expr.ctype = result_type
    expr.elem_type = elem_type
    expr.schema = schema
    expr.items = items
    expr.keys = keys
    return expr, result_type
end

local function check_struct_lit(expr)
    local layout = borrow check_structs[expr.name]
    if layout == nil then
        type_fail("E0301", expr.line, expr.column,
            "unknown struct `" .. tostring(expr.name) .. "`")
    end
    local fields = expr.fields or {}
    local seen = {}
    local i = 1
    while i <= #fields do
        local field = clone fields[i]
        local slot = borrow layout.fields[field.name]
        if slot == nil then
            type_fail("E0309", field.line, field.column,
                "struct `" .. expr.name .. "` has no field `"
                .. tostring(field.name) .. "`")
        end
        if seen[field.name] == true then
            type_fail("E0302", field.line, field.column,
                "duplicate field `" .. tostring(field.name)
                .. "` in struct literal")
        end
        seen[field.name] = true
        local checked, actual = check_expr(field.value)
        if not assignable(slot.type, actual, clone checked) then
            check_mismatch(checked.line, checked.column,
                "field `" .. field.name .. "` of `" .. expr.name .. "`",
                slot.type, actual)
        end
        checked = coerce_literal(checked, slot.type)
        if checked.tag ~= "Clone" and checked.tag ~= "Borrow"
            and checked.tag ~= "Move" then
            consume_expr(clone checked, checked.line, checked.column)
        end
        field.value = checked
        fields[i] = field
        i = i + 1
    end
    expr.fields = fields
    local struct_name = clone expr.name
    expr.ctype = clone struct_name
    return expr, struct_name
end

check_expr = function(expr)
    local tag = expr.tag
    local line = expr.line
    local column = expr.column

    if tag == "Nil" then
        expr.ctype = "nil"
        return expr, "nil"
    end

    if tag == "Bool" then
        expr.ctype = "bool"
        return expr, "bool"
    end

    if tag == "Number" then
        local exact_int = expr.int
        local numeric_value = expr.value
        local is_float = expr.float == true
        if exact_int == nil then
            is_float = is_float or not is_integer(numeric_value)
        end
        if is_float then
            expr.ctype = "f32"
        else
            if not integer_fits("i32", numeric_value) then
                expr.ctype = "i128"
            else
                expr.ctype = "i32"
            end
        end
        local result_type = expr.ctype
        return expr, result_type
    end

    if tag == "String" then
        if expr.interpolated == true then
            type_fail("E0312", line, column,
                "string interpolation is not supported by the C backend")
        end
        expr.ctype = "string"
        return expr, "string"
    end

    if tag == "Name" then
        local entry = value_lookup(expr.name)
        if entry == nil then
            type_fail("E0309", line, column,
                "cannot find value `" .. expr.name .. "` in this scope")
        end
        check_entry_read(entry.id, entry.name, line, column)
        expr.ctype = entry.type
        expr.own = entry.own
        expr.borrowed = entry.borrowed
        expr.mutable = entry.mutable
        expr.schema = entry.schema
        expr.elem_type = entry.elem_type
        expr.entry_id = entry.id
        expr.entry_name = entry.name
        return expr, entry.type
    end

    if tag == "Paren" then
        local checked_inner, inner = check_expr(expr.value)
        local inner_own = checked_inner.own
        local inner_borrowed = checked_inner.borrowed
        local inner_mutable = checked_inner.mutable
        local inner_schema = checked_inner.schema
        local inner_elem = checked_inner.elem_type
        local inner_id = checked_inner.entry_id
        local inner_name = checked_inner.entry_name
        expr.value = checked_inner
        expr.ctype = inner
        expr.own = inner_own
        expr.borrowed = inner_borrowed
        expr.mutable = inner_mutable
        expr.schema = inner_schema
        expr.elem_type = inner_elem
        expr.entry_id = inner_id
        expr.entry_name = inner_name
        return expr, inner
    end

    if tag == "Unary" then
        local op = expr.op
        local operand_node = clone expr
        local checked_operand, operand = check_expr(operand_node.value)
        local result = {
            tag = "Unary", op = op, value = checked_operand,
            line = line, column = column
        }
        if op == "not" then
            if operand ~= "bool" then
                check_mismatch(line, column, "unary `not`", "bool", operand)
            end
            result.ctype = "bool"
            return result, "bool"
        end
        if op == "#" then
            if operand ~= "string" and table_element(operand) == nil
                and not is_array_type(operand) then
                type_fail("E0308", line, column,
                    "the length operator requires a string, table, or fixed array",
                    "string | table | array<T,N>", operand)
            end
            result.ctype = "i32"
            return result, "i32"
        end
        if op == "-" then
            if not is_numeric(operand) or operand == "u32" then
                type_fail("E0308", line, column,
                    "unary `-` requires a signed numeric value",
                    "i32 | i128 | f32", operand)
            end
            result.ctype = operand
            return result, operand
        end
        type_fail("E0312", line, column,
            "unsupported unary operator `" .. tostring(op) .. "`")
    end

    if tag == "Binary" then
        local checked_lhs, lhs_type = check_expr(expr.lhs)
        local checked_rhs, rhs_type = check_expr(expr.rhs)
        local op = expr.op
        local result_type = nil

        -- Raw pointer arithmetic scales by the element size in the generated
        -- C (`ptr + 1` advances `sizeof(T)` bytes); the dynamic engines treat
        -- the same expression as a cell-index step.
        local lhs_pointer = pointer_element(lhs_type)
        local rhs_pointer = pointer_element(rhs_type)
        if op == "+" or op == "-" then
            if lhs_pointer ~= nil or rhs_pointer ~= nil then
                if check_unsafe_depth == 0 then
                    type_fail("E0320", line, column,
                        "raw pointer arithmetic requires an `unsafe` block")
                end
                local pointer_type = nil
                local offset_type = nil
                if lhs_pointer ~= nil then
                    if rhs_pointer ~= nil then
                        type_fail("E0308", line, column,
                            "cannot add or subtract two raw pointers")
                    end
                    pointer_type = lhs_type
                    offset_type = rhs_type
                else
                    pointer_type = rhs_type
                    offset_type = lhs_type
                    if op == "-" then
                        type_fail("E0308", line, column,
                            "cannot subtract a raw pointer from an integer")
                    end
                end
                if not is_integer_type(offset_type) then
                    check_mismatch(line, column, "pointer arithmetic",
                        "integer offset", offset_type)
                end
                expr.ctype = pointer_type
                expr.ptr_math = true
                expr.lhs = checked_lhs
                expr.rhs = checked_rhs
                return expr, pointer_type
            end
        end

        if op == ".." then
            if lhs_type ~= "string" or rhs_type ~= "string" then
                check_mismatch(line, column, "string concatenation",
                    "string .. string", lhs_type .. " .. " .. rhs_type)
            end
            result_type = "string"
        elseif op == "==" or op == "~=" or op == "<" or op == "<="
            or op == ">" or op == ">=" then
            local common = nil
            if is_numeric(lhs_type) and is_numeric(rhs_type) then
                if lhs_type == rhs_type then
                    common = lhs_type
                elseif assignable(lhs_type, rhs_type, clone checked_rhs) then
                    common = lhs_type
                    checked_rhs = coerce_literal(checked_rhs, lhs_type)
                elseif assignable(rhs_type, lhs_type, clone checked_lhs) then
                    common = rhs_type
                    checked_lhs = coerce_literal(checked_lhs, rhs_type)
                else
                    check_mismatch(line, column, "comparison",
                        lhs_type, rhs_type)
                end
            elseif lhs_type == rhs_type then
                common = lhs_type
                if common ~= "bool" and common ~= "string" and common ~= "nil" then
                    type_fail("E0308", line, column,
                        "values of type `" .. common .. "` cannot be compared")
                end
            else
                check_mismatch(line, column, "comparison", lhs_type, rhs_type)
            end
            expr.common_type = common
            result_type = "bool"
        elseif op == "+" or op == "-" or op == "*" or op == "/"
            or op == "//" or op == "%" or op == "^" then
            if not is_numeric(lhs_type) or not is_numeric(rhs_type) then
                check_mismatch(line, column, "arithmetic",
                    "numeric", lhs_type .. " and " .. rhs_type)
            end
            local common = lhs_type
            if lhs_type ~= rhs_type then
                if assignable(lhs_type, rhs_type, clone checked_rhs) then
                    common = lhs_type
                    checked_rhs = coerce_literal(checked_rhs, lhs_type)
                elseif assignable(rhs_type, lhs_type, clone checked_lhs) then
                    common = rhs_type
                    checked_lhs = coerce_literal(checked_lhs, rhs_type)
                else
                    check_mismatch(line, column, "arithmetic",
                        lhs_type, rhs_type)
                end
            end
            if op == "^" and common == "u32" then
                type_fail("E0312", line, column,
                    "integer exponentiation for `u32` is not supported; use i32, i128 or f32")
            end
            result_type = common
        else
            type_fail("E0312", line, column,
                "unsupported binary operator `" .. tostring(op) .. "`")
        end

        expr.ctype = result_type
        expr.lhs = checked_lhs
        expr.rhs = checked_rhs
        return expr, result_type
    end

    if tag == "Logical" then
        local checked_lhs, lhs_type = check_expr(expr.lhs)
        local checked_rhs, rhs_type = check_expr(expr.rhs)
        expr.lhs = checked_lhs
        expr.rhs = checked_rhs
        if lhs_type ~= "bool" or rhs_type ~= "bool" then
            check_mismatch(line, column, "logical `" .. expr.op .. "`",
                "bool", lhs_type .. " and " .. rhs_type)
        end
        expr.ctype = "bool"
        return expr, "bool"
    end

    if tag == "Call" then
        return check_call(expr)
    end

    if tag == "Clone" then
        local checked_inner, inner = check_expr(expr.value)
        local inner_schema = checked_inner.schema
        local inner_elem = checked_inner.elem_type
        expr.value = checked_inner
        expr.ctype = inner
        expr.own = true
        expr.schema = inner_schema
        expr.elem_type = inner_elem
        return expr, inner
    end

    if tag == "Move" then
        local checked_inner, inner = check_expr(expr.value)
        local inner_schema = checked_inner.schema
        local inner_elem = checked_inner.elem_type
        local inner_id = checked_inner.entry_id
        local inner_name = checked_inner.entry_name or checked_inner.name
        local inner_own = checked_inner.own
        expr.value = checked_inner
        expr.ctype = inner
        expr.own = true
        expr.schema = inner_schema
        expr.elem_type = inner_elem
        if inner_own ~= false and is_move_type(inner) then
            mark_entry_moved(inner_id, inner_name, line, column)
        end
        return expr, inner
    end

    if tag == "Borrow" then
        local checked_inner, inner = check_expr(expr.value)
        if checked_inner.tag ~= "Name" and checked_inner.tag ~= "Index"
            and checked_inner.tag ~= "Field" then
            type_fail("E0314", line, column,
                "`borrow` requires a variable, field, or index expression")
        end
        local inner_schema = checked_inner.schema
        local inner_elem = checked_inner.elem_type
        expr.value = clone checked_inner
        local owner_id, owner_name = root_name_of(checked_inner)
        expr.ctype = inner
        expr.own = false
        expr.borrowed = true
        expr.mutable = false
        expr.schema = inner_schema
        expr.elem_type = inner_elem
        expr.borrow_owner_id = owner_id
        expr.borrow_owner_name = owner_name
        return expr, inner
    end

    if tag == "Table" then
        return check_table(expr)
    end

    if tag == "StructLit" then
        return check_struct_lit(expr)
    end

    if tag == "Array" then
        local items = expr.items or {}
        local item_count = #items
        if item_count == 0 then
            type_fail("E0302", line, column,
                "cannot infer the element type of an empty array literal",
                "non-empty array literal", "[]")
        end
        local checked_items = {}
        local item_types = {}
        local elem = nil
        local i = 1
        while i <= item_count do
            local checked_item, item_type = check_expr(items[i])
            if item_type == "void" then
                type_fail("E0308", checked_item.line, checked_item.column,
                    "array element cannot have type `void`")
            end
            if elem == nil then
                elem = item_type
            elseif item_type ~= elem then
                local literal = literal_int(checked_item)
                if is_integer_type(elem) and literal ~= nil
                    and integer_fits(elem, literal) then
                    checked_item = coerce_literal(checked_item, elem)
                    item_type = elem
                else
                    check_mismatch(checked_item.line, checked_item.column,
                        "array literal", elem, item_type)
                end
            end
            if checked_item.tag ~= "Clone" and checked_item.tag ~= "Borrow"
                and checked_item.tag ~= "Move" then
                consume_expr(clone checked_item, checked_item.line,
                    checked_item.column)
            end
            checked_items[i] = checked_item
            item_types[i] = item_type
            i = i + 1
        end
        local type_name = "array<" .. elem .. "," .. tostring(item_count) .. ">"
        expr.items = checked_items
        expr.item_types = item_types
        expr.ctype = type_name
        expr.own = false
        return expr, type_name
    end

    if tag == "AddrOf" then
        local place = expr.value
        if place == nil or (place.tag ~= "Name" and place.tag ~= "Field"
            and place.tag ~= "Index" and place.tag ~= "Deref") then
            type_fail("E0312", line, column,
                "`&` requires a variable, field, index, or dereference")
        end
        local checked_place, place_type = check_expr(place)
        if place_type == "void" or place_type == "nil"
            or place_type == "auto" then
            type_fail("E0308", line, column,
                "cannot take the address of a `" .. tostring(place_type)
                .. "` value")
        end
        if is_array_type(place_type) then
            type_fail("E0312", line, column,
                "address-of an array is not supported; index the array directly")
        end
        local pointer_type = "*mut " .. place_type
        expr.value = checked_place
        expr.ctype = pointer_type
        expr.own = false
        return expr, pointer_type
    end

    if tag == "Index" then
        local checked_table, table_type = check_expr(expr.table)
        local table_schema = checked_table.schema
        local table_elem_type = checked_table.elem_type
        expr.table = checked_table
        local checked_index, index_type = check_expr(expr.index)
        local index_tag = checked_index.tag
        local index_value = checked_index.value
        expr.index = checked_index
        if index_tag == "String" and table_schema ~= nil then
            local field = table_schema[index_value]
            if field == nil then
                type_fail("E0309", line, column,
                    "table has no field `" .. tostring(index_value) .. "`")
            end
            expr.ctype = field.type
            expr.schema = field.schema
            expr.field_name = index_value
            expr.own = false
            return expr, field.type
        end
        if table_type == "table" and index_type == "string" then
            expr.ctype = "value"
            expr.dynamic_key = true
            expr.own = false
            return expr, "value"
        end
        local element = table_element(table_type)
        if element == nil and table_type == "table" then
            element = table_elem_type
        end
        local array_element, array_length = array_info(table_type)
        if array_element ~= nil then
            if not is_integer_type(index_type) then
                check_mismatch(line, column, "array index", "integer",
                    index_type)
            end
            expr.ctype = array_element
            expr.elem_type = array_element
            expr.array_access = true
            expr.array_length = array_length
            expr.own = false
            return expr, array_element
        end
        if element == nil then
            check_mismatch(line, column, "index expression",
                "table<...>", table_type)
        end
        if element == "nil" then
            type_fail("E0312", line, column,
                "cannot index an empty table without an element type")
        end
        if not is_integer_type(index_type) then
            check_mismatch(line, column, "table index", "integer", index_type)
        end
        expr.ctype = element
        expr.elem_type = element
        -- An array read is a view into the table; it never owns the element.
        expr.own = false
        return expr, element
    end

    if tag == "Field" then
        local checked_table, table_type = check_expr(expr.table)
        local table_schema = checked_table.schema
        expr.table = checked_table
        if is_struct_type(table_type) then
            local layout = borrow check_structs[table_type]
            local field = borrow layout.fields[expr.field_name]
            if field == nil then
                type_fail("E0309", line, column,
                    "struct `" .. tostring(table_type) .. "` has no field `"
                    .. tostring(expr.field_name) .. "`")
            end
            expr.ctype = field.type
            expr.struct_access = true
            expr.own = false
            return expr, field.type
        end
        if not is_table_type(table_type) then
            check_mismatch(line, column, "field access", "table", table_type)
        end
        local field = table_schema ~= nil
            and table_schema[expr.field_name] or nil
        if field == nil then
            type_fail("E0309", line, column,
                "table has no field `" .. tostring(expr.field_name) .. "`")
        end
        expr.ctype = field.type
        expr.schema = field.schema
        expr.own = false
        return expr, field.type
    end

    if tag == "Deref" then
        local checked_inner, inner_type = check_expr(expr.value)
        expr.value = checked_inner
        local element = pointer_element(inner_type)
        if element == nil then
            check_mismatch(line, column, "pointer dereference",
                "raw pointer", inner_type)
        end
        if check_unsafe_depth == 0 then
            type_fail("E0321", line, column,
                "raw pointer dereference requires an `unsafe` block")
        end
        expr.ctype = element
        expr.deref = true
        expr.own = false
        return expr, element
    end

    if tag == "MethodCall" then
        return check_method_call(expr)
    end

    type_fail("E0312", line, column,
        "unsupported expression node `" .. tostring(tag) .. "`")
end

local function check_pcall_local(stmt, names, stmt_types, values)
    local call = values[1]
    local args = call.args
    if #names ~= 2 and #names ~= 3 then
        type_fail("E0317", call.line, call.column,
            "native pcall must bind `local ok, err = pcall(f, ...)` or "
            .. "`local ok, result, err = pcall(f, ...)`")
    end
    local arg_count = #args
    if arg_count < 1 then
        type_fail("E0311", call.line, call.column,
            "`pcall` needs a function name as its first argument")
    end
    local target = args[1]
    if target.tag ~= "Name" then
        type_fail("E0312", target.line, target.column,
            "native `pcall` requires a direct named function")
    end
    local fname = target.name
    local signature = borrow check_functions[fname]
    if signature == nil then
        type_fail("E0310", target.line, target.column,
            "cannot find function `" .. fname .. "` in this scope")
    end
    local ret = signature.ret
    if ret == "void" and #names ~= 2 then
        type_fail("E0317", call.line, call.column,
            "a void function has no result; use `local ok, err = pcall("
            .. fname .. ", ...)`")
    end
    if #names == 2 and ret ~= "void" then
        -- Two names mean `ok, err`; the function result is discarded.  Use
        -- three names when the value matters.
    end
    if arg_count - 1 ~= #signature.params then
        type_fail("E0311", call.line, call.column,
            "function `" .. fname .. "` takes " .. tostring(#signature.params)
            .. " argument(s) but " .. tostring(arg_count - 1)
            .. " were supplied to pcall")
    end

    local target_args = {}
    local i = 2
    while i <= arg_count do
        local checked_arg, arg_type = check_expr(args[i])
        local param = borrow signature.params[i - 1]
        if not assignable(param.type, arg_type, clone checked_arg) then
            check_mismatch(checked_arg.line, checked_arg.column,
                "argument " .. tostring(i - 1) .. " of `" .. fname
                .. "` in pcall", param.type, arg_type)
        end
        checked_arg = coerce_literal(checked_arg, param.type)
        if checked_arg.tag ~= "Clone" and checked_arg.tag ~= "Borrow"
            and checked_arg.tag ~= "Move" then
            consume_expr(clone checked_arg, checked_arg.line, checked_arg.column)
        end
        target_args[i - 1] = checked_arg
        i = i + 1
    end

    call.args = target_args
    call.ctype = ret
    call.fn_name = fname
    call.callee = { tag = "Name", name = fname, line = target.line,
        column = target.column }
    call.pcall = true

    local types = { "bool" }
    local own = { false }
    if #names == 3 then
        types[2] = ret
        own[2] = is_heap_type(ret)
        types[3] = "string"
        own[3] = true
    else
        types[2] = "string"
        own[2] = true
    end

    i = 1
    while i <= #names do
        if stmt_types ~= nil and stmt_types[i] ~= nil then
            local declared = canonical_type(stmt_types[i], stmt.line, stmt.column)
            if declared ~= "auto" and declared ~= "nil" and declared ~= types[i] then
                check_mismatch(stmt.line, stmt.column,
                    "local `" .. names[i] .. "`", declared, types[i])
            end
        end
        i = i + 1
    end

    scope_declare(names[1], "bool", false, false)
    if #names == 3 then
        scope_declare(names[2], ret, is_heap_type(ret), false)
        scope_declare(names[3], "string", true, false)
    else
        scope_declare(names[2], "string", true, false)
    end

    stmt.pcall = { fn = fname, ret = ret, has_result = #names == 3 }
    stmt.own = own
    stmt.types = types
    stmt.values = { call }
    stmt.names = names
    return stmt
end

local function check_coroutine_resume_local(stmt, names, stmt_types, values)
    local call = values[1]
    local args = call.args
    if #names ~= 2 and #names ~= 3 then
        type_fail("E0317", call.line, call.column,
            "native coroutine.resume must bind `local ok, value = "
            .. "coroutine.resume(co, arg)` or `local ok, value, err = "
            .. "coroutine.resume(co, arg)`")
    end
    if #args < 1 or #args > 2 then
        type_fail("E0311", call.line, call.column,
            "`coroutine.resume` takes a coroutine and an optional `i32` value")
    end
    local checked_co = check_coroutine_handle(args[1],
        "`coroutine.resume` handle")
    local entry = value_lookup(checked_co.name)
    if entry == nil or entry.elem_type ~= "i32" then
        type_fail("E0319", checked_co.line, checked_co.column,
            "native coroutine entry functions must return `i32`")
    end
    local checked_arg = nil
    if #args == 2 then
        checked_arg = check_coroutine_arg(args[2], "i32",
            "`coroutine.resume` value")
    end
    local result_types = { "bool", "i32" }
    local own = { false, false }
    if #names == 3 then
        result_types[3] = "string"
        own[3] = true
    end
    local i = 1
    while i <= #names do
        if stmt_types ~= nil and stmt_types[i] ~= nil then
            local declared = canonical_type(stmt_types[i], stmt.line, stmt.column)
            if declared ~= "auto" and declared ~= "nil"
                and declared ~= result_types[i] then
                check_mismatch(stmt.line, stmt.column,
                    "local `" .. names[i] .. "`", declared, result_types[i])
            end
        end
        i = i + 1
    end
    call.builtin = "coroutine_resume"
    call.ctype = "coroutine_result"
    call.args = { checked_co }
    if checked_arg ~= nil then
        call.args[2] = checked_arg
    end
    stmt.coroutine_resume = { has_error = #names == 3 }
    i = 1
    while i <= #names do
        scope_declare(names[i], result_types[i], own[i], false)
        i = i + 1
    end
    stmt.types = result_types
    stmt.own = own
    stmt.values = { call }
    stmt.names = names
    return stmt
end

local function check_string_result_local(stmt, names, types, values)
    local checked, actual = check_expr(values[1])
    local builtin = checked.builtin
    if builtin == "string_find" then
        if #names ~= 2 then
            type_fail("E0311", stmt.line, stmt.column,
                "native `string.find` supports one result (`start`) or "
                .. "`local start, finish = ...`")
        end
        if actual ~= "i32" then
            type_fail("E0312", stmt.line, stmt.column,
                "internal: string.find must produce `i32`")
        end
        local result_types = { "i32", "i32" }
        local own = { false, false }
        local i = 1
        while i <= 2 do
            if types ~= nil and types[i] ~= nil then
                local declared = canonical_type(types[i], stmt.line, stmt.column)
                if declared ~= "auto" and declared ~= "nil"
                    and declared ~= result_types[i] then
                    check_mismatch(stmt.line, stmt.column,
                        "local `" .. names[i] .. "`", declared, result_types[i])
                end
            end
            i = i + 1
        end
        stmt.string_result = "find"
        stmt.values = { checked }
        i = 1
        while i <= #names do
            scope_declare(names[i], result_types[i], own[i], false)
            i = i + 1
        end
        stmt.names = names
        stmt.types = result_types
        stmt.own = own
        return stmt
    end
    if builtin == "string_gsub" then
        if #names ~= 2 then
            type_fail("E0311", stmt.line, stmt.column,
                "native `string.gsub` supports one result (the text) or "
                .. "`local text, count = ...`")
        end
        local result_types = { "string", "i32" }
        local own = { true, false }
        local i = 1
        while i <= 2 do
            if types ~= nil and types[i] ~= nil then
                local declared = canonical_type(types[i], stmt.line, stmt.column)
                if declared ~= "auto" and declared ~= "nil"
                    and declared ~= result_types[i] then
                    check_mismatch(stmt.line, stmt.column,
                        "local `" .. names[i] .. "`", declared, result_types[i])
                end
            end
            i = i + 1
        end
        stmt.string_result = "gsub"
        stmt.values = { checked }
        i = 1
        while i <= #names do
            scope_declare(names[i], result_types[i], own[i], false)
            i = i + 1
        end
        stmt.names = names
        stmt.types = result_types
        stmt.own = own
        return stmt
    end
    if builtin == "string_match" then
        type_fail("E0311", stmt.line, stmt.column,
            "native `string.match` returns one capture; bind it with a single local")
    end
    type_fail("E0317", stmt.line, stmt.column,
        "native `string.gmatch` must be used as a generic `for` iterator")
end

local function check_local(stmt)
    local names = stmt.names
    local types = stmt.types
    local values = stmt.values
    if values ~= nil and values[1] ~= nil and #names > 1 and #values == 1
        and is_string_api(clone values[1]) then
        return check_string_result_local(stmt, names, types, values)
    end
    if values ~= nil and values[1] ~= nil and values[1].tag == "Call"
        and values[1].callee ~= nil and values[1].callee.tag == "Name"
        and values[1].callee.name == "pcall" then
        return check_pcall_local(stmt, names, types, values)
    end
    if values ~= nil and values[1] ~= nil and values[1].tag == "Call"
        and values[1].callee ~= nil and values[1].callee.tag == "Field"
        and values[1].callee.table ~= nil
        and values[1].callee.table.tag == "Name"
        and values[1].callee.table.name == "coroutine"
        and values[1].callee.field_name == "resume" then
        return check_coroutine_resume_local(stmt, names, types, values)
    end
    if #values > #names then
        type_fail("E0311", stmt.line, stmt.column,
            "more initializers than local names are not supported")
    end

    local resolved = {}
    local owns = {}
    local borrows = {}
    local schemas = {}
    local elem_types = {}
    local alias_owner_ids = {}
    local alias_owner_names = {}
    local alias_lines = {}
    local alias_columns = {}
    local i = 1
    while i <= #names do
        local declared = "auto"
        if types ~= nil and types[i] ~= nil then
            declared = canonical_type(types[i], stmt.line, stmt.column)
        end
        local value = values[i]
        local actual = nil
        local checked = nil
        if value ~= nil then
            checked, actual = check_expr(value)
        end

        local final_type = declared
        local is_borrow = false
        if checked ~= nil then
            is_borrow = checked.tag == "Borrow"
        end
        if final_type == "auto" then
            if actual == nil then
                final_type = "nil"
            else
                final_type = actual
            end
        elseif actual ~= nil then
            if not assignable(final_type, actual, clone checked) then
                check_mismatch(checked.line, checked.column,
                    "local `" .. names[i] .. "`", final_type, actual)
            end
            checked = coerce_literal(checked, final_type)
        end

        if final_type == "void" then
            type_fail("E0301", stmt.line, stmt.column,
                "local `" .. names[i] .. "` cannot have type `void`")
        end
        local own = is_heap_type(final_type)
        if is_borrow then
            -- `borrow x` never owns its referent.
            own = false
        elseif checked ~= nil and checked.own == false then
            -- Strings and structs are value types, so a field/index read is
            -- copied into the new local. Tables stay non-owning aliases; the
            -- emitter deep-copies them only when they must escape
            -- (return/store).
            own = final_type == "string" or is_struct_type(final_type)
                or is_array_type(final_type)
        end
        resolved[i] = final_type
        owns[i] = own
        borrows[i] = is_borrow
        if checked ~= nil then
            schemas[i] = checked.schema
            elem_types[i] = checked.elem_type
            if is_borrow then
                alias_owner_ids[i] = checked.borrow_owner_id
                alias_owner_names[i] = checked.borrow_owner_name
                alias_lines[i] = checked.line
                alias_columns[i] = checked.column
            elseif checked.tag ~= "Clone" and checked.tag ~= "Move" then
                consume_expr(clone checked, checked.line, checked.column)
            end
            values[i] = checked
        end
        i = i + 1
    end

    i = 1
    while i <= #names do
        scope_declare(names[i], resolved[i], owns[i], borrows[i], schemas[i],
            false, elem_types[i])
        if borrows[i] and alias_owner_ids[i] ~= nil
            and check_unsafe_depth == 0 then
            local alias_entry = value_lookup(names[i])
            add_immutable_borrow(alias_owner_ids[i], alias_owner_names[i],
                names[i], alias_entry.id, alias_lines[i], alias_columns[i])
            register_scope_alias(names[i], alias_owner_ids[i], alias_entry.id)
        end
        i = i + 1
    end
    stmt.names = names
    stmt.values = values
    stmt.types = resolved
    stmt.own = owns
    return stmt
end

local function check_assign(stmt)
    local targets = stmt.targets
    local values = stmt.values
    local target_count = #targets
    if #values > target_count then
        type_fail("E0311", stmt.line, stmt.column,
            "more values than assignment targets are not supported")
    end
    local target_types = {}
    local i = 1
    while i <= target_count do
        local target = targets[i]
        if target.tag ~= "Name" and target.tag ~= "Field"
            and target.tag ~= "Deref" and target.tag ~= "Index" then
            type_fail("E0312", target.line, target.column,
                "only name, field, index, and dereference assignment targets are supported by the C backend")
        end
        local expected = nil
        if target.tag == "Name" then
            local entry = value_lookup(target.name)
            if entry == nil then
                if i <= #values then
                    local checked_value, actual = check_expr(clone values[i])
                    entry = declare_global(target.name, actual,
                        target.line, target.column, checked_value.schema,
                        checked_value.elem_type)
                else
                    entry = declare_global(target.name, "nil",
                        target.line, target.column)
                end
            end
            if entry.borrowed and check_unsafe_depth == 0 then
                type_fail("E1004", target.line, target.column,
                    "cannot assign through immutable borrow `" .. target.name
                    .. "`")
            end
            local target_state = state_of(entry.id)
            local target_note = note_from_state(target_state)
            if target_note ~= nil and check_unsafe_depth == 0 then
                ownership_fail("E1002", target.line, target.column,
                    "cannot assign to `" .. target.name
                    .. "` because it is borrowed", target_note)
            end
            target.entry_id = entry.id
            expected = entry.type
            entry.own = is_heap_type(entry.type)
        elseif target.tag == "Deref" then
            local checked_inner, inner_type = check_expr(target.value)
            target.value = checked_inner
            local element = pointer_element(inner_type)
            if element == nil then
                check_mismatch(target.line, target.column,
                    "pointer dereference assignment", "raw pointer", inner_type)
            end
            if check_unsafe_depth == 0 then
                type_fail("E0321", target.line, target.column,
                    "raw pointer dereference requires an `unsafe` block")
            end
            if not is_mut_pointer(inner_type) then
                type_fail("E0322", target.line, target.column,
                    "cannot write through a `*const` pointer")
            end
            expected = element
            target.deref_target = true
        elseif target.tag == "Index" then
            local checked_table, table_type = check_expr(target.table)
            local array_element = array_info(table_type)
            if array_element == nil then
                type_fail("E0312", target.line, target.column,
                    "indexed assignment supports fixed-size arrays only",
                    "array<T,N>", table_type)
            end
            local checked_index, index_type = check_expr(target.index)
            if not is_integer_type(index_type) then
                check_mismatch(target.line, target.column, "array index",
                    "integer", index_type)
            end
            target.table = checked_table
            target.index = checked_index
            target.array_access = true
            expected = array_element
            target.own = false
        else
            local checked_table, table_type = check_expr(target.table)
            local table_schema = checked_table.schema
            local table_borrowed = checked_table.borrowed
            local table_mutable = checked_table.mutable
            local table_label = checked_table.name
            target.table = clone checked_table
            if check_unsafe_depth == 0 and table_borrowed ~= true then
                check_owner_write(checked_table, target.line, target.column)
            end
            if is_struct_type(table_type) then
                local layout = borrow check_structs[table_type]
                local field = borrow layout.fields[target.field_name]
                if field == nil then
                    type_fail("E0309", target.line, target.column,
                        "struct `" .. tostring(table_type) .. "` has no field `"
                        .. tostring(target.field_name) .. "`")
                end
                expected = field.type
                target.struct_access = true
                target.own = false
            else
                if not is_table_type(table_type) then
                    check_mismatch(target.line, target.column,
                        "field assignment", "table", table_type)
                end
                if table_borrowed and table_mutable ~= true
                    and check_unsafe_depth == 0 then
                    type_fail("E1004", target.line, target.column,
                        "cannot write through immutable borrow `"
                        .. tostring(table_label) .. "`")
                end
                local field = table_schema ~= nil
                    and table_schema[target.field_name] or nil
                if field == nil then
                    type_fail("E0309", target.line, target.column,
                        "table has no field `" .. tostring(target.field_name) .. "`")
                end
                expected = field.type
                target.own = false
            end
        end

        local actual = nil
        local checked = nil
        if target.tag ~= "Index" and is_array_type(expected) then
            type_fail("E0312", target.line, target.column,
                "whole-array assignment is not supported; assign elements individually",
                "array element assignment", expected)
        end
        if i <= #values then
            checked, actual = check_expr(values[i])
            if not assignable(expected, actual, clone checked) then
                check_mismatch(target.line, target.column,
                    "assignment to `" .. tostring(target.name or target.field_name)
                    .. "`", expected, actual)
            end
            checked = coerce_literal(checked, expected)
            if checked.tag ~= "Clone" and checked.tag ~= "Borrow"
                and checked.tag ~= "Move" then
                consume_expr(clone checked, checked.line, checked.column)
            end
            values[i] = checked
        end
        if target.tag == "Name" and target.entry_id ~= nil then
            reset_entry_state(target.entry_id)
        end
        target_types[i] = expected
        targets[i] = target
        i = i + 1
    end
    stmt.targets = targets
    stmt.values = values
    stmt.target_types = target_types
    return stmt
end

local function check_function(signature)
    local previous_return = check_return_type
    local previous_loop = check_loop_depth
    local previous_unsafe = check_unsafe_depth
    local previous_in_function = check_in_function
    local previous_function = check_current_function

    check_return_type = signature.ret
    check_loop_depth = 0
    check_unsafe_depth = 0
    check_in_function = true
    check_current_function = signature
    if signature.receiver ~= nil then
        local receiver = value_lookup(signature.receiver)
        if receiver == nil then
            type_fail("E0318", signature.node.line, signature.node.column,
                "method receiver `" .. tostring(signature.receiver)
                .. "` is not declared")
        end
        if not is_table_type(receiver.type) then
            type_fail("E0318", signature.node.line, signature.node.column,
                "method receiver `" .. tostring(signature.receiver)
                .. "` must be a table, found `" .. tostring(receiver.type) .. "`")
        end
        signature.params[1].schema = receiver.schema
    end
    scope_enter()
    local i = 1
    while i <= #signature.params do
        local param = borrow signature.params[i]
        local is_self = signature.receiver ~= nil and i == 1
        scope_declare(param.name, param.type, false, true, param.schema,
            is_self, param.elem_type)
        local node_index = i
        if signature.receiver ~= nil then
            node_index = i - 1
        end
        if node_index >= 1 and node_index <= #signature.node.params then
            signature.node.params[node_index].type = param.type
        end
        i = i + 1
    end
    signature.node.body = check_block(signature.node.body, false)
    scope_leave()

    check_return_type = previous_return
    check_loop_depth = previous_loop
    check_unsafe_depth = previous_unsafe
    check_in_function = previous_in_function
    check_current_function = previous_function
    return signature
end

local function check_struct_decl(stmt)
    local line = stmt.line
    local column = stmt.column
    if check_structs[stmt.name] ~= nil then
        type_fail("E0302", line, column,
            "duplicate definition of struct `" .. stmt.name .. "`")
    end
    local packed = stmt.packed == true
    local align = stmt.align
    if align ~= nil then
        if type(align) ~= "number" or align < 1 or align > 4096
            or math.floor(align) ~= align then
            type_fail("E0312", line, column,
                "invalid alignment for struct `" .. stmt.name
                .. "`; use a power of two between 1 and 4096")
        end
        local probe = align
        while probe > 1 do
            if probe % 2 ~= 0 then
                type_fail("E0312", line, column,
                    "alignment " .. tostring(align) .. " for struct `"
                    .. stmt.name .. "` must be a power of two")
            end
            probe = probe / 2
        end
    end
    local layout = {}
    local order = {}
    local i = 1
    while i <= #stmt.fields do
        local field = clone stmt.fields[i]
        local field_type = canonical_type(field.type, field.line, field.column)
        local valid = field_type == "u32" or field_type == "i32"
            or field_type == "i128" or field_type == "f32"
            or field_type == "bool" or field_type == "string"
            or is_table_type(field_type) or is_array_type(field_type)
        if not valid and not is_pointer_type(field_type)
            and not is_struct_type(field_type) then
            type_fail("E0312", field.line, field.column,
                "unsupported struct field type `" .. tostring(field_type)
                .. "`; use a scalar, string, table, raw pointer, or a previously declared struct")
        end
        if layout[field.name] ~= nil then
            type_fail("E0302", field.line, field.column,
                "duplicate struct field `" .. field.name .. "`")
        end
        layout[field.name] = { type = field_type }
        order[#order + 1] = field.name
        field.type = field_type
        stmt.fields[i] = field
        i = i + 1
    end
    check_structs[stmt.name] = {
        fields = layout,
        order = order,
        packed = packed,
        align = align
    }
    check_struct_order[#check_struct_order + 1] = stmt.name
    stmt.struct_checked = true
    return stmt
end

-- Register top-level structs before function signatures are resolved: a
-- signature may name a struct while `scan_functions` runs ahead of the normal
-- top-level check.
local function scan_structs(body)
    local i = 1
    while i <= #body do
        local stmt = body[i]
        if stmt.tag == "Struct" then
            body[i] = check_struct_decl(stmt)
        else
            -- Reading a table slot moves heap values out; put non-struct
            -- statements back so the program body keeps every statement.
            body[i] = stmt
        end
        i = i + 1
    end
    return body
end

local function scan_functions(body)
    local i = 1
    while i <= #body do
        local stmt = body[i]
        if stmt.tag == "Function" then
            local fname = stmt.name
            local fline = stmt.line
            local fcolumn = stmt.column
            local receiver = stmt.receiver
            local key = fname
            if receiver ~= nil then
                key = receiver .. ":" .. fname
            end
            if fname == "print" then
                type_fail("E0302", fline, fcolumn,
                    "`print` is a builtin function and cannot be redefined")
            end
            if check_functions[key] ~= nil then
                type_fail("E0302", fline, fcolumn,
                    "duplicate definition of function `" .. key .. "`")
            end
            local params = {}
            if receiver ~= nil then
                params[#params + 1] = {
                    name = "self", type = "table",
                    line = fline, column = fcolumn
                }
            end
            local j = 1
            while j <= #stmt.params do
                local param = borrow stmt.params[j]
                local param_type = canonical_type(param.type, param.line, param.column)
                if param_type == "auto" then
                    type_fail("E0301", param.line, param.column,
                        "function parameter `" .. param.name .. "` requires an explicit type")
                end
                if param_type == "void" then
                    type_fail("E0301", param.line, param.column,
                        "function parameter `" .. param.name .. "` cannot have type `void`")
                end
                if param_type == "nil" then
                    type_fail("E0301", param.line, param.column,
                        "function parameter `" .. param.name .. "` cannot have type `nil`")
                end
                if is_array_type(param_type) then
                    type_fail("E0312", param.line, param.column,
                        "fixed arrays cannot be passed by value; use a raw pointer or index the array in the callee")
                end
                params[#params + 1] = {
                    name = param.name,
                    type = param_type,
                    line = param.line,
                    column = param.column
                }
                j = j + 1
            end
            local ret = canonical_type(stmt.return_type or "void",
                fline, fcolumn)
            if ret == "auto" then
                type_fail("E0301", fline, fcolumn,
                    "function `" .. fname .. "` requires an explicit return type")
            end
            if ret == "nil" then
                type_fail("E0301", fline, fcolumn,
                    "function return type cannot be `nil`")
            end
            if is_array_type(ret) then
                type_fail("E0312", fline, fcolumn,
                    "fixed arrays cannot be returned by value; use a raw pointer")
            end
            local signature = {
                name = fname,
                receiver = receiver,
                key = key,
                params = params,
                ret = ret,
                node = stmt
            }
            check_functions[key] = signature
            check_function_order[#check_function_order + 1] = key
        end
        i = i + 1
    end
end

check_stmt = function(stmt, top_level)
    local tag = stmt.tag
    local line = stmt.line
    local column = stmt.column

    if tag == "Struct" then
        if not top_level then
            type_fail("E0312", line, column,
                "`struct` declarations are only allowed at the top level")
        end
        if stmt.struct_checked == true then
            return stmt
        end
        return check_struct_decl(stmt)
    end

    if tag == "Local" then
        return check_local(stmt)
    end

    if tag == "Assign" then
        return check_assign(stmt)
    end

    if tag == "Function" then
        if top_level then
            return stmt
        end
        type_fail("E0312", line, column,
            "nested function definitions are not supported by the C backend")
    end

    if tag == "CallStmt" then
        local checked_value, _ = check_expr(stmt.value)
        stmt.value = checked_value
        return stmt
    end

    if tag == "If" then
        local i = 1
        while i <= #stmt.branches do
            local branch = stmt.branches[i]
            local checked_cond, _ = check_condition(branch.cond, "if condition")
            branch.cond = checked_cond
            -- Each arm owns its bindings: a `local` declared in one branch
            -- must not leak into the checker's view of the next branch.
            scope_enter()
            branch.body = check_block(branch.body, false)
            scope_leave()
            stmt.branches[i] = branch
            i = i + 1
        end
        if stmt.else_body ~= nil then
            scope_enter()
            stmt.else_body = check_block(stmt.else_body, false)
            scope_leave()
        end
        return stmt
    end

    if tag == "While" then
        local checked_cond, _ = check_condition(stmt.cond, "while condition")
        stmt.cond = checked_cond
        check_loop_depth = check_loop_depth + 1
        stmt.body = check_block(stmt.body, false)
        check_loop_depth = check_loop_depth - 1
        return stmt
    end

    if tag == "Repeat" then
        check_loop_depth = check_loop_depth + 1
        scope_enter()
        stmt.body = check_block(stmt.body, false)
        local checked_cond, _ = check_condition(stmt.cond, "repeat condition")
        stmt.cond = checked_cond
        scope_leave()
        check_loop_depth = check_loop_depth - 1
        return stmt
    end

    if tag == "ForIn" then
        local iter = stmt.iter
        if string_api_name(clone iter) == "gmatch" then
            local checked_source = nil
            local source_type = nil
            local pattern_args = {}
            if iter.tag == "Call" then
                if #iter.args ~= 2 then
                    type_fail("E0311", line, column,
                        "`string.gmatch` takes a string and a pattern")
                end
                checked_source, source_type = check_expr(clone iter.args[1])
                pattern_args = { clone iter.args[2] }
            else
                if #iter.args ~= 1 then
                    type_fail("E0311", line, column,
                        "`string.gmatch` takes one pattern argument")
                end
                checked_source, source_type = check_expr(clone iter.obj)
                iter.obj = clone checked_source
                pattern_args = { clone iter.args[1] }
            end
            iter = check_string_operation(iter, checked_source, source_type,
                pattern_args, "gmatch", "gmatch")
            if #stmt.vars < 1 or #stmt.vars > 9 then
                type_fail("E0311", line, column,
                    "native gmatch loops support one to nine loop variables")
            end
            local captures = iter.string_capture_count
            local results = captures == nil and 1
                or (captures == 0 and 1 or captures)
            if #stmt.vars > results then
                if captures == nil then
                    type_fail("E0323", line, column,
                        "native gmatch needs a literal pattern when binding multiple values")
                end
                type_fail("E0324", line, column,
                    "gmatch pattern produces " .. tostring(results)
                    .. " value(s) but the loop binds " .. tostring(#stmt.vars))
            end
            stmt.iter = iter
            stmt.iter_kind = "gmatch"
            stmt.gmatch_count = #stmt.vars
            stmt.gmatch_captures = captures or 0
            scope_enter()
            local i = 1
            while i <= #stmt.vars do
                scope_declare(stmt.vars[i], "string", true, false)
                i = i + 1
            end
            check_loop_depth = check_loop_depth + 1
            stmt.body = check_block(stmt.body, false)
            check_loop_depth = check_loop_depth - 1
            scope_leave()
            return stmt
        end
        if iter.tag ~= "Call" or iter.callee.tag ~= "Name" then
            type_fail("E0319", line, column,
                "generic `for` requires a direct `pairs(table)` or `ipairs(table)` call")
        end
        local iter_name = iter.callee.name
        if iter_name ~= "pairs" and iter_name ~= "ipairs" then
            type_fail("E0319", line, column,
                "unsupported iterator `" .. tostring(iter_name)
                .. "`; use `pairs` or `ipairs`")
        end
        if #iter.args ~= 1 then
            type_fail("E0311", line, column,
                "`" .. iter_name .. "` takes one table argument")
        end
        if #stmt.vars < 1 or #stmt.vars > 2 then
            type_fail("E0311", line, column,
                "generic `for` supports one or two loop variables")
        end
        local checked_table, table_type = check_expr(iter.args[1])
        local mixed_element = checked_table.elem_type
        iter.args[1] = checked_table
        if not is_table_type(table_type) then
            check_mismatch(line, column, "generic `for` iterator",
                "table", table_type)
        end
        local key_type = "string"
        local value_type = "value"
        local iter_kind = iter_name
        local array_element = table_element(table_type)
        if array_element == "nil" then
            -- `{}` has no element type yet; keep the tagged value view.
            array_element = nil
        end
        if mixed_element == "nil" then
            mixed_element = nil
        end
        if iter_name == "ipairs" then
            key_type = "i32"
            value_type = array_element or mixed_element or "value"
        elseif array_element ~= nil then
            -- Dense arrays behave like ipairs for `pairs` in the native
            -- subset; keyed records continue to use the hash-map iterator.
            key_type = "i32"
            value_type = array_element
            iter_kind = "ipairs"
        end
        stmt.iter = iter
        stmt.iter_kind = iter_kind
        stmt.key_type = key_type
        stmt.value_type = value_type
        scope_enter()
        scope_declare(stmt.vars[1], key_type, false, false)
        if #stmt.vars >= 2 then
            scope_declare(stmt.vars[2], value_type, false, false)
        end
        check_loop_depth = check_loop_depth + 1
        stmt.body = check_block(stmt.body, false)
        check_loop_depth = check_loop_depth - 1
        scope_leave()
        return stmt
    end

    if tag == "Do" then
        scope_enter()
        stmt.body = check_block(stmt.body, false)
        scope_leave()
        return stmt
    end

    if tag == "Unsafe" then
        check_unsafe_depth = check_unsafe_depth + 1
        scope_enter()
        stmt.body = check_block(stmt.body, false)
        scope_leave()
        check_unsafe_depth = check_unsafe_depth - 1
        return stmt
    end

    if tag == "Return" then
        local count = #stmt.values
        if count > 1 then
            type_fail("E0313", line, column,
                "the C backend supports zero or one return value")
        end
        if check_return_type == "void" then
            if count ~= 0 then
                type_fail("E0313", line, column,
                    "void function cannot return a value")
            end
            stmt.ret_type = "void"
            return stmt
        end
        if count == 0 then
            type_fail("E0313", line, column,
                "function must return a value of type `" .. check_return_type .. "`")
        end
        local checked_value, actual = check_expr(stmt.values[1])
        if not assignable(check_return_type, actual, clone checked_value) then
            check_mismatch(checked_value.line, checked_value.column,
                "return value", check_return_type, actual)
        end
        checked_value = coerce_literal(checked_value, check_return_type)
        if checked_value.tag ~= "Clone" and checked_value.tag ~= "Borrow"
            and checked_value.tag ~= "Move" then
            consume_expr(clone checked_value, checked_value.line, checked_value.column)
        end
        stmt.values[1] = checked_value
        stmt.ret_type = check_return_type
        return stmt
    end

    if tag == "Break" then
        if check_loop_depth == 0 then
            type_fail("E0315", line, column,
                "`break` outside a loop")
        end
        return stmt
    end

    type_fail("E0312", line, column,
        "unsupported statement node `" .. tostring(tag) .. "`")
end

check_block = function(body, top_level)
    local i = 1
    while i <= #body do
        body[i] = check_stmt(body[i], top_level)
        i = i + 1
    end
    return body
end

local function check_program(ast)
    check_scopes = {}
    check_scope_count = 0
    check_states = {}
    check_next_state = 0
    check_globals = {}
    check_global_order = {}
    check_functions = {}
    check_function_order = {}
    check_structs = {}
    check_struct_order = {}
    check_loop_depth = 0
    check_unsafe_depth = 0
    check_return_type = "i32"
    check_in_function = false
    check_current_function = nil

    ast.body = scan_structs(ast.body)
    scan_functions(clone ast.body)

    -- Check the top-level body first so its implicit globals are available to
    -- function bodies (the generated C declarations cover all of them).
    scope_enter()
    check_return_type = "i32"
    ast.body = check_block(ast.body, true)

    -- Named functions cannot capture top-level locals (the C backend has no
    -- closures), but a method declaration still needs the receiver's schema.
    -- Keep a snapshot of the top-level bindings and expose only the receiver
    -- while checking each method body.
    local top_level_vars = clone check_scopes[check_scope_count].vars
    scope_leave()

    local i = 1
    while i <= #check_function_order do
        local name = check_function_order[i]
        local signature = borrow check_functions[name]
        local receiver_entry = nil
        if signature.receiver ~= nil then
            receiver_entry = clone top_level_vars[signature.receiver]
            if receiver_entry ~= nil then
                scope_enter()
                scope_declare(signature.receiver, receiver_entry.type,
                    false, false, receiver_entry.schema, false,
                    receiver_entry.elem_type)
            end
        end
        check_function(signature)
        if receiver_entry ~= nil then
            scope_leave()
        end
        i = i + 1
    end

    ast.function_names = check_function_order
    ast.signatures = check_functions
    ast.struct_names = clone check_struct_order
    -- The emitter resolves struct names through `check_structs` as well, so
    -- hand it a copy instead of moving the registry out.
    ast.structs = clone check_structs
    ast.globals = check_global_order
    return ast
end

function Compiler.check(borrow_ast)
    if type(borrow_ast) ~= "table" or borrow_ast.tag ~= "Program" then
        fail(0, 0, "check expects a Program AST")
    end
    local snapshot = {
        tag = "Program",
        body = clone borrow_ast.body,
        line = borrow_ast.line,
        column = borrow_ast.column
    }
    local optimized = optimize_impl(snapshot)
    optimized = check_program(optimized)
    return {
        ok = true,
        functions = #optimized.function_names,
        globals = #optimized.globals
    }
end

-- =========================================================================
-- C emitter
-- =========================================================================

local emit_out = {}
local emit_indent = 0
local emit_temp = 0
local emit_scopes = {}
local emit_scope_count = 0
local emit_globals = {}
local emit_global_order = {}
local emit_functions = {}
local emit_function_cnames = {}
local emit_strings = {}
local emit_string_ids = {}
local emit_ints = {}
local emit_int_ids = {}
local emit_loop_stack = {}
local emit_is_main = false
local emit_return_type = "i32"

local function reset_emitter()
    emit_out = {}
    emit_indent = 0
    emit_temp = 0
    emit_scopes = {}
    emit_scope_count = 0
    emit_globals = {}
    emit_global_order = {}
    emit_functions = {}
    emit_function_cnames = {}
    emit_strings = {}
    emit_string_ids = {}
    emit_ints = {}
    emit_int_ids = {}
    emit_loop_stack = {}
    emit_is_main = false
    emit_return_type = "i32"
end

local function put(text)
    emit_out[#emit_out + 1] = text
end

local function line(text)
    local pad = ""
    local i = 0
    while i < emit_indent do
        pad = pad .. "    "
        i = i + 1
    end
    emit_out[#emit_out + 1] = pad .. text
end

local function fresh(prefix)
    emit_temp = emit_temp + 1
    return prefix .. tostring(emit_temp)
end

local function c_type(type_name)
    local array_element = array_info(type_name)
    if array_element ~= nil then
        return c_type(array_element)
    end
    if type_name == "i32" then return "int32_t" end
    if type_name == "u32" then return "uint32_t" end
    if type_name == "i128" then return "lusa_i128" end
    if type_name == "f32" then return "float" end
    if type_name == "bool" then return "bool" end
    if type_name == "string" then return "LusaString *" end
    if type_name == "coroutine" then return "LusaCoro *" end
    if type_name == "gmatch" then return "LusaGmatch *" end
    if type_name == "nil" then return "void *" end
    if type_name == "void" then return "void" end
    if type_name == "table" or table_element(type_name) ~= nil then
        return "LusaTable *"
    end
    if type_name == "value" then return "LusaValue" end
    if pointer_element(type_name) ~= nil then
        local element = pointer_element(type_name)
        local base = c_type(element)
        if string.sub(type_name, 1, 5) == "*mut " then
            return "volatile " .. base .. " *"
        end
        return "const volatile " .. base .. " *"
    end
    if is_struct_type(type_name) then
        return type_name
    end
    fail(0, 0, "internal: no C type for `" .. tostring(type_name) .. "`")
end

-- Declarator form: fixed arrays need the bound next to the variable name.
local function c_decl(type_name, name)
    local array_element, array_length = array_info(type_name)
    if array_element ~= nil then
        return c_type(array_element) .. " " .. name
            .. "[" .. tostring(array_length) .. "]"
    end
    return c_type(type_name) .. " " .. name
end

local function default_c(type_name)
    if is_array_type(type_name) then
        return "{0}"
    end
    if type_name == "f32" then return "0.0f" end
    if type_name == "bool" then return "false" end
    if type_name == "i32" or type_name == "u32" or type_name == "i128" then
        return "0"
    end
    if type_name == "string" or type_name == "nil"
        or type_name == "table" or type_name == "coroutine"
        or type_name == "gmatch" or table_element(type_name) ~= nil then
        return "NULL"
    end
    if type_name == "value" then
        return "(LusaValue){LUSA_ELEM_UNKNOWN, 0u}"
    end
    if pointer_element(type_name) ~= nil then
        return "NULL"
    end
    if is_struct_type(type_name) then
        return "(" .. type_name .. "){0}"
    end
    return ""
end

local function elem_kind(type_name)
    if type_name == "i32" then return "LUSA_ELEM_I32" end
    if type_name == "u32" then return "LUSA_ELEM_U32" end
    if type_name == "i128" then return "LUSA_ELEM_I128" end
    if type_name == "f32" then return "LUSA_ELEM_F32" end
    if type_name == "bool" then return "LUSA_ELEM_BOOL" end
    if type_name == "string" then return "LUSA_ELEM_STRING" end
    if type_name == "table" or table_element(type_name) ~= nil then
        return "LUSA_ELEM_TABLE"
    end
    if type_name == "value" then return "LUSA_ELEM_UNKNOWN" end
    return "LUSA_ELEM_UNKNOWN"
end

local function emit_scope_enter()
    emit_scope_count = emit_scope_count + 1
    emit_scopes[emit_scope_count] = {vars = {}, order = {}}
end

local function emit_scope_find(name)
    local i = emit_scope_count
    while i >= 1 do
        local scope = emit_scopes[i]
        local entry = scope.vars[name]
        if entry ~= nil then
            local copy = clone entry
            scope.vars[name] = entry
            emit_scopes[i] = scope
            return copy
        end
        emit_scopes[i] = scope
        i = i - 1
    end
    return nil
end

local function emit_value_lookup(name)
    local entry = emit_scope_find(name)
    if entry ~= nil then
        return entry
    end
    local global = emit_globals[name]
    if global ~= nil then
        local copy = clone global
        emit_globals[name] = global
        return copy
    end
    return nil
end

-- Persist a move into the live scope/global metadata.  `emit_value_lookup`
-- returns a copy (so move semantics do not mutate the entry it hands out), but
-- drop lists are traversed later; struct moves have no `NULL` sentinel, so the
-- moved flag itself must survive until scope exit.
local function emit_mark_moved(name)
    local i = emit_scope_count
    while i >= 1 do
        local scope = emit_scopes[i]
        local entry = scope.vars[name]
        if entry ~= nil then
            local cname = clone entry.cname
            entry.moved = true
            scope.vars[name] = entry
            local order = scope.order
            local j = 1
            while j <= #order do
                local item = order[j]
                local item_cname = clone item.cname
                if item_cname == cname then
                    item.moved = true
                end
                order[j] = item
                j = j + 1
            end
            scope.order = order
            emit_scopes[i] = scope
            return true
        end
        -- The lookup moved the scope table out of its slot; put it back
        -- even when the name is not declared in this scope.
        emit_scopes[i] = scope
        i = i - 1
    end
    local global = emit_globals[name]
    if global ~= nil then
        local cname = clone global.cname
        global.moved = true
        emit_globals[name] = global
        local order = emit_global_order
        local j = 1
        while j <= #order do
            local item = order[j]
            local item_cname = clone item.cname
            if item_cname == cname then
                item.moved = true
            end
            order[j] = item
            j = j + 1
        end
        emit_global_order = order
        return true
    end
    return false
end

local function emit_scope_declare(name, type_name, own, borrowed)
    local entry = {
        name = name,
        cname = fresh("v"),
        type = type_name,
        own = own == true,
        borrowed = borrowed == true,
        moved = false
    }
    local scope = emit_scopes[emit_scope_count]
    scope.vars[name] = clone entry
    local order = scope.order
    order[#order + 1] = clone entry
    scope.order = order
    emit_scopes[emit_scope_count] = scope
    return entry
end

local function emit_scope_pop_without_drops()
    emit_scopes[emit_scope_count] = nil
    emit_scope_count = emit_scope_count - 1
end

local function emit_clone_place(type_name, access)
    if type_name == "string" then
        line(access .. " = lusa_string_clone(" .. access .. ");")
    elseif is_table_type(type_name) then
        line(access .. " = lusa_table_clone(" .. access .. ");")
    elseif is_struct_type(type_name) and is_heap_type(type_name) then
        line(access .. " = lusa_clone_" .. type_name .. "(" .. access .. ");")
    end
end

local function emit_drop_place(type_name, access)
    if type_name == "string" then
        line("lusa_drop_string(&" .. access .. ");")
    elseif type_name == "table" or table_element(type_name) ~= nil then
        line("lusa_drop_table(&" .. access .. ");")
    elseif type_name == "coroutine" then
        line("lusa_drop_coroutine(&" .. access .. ");")
    elseif type_name == "gmatch" then
        line("lusa_drop_gmatch(&" .. access .. ");")
    elseif is_struct_type(type_name) then
        line("lusa_drop_" .. type_name .. "(&" .. access .. ");")
    end
end

local function emit_drop_entry(entry)
    if entry == nil or not entry.own or entry.moved then
        return
    end
    local array_element, array_length = array_info(entry.type)
    if array_element ~= nil then
        if is_heap_type(array_element) then
            line("for (int32_t lusa_i = 0; lusa_i < "
                .. tostring(array_length) .. "; lusa_i++) {")
            emit_indent = emit_indent + 1
            emit_drop_place(array_element, entry.cname .. "[lusa_i]")
            emit_indent = emit_indent - 1
            line("}")
        end
        return
    end
    emit_drop_place(entry.type, entry.cname)
end

local function emit_scope_drops(scope_index)
    local scope = emit_scopes[scope_index]
    if scope == nil then
        return
    end
    local order = scope.order
    local i = #order
    while i >= 1 do
        -- Drop metadata is read-only.  Pass a copy so traversing the scope
        -- does not move the entry out of `order` (Lusa moves table values
        -- into function arguments), which would otherwise make later
        -- traversals -- notably the real lexical exit -- see an empty list.
        emit_drop_entry(clone order[i])
        i = i - 1
    end
    scope.order = order
    emit_scopes[scope_index] = scope
end

local function emit_leave_scope()
    emit_scope_drops(emit_scope_count)
    emit_scope_pop_without_drops()
end

local function emit_all_drops()
    local i = emit_scope_count
    while i >= 1 do
        emit_scope_drops(i)
        i = i - 1
    end
end

local function emit_global_drops()
    local order = emit_global_order
    local i = #order
    while i >= 1 do
        -- Same rule as `emit_scope_drops`: dropping must not consume the
        -- entry, because several error paths may emit the cleanup list.
        emit_drop_entry(clone order[i])
        i = i - 1
    end
    emit_global_order = order
end

-- Propagate a recorded runtime error through the normal function return path
-- so every owned local is released exactly once.  `pcall` clears the flag
-- before its protected call and inspects it afterwards.
local function emit_error_check()
    line("if (lusa_error_pending) {")
    emit_indent = emit_indent + 1
    emit_all_drops()
    if emit_is_main then
        emit_global_drops()
        line("return lusa_error_report();")
    elseif emit_return_type == "void" then
        line("return;")
    else
        line("return " .. default_c(emit_return_type) .. ";")
    end
    emit_indent = emit_indent - 1
    line("}")
end

-- When `coroutine.close` resumes a suspended fiber, the next statement
-- boundary unwinds its ordinary stack frame.  Every generated function has
-- the hidden `lusa_co` parameter, so helpers clean up just like the entry.
local function emit_coro_closing_check()
    if emit_is_main then
        return
    end
    line("if (lusa_coro_closing(lusa_co)) {")
    emit_indent = emit_indent + 1
    emit_all_drops()
    if emit_return_type == "void" then
        line("return;")
    else
        line("return " .. default_c(emit_return_type) .. ";")
    end
    emit_indent = emit_indent - 1
    line("}")
end

local function save_moved_state()
    local snapshot = {}
    local s = 1
    while s <= emit_scope_count do
        local order = emit_scopes[s].order
        local i = 1
        while i <= #order do
            snapshot[#snapshot + 1] = {entry = order[i], moved = order[i].moved}
            i = i + 1
        end
        s = s + 1
    end
    return snapshot
end

local function restore_moved_state(snapshot)
    local i = 1
    while i <= #snapshot do
        snapshot[i].entry.moved = snapshot[i].moved
        i = i + 1
    end
end

local function unwrap_paren(expr)
    local current = expr
    while current ~= nil
        and (current.tag == "Paren" or current.tag == "Move") do
        current = current.value
    end
    return current
end

local function direct_heap_name(expr)
    local value = unwrap_paren(expr)
    if value == nil or value.tag ~= "Name" then
        return nil
    end
    local entry = emit_value_lookup(value.name)
    if entry ~= nil and is_heap_type(entry.type) then
        return entry
    end
    return nil
end

local function collect_move_entries(expr, out, seen)
    if expr == nil then
        return out, seen
    end
    local value = unwrap_paren(expr)
    if value == nil then
        return out, seen
    end
    if value.tag == "Name" then
        local entry = direct_heap_name(value)
        if entry ~= nil and seen[entry.cname] ~= true then
            seen[entry.cname] = true
            out[#out + 1] = entry
        end
        return out, seen
    end
    if value.tag == "Table" then
        local i = 1
        while i <= #value.items do
            out, seen = collect_move_entries(value.items[i], out, seen)
            i = i + 1
        end
    end
    return out, seen
end

local function null_moved_source(expr, skip)
    local entry = direct_heap_name(expr)
    if entry == nil then
        return
    end
    if skip ~= nil and skip[entry.cname] == true then
        return
    end
    emit_mark_moved(entry.name)
    if is_struct_type(entry.type) then
        -- A moved struct is a value, not a pointer.  There is no NULL to
        -- store; the persisted moved flag alone prevents the scope drop from
        -- touching the aliased fields.
        entry.moved = true
        return
    end
    line(entry.cname .. " = NULL;")
    entry.moved = true
end

-- ---- C runtime -----------------------------------------------------------

local RUNTIME = {
    "#if !defined(_WIN32)",
    "#define _XOPEN_SOURCE 700",
    "#endif",
    "#include <stdio.h>",
    "#include <stdlib.h>",
    "#include <stdint.h>",
    "#include <stdbool.h>",
    "#include <stddef.h>",
    "#include <string.h>",
    "#include <inttypes.h>",
    "#include <math.h>",
    "",
    "/* Inline assembly hooks for `asm!`/`unsafe_asm` and `unsafe_nop`.",
    "   GCC and Clang receive the raw text as a volatile asm statement;",
    "   MSVC and other toolchains keep the program buildable with a no-op. */",
    "#if defined(_MSC_VER)",
    "#include <intrin.h>",
    "#define LUSA_NOP() __nop()",
    "#define LUSA_ASM(text) ((void)0)",
    "#elif defined(__GNUC__) || defined(__clang__)",
    -- Statement expressions keep the hooks usable in expression position.
    '#define LUSA_NOP() ({ __asm__ __volatile__("nop"); })',
    "#define LUSA_ASM(text) ({ __asm__ __volatile__ (text : : ); })",
    "#else",
    "#define LUSA_NOP() ((void)0)",
    "#define LUSA_ASM(text) ((void)0)",
    "#endif",
    "",
    "/* Struct representation attributes.  GCC/Clang use type attributes,",
    "   MSVC uses __declspec plus #pragma pack, and other C11 compilers fall",
    "   back to _Alignas for the alignment half. */",
    "#if defined(_MSC_VER)",
    "#define LUSA_PACK_BEGIN __pragma(pack(push, 1))",
    "#define LUSA_PACK_END __pragma(pack(pop))",
    "#define LUSA_PACKED",
    "#define LUSA_ALIGNAS(n) __declspec(align(n))",
    "#elif defined(__GNUC__) || defined(__clang__)",
    "#define LUSA_PACK_BEGIN",
    "#define LUSA_PACK_END",
    "#define LUSA_PACKED __attribute__((packed))",
    "#define LUSA_ALIGNAS(n) __attribute__((aligned(n)))",
    "#else",
    "#define LUSA_PACK_BEGIN",
    "#define LUSA_PACK_END",
    "#define LUSA_PACKED",
    "#define LUSA_ALIGNAS(n) _Alignas(n)",
    "#endif",
    "",
    "static void lusa_panic(const char *message);",
    "",
    "/* Native panic recovery uses checked propagation instead of longjmp:",
    "   runtime helpers record the first error, generated functions return",
    "   through their normal RAII cleanup paths, and `pcall` inspects the",
    "   flag at its protected call site.  This keeps every drop deterministic",
    "   on all supported C toolchains. */",
    "static bool lusa_error_pending = false;",
    "static char lusa_error_code[32] = {0};",
    "static char lusa_error_message[512] = {0};",
    "static void lusa_error_clear(void) {",
    "    lusa_error_pending = false;",
    "    lusa_error_code[0] = 0;",
    "    lusa_error_message[0] = 0;",
    "}",
    "static void lusa_throw(const char *code, const char *message) {",
    "    if (lusa_error_pending) return;",
    "    lusa_error_pending = true;",
    '    snprintf(lusa_error_code, sizeof(lusa_error_code), "%s",',
    '        code == NULL ? "E9999" : code);',
    '    snprintf(lusa_error_message, sizeof(lusa_error_message), "%s",',
    '        message == NULL ? "" : message);',
    "}",
    "static int lusa_error_report(void) {",
    "    fflush(stdout);",
    '    fprintf(stderr, "lusa runtime: %s: %s", lusa_error_code,',
    "        lusa_error_message);",
    "    fputc(10, stderr);",
    "    return 1;",
    "}",
    "",
    "/* Tracked buffers behind `unsafe_alloc`; released before the program",
    "   exits so tests and drivers can use them freely. */",
    "static void **lusa_alloc_list = NULL;",
    "static uint64_t lusa_alloc_count = 0u;",
    "static void *lusa_unsafe_alloc(uint64_t bytes) {",
    "    void *memory;",
    "    void **grown;",
    "    if (bytes == 0u) bytes = 1u;",
    "    memory = calloc(1, (size_t)bytes);",
    '    if (memory == NULL) lusa_panic("out of memory");',
    "    grown = (void **)realloc(lusa_alloc_list,",
    "        (size_t)(lusa_alloc_count + 1u) * sizeof(void *));",
    '    if (grown == NULL) lusa_panic("out of memory");',
    "    lusa_alloc_list = grown;",
    "    lusa_alloc_list[lusa_alloc_count] = memory;",
    "    lusa_alloc_count = lusa_alloc_count + 1u;",
    "    return memory;",
    "}",
    "static void lusa_free_allocs(void) {",
    "    uint64_t i;",
    "    if (lusa_alloc_list == NULL) return;",
    "    for (i = 0u; i < lusa_alloc_count; i++) {",
    "        free(lusa_alloc_list[i]);",
    "    }",
    "    free(lusa_alloc_list);",
    "    lusa_alloc_list = NULL;",
    "    lusa_alloc_count = 0u;",
    "}",
    "",
    "#define LUSA_OBJ_STRING 1u",
    "#define LUSA_OBJ_TABLE  2u",
    "#define LUSA_OWNED      1u",
    "",
    "#define LUSA_ELEM_UNKNOWN 0u",
    "#define LUSA_ELEM_I32     1u",
    "#define LUSA_ELEM_U32     2u",
    "#define LUSA_ELEM_I128    3u",
    "#define LUSA_ELEM_F32     4u",
    "#define LUSA_ELEM_BOOL    5u",
    "#define LUSA_ELEM_STRING  6u",
    "#define LUSA_ELEM_TABLE   7u",
    "",
    "typedef struct LusaObj {",
    "    uint64_t type;",
    "    uint64_t length;",
    "    uint64_t flags;",
    "    uint64_t size;",
    "} LusaObj;",
    "",
    "typedef struct LusaString {",
    "    LusaObj obj;",
    "    char *data;",
    "} LusaString;",
    "",
    "typedef struct LusaValue {",
    "    uint64_t kind;",
    "    uint64_t payload;",
    "} LusaValue;",
    "",
    "typedef struct LusaEntry {",
    "    LusaString *key;",
    "    uint64_t value;",
    "    uint64_t kind;",
    "} LusaEntry;",
    "",
    "typedef struct LusaTable {",
    "    LusaObj obj;",
    "    uint64_t elem_kind;",
    "    uint64_t capacity;",
    "    uint64_t *items;",
    "    uint64_t key_count;",
    "    uint64_t map_capacity;",
    "    LusaEntry *entries;",
    "} LusaTable;",
    "",
    "#if defined(__SIZEOF_INT128__) && !defined(_MSC_VER)",
    "typedef __int128 lusa_i128;",
    "#define LUSA_HAS_INT128 1",
    "#else",
    "typedef long long lusa_i128;",
    "#define LUSA_HAS_INT128 0",
    "#endif",
    "",
    "/* Exact decimal/hex i128 literal parser.  The lexer keeps the original",
    "   digits, avoiding an f64 round-trip above 2^53. */",
    "static lusa_i128 lusa_i128_parse(const char *text) {",
    "    const char *p = text;",
    "    lusa_i128 value = 0;",
    "    int base = 10;",
    "    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) { base = 16; p += 2; }",
    "    while (*p != 0) {",
    "        int digit;",
    "        if (*p >= '0' && *p <= '9') digit = (int)(*p - '0');",
    "        else if (*p >= 'a' && *p <= 'f') digit = (int)(*p - 'a') + 10;",
    "        else if (*p >= 'A' && *p <= 'F') digit = (int)(*p - 'A') + 10;",
    "        else break;",
    "        value = value * (lusa_i128)base + (lusa_i128)digit;",
    "        p++;",
    "    }",
    "    return value;",
    "}",
    "",
    "static void lusa_panic(const char *message) {",
    '    lusa_throw("E9999", message);',
    "}",
    "",
    "static LusaString *lusa_string_new(const char *bytes, uint64_t length);",
    "static LusaString *lusa_error_string(void) {",
    "    char buffer[600];",
    '    snprintf(buffer, sizeof(buffer), "%s: %s", lusa_error_code,',
    "        lusa_error_message);",
    "    return lusa_string_new(buffer, (uint64_t)strlen(buffer));",
    "}",
    "",
    "static void lusa_drop_string(LusaString **value);",
    "static void lusa_drop_table(LusaTable **value);",
    "static void lusa_drop_value(uint64_t kind, uint64_t *payload);",
    "static void lusa_panic(const char *message);",
    "",
    "/* Module 13 pattern runtime.  Definitions are appended by the",
    "   `lusa::cbackend` facade after the generated translation unit. */",
    "typedef struct LusaGmatch LusaGmatch;",
    "static int32_t lusa_string_find_start(LusaString *source, LusaString *pattern, int32_t init, bool plain);",
    "static bool lusa_string_find_values(LusaString *source, LusaString *pattern, int32_t init, bool plain, int32_t *out_start, int32_t *out_end);",
    "static LusaString *lusa_string_match(LusaString *source, LusaString *pattern, int32_t init);",
    "static LusaString *lusa_string_gsub(LusaString *source, LusaString *pattern, LusaString *replacement, int32_t limit, int32_t *out_count);",
    "static LusaGmatch *lusa_string_gmatch_new(LusaString *source, LusaString *pattern);",
    "static bool lusa_string_gmatch_next(LusaGmatch *iterator, LusaString **out, int32_t count);",
    "static void lusa_drop_gmatch(LusaGmatch **value);",
    "",
    "static LusaString *lusa_string_new(const char *bytes, uint64_t length) {",
    "    LusaString *value = (LusaString *)calloc(1, sizeof(LusaString));",
    '    if (value == NULL) { lusa_panic("out of memory"); return NULL; }',
    "    value->obj.type = LUSA_OBJ_STRING;",
    "    value->obj.length = length;",
    "    value->obj.flags = LUSA_OWNED;",
    "    value->obj.size = (uint64_t)sizeof(LusaString) + length + 1u;",
    "    value->data = (char *)malloc((size_t)length + 1u);",
    "    if (value->data == NULL) {",
    "        free(value);",
    '        lusa_panic("out of memory");',
    "        return NULL;",
    "    }",
    "    if (length != 0u) memcpy(value->data, bytes, (size_t)length);",
    "    value->data[length] = 0;",
    "    return value;",
    "}",
    "",
    "static LusaString *lusa_string_clone(LusaString *value) {",
    "    if (value == NULL) return NULL;",
    "    return lusa_string_new(value->data, value->obj.length);",
    "}",
    "",
    "static LusaString *lusa_string_concat(LusaString *left, LusaString *right) {",
    "    uint64_t left_length = left == NULL ? 0u : left->obj.length;",
    "    uint64_t right_length = right == NULL ? 0u : right->obj.length;",
    "    uint64_t length = left_length + right_length;",
    '    LusaString *out = lusa_string_new("", 0u);',
    "    char *grown;",
    "    if (out == NULL) return NULL;",
    "    if (length == 0u) return out;",
    "    grown = (char *)realloc(out->data, (size_t)length + 1u);",
    '    if (grown == NULL) { lusa_panic("out of memory"); return out; }',
    "    out->data = grown;",
    "    if (left_length != 0u) memcpy(out->data, left->data, (size_t)left_length);",
    "    if (right_length != 0u) memcpy(out->data + left_length, right->data, (size_t)right_length);",
    "    out->data[length] = 0;",
    "    out->obj.length = length;",
    "    return out;",
    "}",
    "",
    "static int lusa_string_cmp(LusaString *left, LusaString *right) {",
    "    uint64_t shortest;",
    "    int result;",
    "    if (left == right) return 0;",
    "    if (left == NULL) return -1;",
    "    if (right == NULL) return 1;",
    "    shortest = left->obj.length < right->obj.length ? left->obj.length : right->obj.length;",
    "    result = shortest == 0u ? 0 : memcmp(left->data, right->data, (size_t)shortest);",
    "    if (result != 0) return result;",
    "    if (left->obj.length < right->obj.length) return -1;",
    "    if (left->obj.length > right->obj.length) return 1;",
    "    return 0;",
    "}",
    "",
    "static bool lusa_string_eq(LusaString *left, LusaString *right) {",
    "    if (left == right) return true;",
    "    if (left == NULL || right == NULL) return false;",
    "    return left->obj.length == right->obj.length",
    "        && (left->obj.length == 0u",
    "            || memcmp(left->data, right->data, (size_t)left->obj.length) == 0);",
    "}",
    "",
    "static void lusa_table_reserve(LusaTable *table, uint64_t capacity) {",
    "    uint64_t *grown;",
    "    if (table == NULL || capacity <= table->capacity) return;",
    "    grown = (uint64_t *)realloc(table->items, (size_t)capacity * sizeof(uint64_t));",
    '    if (grown == NULL) lusa_panic("out of memory");',
    "    table->items = grown;",
    "    table->capacity = capacity;",
    "}",
    "",
    "static LusaTable *lusa_table_new(uint64_t count, uint64_t kind) {",
    "    LusaTable *table = (LusaTable *)calloc(1, sizeof(LusaTable));",
    '    if (table == NULL) lusa_panic("out of memory");',
    "    table->obj.type = LUSA_OBJ_TABLE;",
    "    table->obj.length = count;",
    "    table->obj.flags = LUSA_OWNED;",
    "    table->obj.size = (uint64_t)sizeof(LusaTable);",
    "    table->elem_kind = kind;",
    "    table->capacity = 0u;",
    "    table->items = NULL;",
    "    table->key_count = 0u;",
    "    table->map_capacity = 0u;",
    "    table->entries = NULL;",
    "    if (count != 0u) {",
    "        lusa_table_reserve(table, count);",
    "        memset(table->items, 0, (size_t)count * sizeof(uint64_t));",
    "    }",
    "    return table;",
    "}",
    "",
    "static uint64_t lusa_string_hash(LusaString *key) {",
    "    uint64_t hash = 14695981039346656037ull;",
    "    uint64_t i;",
    "    if (key == NULL) return 0u;",
    "    for (i = 0u; i < key->obj.length; i++) {",
    "        hash ^= (uint64_t)(unsigned char)key->data[i];",
    "        hash *= 1099511628211u;",
    "    }",
    "    return hash;",
    "}",
    "",
    "static void lusa_table_map_reserve(LusaTable *table, uint64_t extra) {",
    "    uint64_t capacity;",
    "    uint64_t i;",
    "    LusaEntry *old_entries;",
    "    uint64_t old_capacity;",
    "    if (table == NULL) return;",
    "    capacity = table->map_capacity;",
    "    while (capacity == 0u || (table->key_count + extra) * 4u >= capacity * 3u) {",
    "        capacity = capacity == 0u ? 8u : capacity * 2u;",
    "    }",
    "    if (capacity == table->map_capacity) return;",
    "    old_entries = table->entries;",
    "    old_capacity = table->map_capacity;",
    "    table->entries = (LusaEntry *)calloc((size_t)capacity, sizeof(LusaEntry));",
    '    if (table->entries == NULL) lusa_panic("out of memory");',
    "    table->map_capacity = capacity;",
    "    for (i = 0u; i < old_capacity; i++) {",
    "        LusaEntry entry = old_entries[i];",
    "        if (entry.key != NULL) {",
    "            uint64_t slot = lusa_string_hash(entry.key) & (capacity - 1u);",
    "            while (table->entries[slot].key != NULL) {",
    "                slot = (slot + 1u) & (capacity - 1u);",
    "            }",
    "            table->entries[slot] = entry;",
    "        }",
    "    }",
    "    free(old_entries);",
    "}",
    "",
    "static LusaEntry *lusa_table_map_slot(LusaTable *table, LusaString *key) {",
    "    uint64_t mask;",
    "    uint64_t slot;",
    "    if (table == NULL || table->map_capacity == 0u || key == NULL) return NULL;",
    "    mask = table->map_capacity - 1u;",
    "    slot = lusa_string_hash(key) & mask;",
    "    while (table->entries[slot].key != NULL) {",
    "        if (lusa_string_eq(table->entries[slot].key, key)) {",
    "            return &table->entries[slot];",
    "        }",
    "        slot = (slot + 1u) & mask;",
    "    }",
    "    return &table->entries[slot];",
    "}",
    "",
    "static void lusa_table_set_string(LusaTable *table, LusaString *key,",
    "                                  uint64_t value, uint64_t kind) {",
    "    LusaEntry *slot;",
    "    lusa_table_map_reserve(table, 1u);",
    "    slot = lusa_table_map_slot(table, key);",
    "    if (slot == NULL) return;",
    "    if (slot->key == NULL) {",
    "        slot->key = lusa_string_clone(key);",
    "        table->key_count = table->key_count + 1u;",
    "    } else {",
    "        lusa_drop_value(slot->kind, &slot->value);",
    "    }",
    "    slot->value = value;",
    "    slot->kind = kind;",
    "}",
    "",
    "static LusaValue lusa_table_get_value(LusaTable *table, LusaString *key) {",
    "    LusaValue out = { LUSA_ELEM_UNKNOWN, 0u };",
    "    LusaEntry *slot = lusa_table_map_slot(table, key);",
    "    if (slot != NULL && slot->key != NULL) {",
    "        out.kind = slot->kind;",
    "        out.payload = slot->value;",
    "    }",
    "    return out;",
    "}",
    "",
    "static LusaString *lusa_table_get_string(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    return value.kind == LUSA_ELEM_STRING ? (LusaString *)(uintptr_t)value.payload : NULL;",
    "}",
    "static int32_t lusa_table_get_i32_key(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    return value.kind == LUSA_ELEM_I32 ? (int32_t)(uint32_t)value.payload : 0;",
    "}",
    "static uint32_t lusa_table_get_u32_key(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    return value.kind == LUSA_ELEM_U32 ? (uint32_t)value.payload : 0u;",
    "}",
    "static bool lusa_table_get_bool_key(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    return value.kind == LUSA_ELEM_BOOL ? value.payload != 0u : false;",
    "}",
    "static float lusa_table_get_f32_key(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    uint32_t bits = (uint32_t)value.payload;",
    "    float out = 0.0f;",
    "    if (value.kind == LUSA_ELEM_F32) memcpy(&out, &bits, sizeof(out));",
    "    return out;",
    "}",
    "static LusaTable *lusa_table_get_table_key(LusaTable *table, LusaString *key) {",
    "    LusaValue value = lusa_table_get_value(table, key);",
    "    return value.kind == LUSA_ELEM_TABLE ? (LusaTable *)(uintptr_t)value.payload : NULL;",
    "}",
    "",
    "static bool lusa_table_next_pair(LusaTable *table, uint64_t *cursor,",
    "                                 LusaString **key, LusaValue *value) {",
    "    if (table == NULL) return false;",
    "    while (*cursor < table->map_capacity) {",
    "        LusaEntry *entry = &table->entries[*cursor];",
    "        *cursor = *cursor + 1u;",
    "        if (entry->key != NULL) {",
    "            *key = entry->key;",
    "            value->kind = entry->kind;",
    "            value->payload = entry->value;",
    "            return true;",
    "        }",
    "    }",
    "    return false;",
    "}",
    "",
    "static LusaTable *lusa_table_clone(LusaTable *source) {",
    "    LusaTable *out;",
    "    uint64_t i;",
    "    if (source == NULL) return NULL;",
    "    out = lusa_table_new(source->obj.length, source->elem_kind);",
    "    i = 0u;",
    "    while (i < source->obj.length) {",
    "        uint64_t raw = source->items[i];",
    "        if (source->elem_kind == LUSA_ELEM_STRING) {",
    "            out->items[i] = (uint64_t)(uintptr_t)lusa_string_clone((LusaString *)(uintptr_t)raw);",
    "        } else if (source->elem_kind == LUSA_ELEM_TABLE) {",
    "            out->items[i] = (uint64_t)(uintptr_t)lusa_table_clone((LusaTable *)(uintptr_t)raw);",
    "        } else {",
    "            out->items[i] = raw;",
    "        }",
    "        i = i + 1u;",
    "    }",
    "    i = 0u;",
    "    while (i < source->map_capacity) {",
    "        LusaEntry *entry = &source->entries[i];",
    "        if (entry->key != NULL) {",
    "            uint64_t payload = entry->value;",
    "            if (entry->kind == LUSA_ELEM_STRING) {",
    "                payload = (uint64_t)(uintptr_t)lusa_string_clone((LusaString *)(uintptr_t)payload);",
    "            } else if (entry->kind == LUSA_ELEM_TABLE) {",
    "                payload = (uint64_t)(uintptr_t)lusa_table_clone((LusaTable *)(uintptr_t)payload);",
    "            }",
    "            lusa_table_set_string(out, entry->key, payload, entry->kind);",
    "        }",
    "        i = i + 1u;",
    "    }",
    "    return out;",
    "}",
    "",
    "static void lusa_drop_string(LusaString **value) {",
    "    LusaString *string = *value;",
    "    if (string == NULL) return;",
    "    if ((string->obj.flags & LUSA_OWNED) != 0u) {",
    "        free(string->data);",
    "        free(string);",
    "    }",
    "    *value = NULL;",
    "}",
    "",
    "static void lusa_drop_table(LusaTable **value) {",
    "    LusaTable *table = *value;",
    "    uint64_t i;",
    "    if (table == NULL) return;",
    "    if ((table->obj.flags & LUSA_OWNED) != 0u) {",
    "        i = 0u;",
    "        while (i < table->obj.length) {",
    "            uint64_t raw = table->items[i];",
    "            if (table->elem_kind == LUSA_ELEM_STRING) {",
    "                LusaString *child = (LusaString *)(uintptr_t)raw;",
    "                lusa_drop_string(&child);",
    "            } else if (table->elem_kind == LUSA_ELEM_TABLE) {",
    "                LusaTable *child = (LusaTable *)(uintptr_t)raw;",
    "                lusa_drop_table(&child);",
    "            }",
    "            i = i + 1u;",
    "        }",
    "        i = 0u;",
    "        while (i < table->map_capacity) {",
    "            LusaEntry *entry = &table->entries[i];",
    "            if (entry->key != NULL) {",
    "                lusa_drop_string(&entry->key);",
    "                lusa_drop_value(entry->kind, &entry->value);",
    "            }",
    "            i = i + 1u;",
    "        }",
    "        free(table->entries);",
    "        free(table->items);",
    "        free(table);",
    "    }",
    "    *value = NULL;",
    "}",
    "",
    "static void lusa_drop_value(uint64_t kind, uint64_t *payload) {",
    "    if (payload == NULL) return;",
    "    if (kind == LUSA_ELEM_STRING) {",
    "        LusaString *child = (LusaString *)(uintptr_t)*payload;",
    "        lusa_drop_string(&child);",
    "    } else if (kind == LUSA_ELEM_TABLE) {",
    "        LusaTable *child = (LusaTable *)(uintptr_t)*payload;",
    "        lusa_drop_table(&child);",
    "    }",
    "    *payload = 0u;",
    "}",
    "",
    "static uint64_t lusa_index(uint64_t length, int64_t index) {",
    "    if (index < 1 || (uint64_t)index > length) {",
    '        lusa_throw("E2006", "table index out of bounds");',
    "        return 0u;",
    "    }",
    "    return (uint64_t)index - 1u;",
    "}",
    "",
    "static int32_t lusa_table_get_i32_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    if (table == NULL) return 0;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return 0;",
    "    return (int32_t)(uint32_t)table->items[position];",
    "}",
    "static uint32_t lusa_table_get_u32_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    if (table == NULL) return 0u;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return 0u;",
    "    return (uint32_t)table->items[position];",
    "}",
    "static bool lusa_table_get_bool_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    if (table == NULL) return false;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return false;",
    "    return table->items[position] != 0u;",
    "}",
    "static LusaString *lusa_table_get_string_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    if (table == NULL) return NULL;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return NULL;",
    "    return (LusaString *)(uintptr_t)table->items[position];",
    "}",
    "static LusaTable *lusa_table_get_table_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    if (table == NULL) return NULL;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return NULL;",
    "    return (LusaTable *)(uintptr_t)table->items[position];",
    "}",
    "static float lusa_table_get_f32_at(LusaTable *table, int64_t index) {",
    "    uint64_t position;",
    "    uint32_t bits;",
    "    float value = 0.0f;",
    "    if (table == NULL) return 0.0f;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return 0.0f;",
    "    bits = (uint32_t)table->items[position];",
    "    memcpy(&value, &bits, sizeof(value));",
    "    return value;",
    "}",
    "static LusaValue lusa_table_get_value_at(LusaTable *table, int64_t index) {",
    "    LusaValue out = { table == NULL ? LUSA_ELEM_UNKNOWN : table->elem_kind, 0u };",
    "    uint64_t position;",
    "    if (table == NULL) return out;",
    "    position = lusa_index(table->obj.length, index);",
    "    if (lusa_error_pending) return out;",
    "    out.payload = table->items[position];",
    "    return out;",
    "}",
    "static void lusa_table_set_f32(LusaTable *table, uint64_t position, float value) {",
    "    uint32_t bits = 0;",
    "    memcpy(&bits, &value, sizeof(bits));",
    "    table->items[position] = (uint64_t)bits;",
    "}",
    "static uint64_t lusa_f32_payload(float value) {",
    "    uint32_t bits = 0;",
    "    memcpy(&bits, &value, sizeof(bits));",
    "    return (uint64_t)bits;",
    "}",
    "",
    'static void lusa_print_nil(void) { fputs("nil", stdout); }',
    'static void lusa_print_bool(bool value) { fputs(value ? "true" : "false", stdout); }',
    'static void lusa_print_i32(int32_t value) { printf("%" PRId32, value); }',
    'static void lusa_print_u32(uint32_t value) { printf("%" PRIu32, value); }',
    'static void lusa_print_f32(float value) { printf("%.9g", (double)value); }',
    "static void lusa_print_string(LusaString *value) {",
    '    if (value == NULL) { fputs("nil", stdout); return; }',
    "    if (value->obj.length != 0u) fwrite(value->data, 1u, (size_t)value->obj.length, stdout);",
    "}",
    "static void lusa_print_table(LusaTable *value) {",
    '    if (value == NULL) { fputs("nil", stdout); return; }',
    '    printf("<table:%" PRIu64 ">", value->obj.length + value->key_count);',
    "}",
    "static void lusa_print_value(LusaValue value) {",
    "    switch (value.kind) {",
    "        case LUSA_ELEM_I32: lusa_print_i32((int32_t)(uint32_t)value.payload); break;",
    "        case LUSA_ELEM_U32: lusa_print_u32((uint32_t)value.payload); break;",
    "        case LUSA_ELEM_F32: {",
    "            uint32_t bits = (uint32_t)value.payload;",
    "            float number = 0.0f;",
    "            memcpy(&number, &bits, sizeof(number));",
    "            lusa_print_f32(number);",
    "            break;",
    "        }",
    "        case LUSA_ELEM_BOOL: lusa_print_bool(value.payload != 0u); break;",
    "        case LUSA_ELEM_STRING: lusa_print_string((LusaString *)(uintptr_t)value.payload); break;",
    "        case LUSA_ELEM_TABLE: lusa_print_table((LusaTable *)(uintptr_t)value.payload); break;",
    '        default: fputs("nil", stdout); break;',
    "    }",
    "}",
    "static void lusa_print_i128(lusa_i128 value) {",
    "#if LUSA_HAS_INT128",
    "    char buffer[64];",
    "    int count = 0;",
    "    bool negative = value < 0;",
    "    unsigned __int128 magnitude = negative",
    "        ? (unsigned __int128)(-(value + 1)) + 1u",
    "        : (unsigned __int128)value;",
    "    if (magnitude == 0u) { putchar(48); return; }",
    "    while (magnitude != 0u) {",
    "        buffer[count++] = (char)(48u + (unsigned)(magnitude % 10u));",
    "        magnitude /= 10u;",
    "    }",
    "    if (negative) putchar(45);",
    "    while (count > 0) putchar((int)buffer[--count]);",
    "#else",
    '    printf("%lld", (long long)value);',
    "#endif",
    "}",
    "",
    'static void lusa_require_nonzero_i32(int32_t value) { if (value == 0) lusa_throw("E2001", "division by zero"); }',
    'static void lusa_require_nonzero_u32(uint32_t value) { if (value == 0u) lusa_throw("E2001", "division by zero"); }',
    'static void lusa_require_nonzero_i128(lusa_i128 value) { if (value == 0) lusa_throw("E2001", "division by zero"); }',
    "static int32_t lusa_div_i32(int32_t a, int32_t b) {",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    return a / b;",
    "}",
    "static uint32_t lusa_div_u32(uint32_t a, uint32_t b) {",
    '    if (b == 0u) { lusa_throw("E2001", "division by zero"); return 0u; }',
    "    return a / b;",
    "}",
    "static lusa_i128 lusa_div_i128(lusa_i128 a, lusa_i128 b) {",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    return a / b;",
    "}",
    "static int32_t lusa_floor_div_i32(int32_t a, int32_t b) {",
    "    int32_t q;",
    "    int32_t r;",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    q = a / b; r = a % b;",
    "    if (r != 0 && ((r < 0) != (b < 0))) q -= 1;",
    "    return q;",
    "}",
    "static int32_t lusa_mod_i32(int32_t a, int32_t b) {",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    return a - lusa_floor_div_i32(a, b) * b;",
    "}",
    "static uint32_t lusa_floor_div_u32(uint32_t a, uint32_t b) {",
    '    if (b == 0u) { lusa_throw("E2001", "division by zero"); return 0u; }',
    "    return a / b;",
    "}",
    "static uint32_t lusa_mod_u32(uint32_t a, uint32_t b) {",
    '    if (b == 0u) { lusa_throw("E2001", "division by zero"); return 0u; }',
    "    return a % b;",
    "}",
    "static lusa_i128 lusa_floor_div_i128(lusa_i128 a, lusa_i128 b) {",
    "    lusa_i128 q;",
    "    lusa_i128 r;",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    q = a / b; r = a % b;",
    "    if (r != 0 && ((r < 0) != (b < 0))) q -= 1;",
    "    return q;",
    "}",
    "static lusa_i128 lusa_mod_i128(lusa_i128 a, lusa_i128 b) {",
    '    if (b == 0) { lusa_throw("E2001", "division by zero"); return 0; }',
    "    return a - lusa_floor_div_i128(a, b) * b;",
    "}",
    "static int32_t lusa_pow_i32(int32_t base, int32_t exponent) {",
    "    int32_t result = 1;",
    "    if (exponent < 0) return 0;",
    "    while (exponent > 0) {",
    "        if ((exponent & 1) != 0) result *= base;",
    "        base *= base;",
    "        exponent >>= 1;",
    "    }",
    "    return result;",
    "}",
    "static lusa_i128 lusa_pow_i128(lusa_i128 base, lusa_i128 exponent) {",
    "    lusa_i128 result = 1;",
    "    if (exponent < 0) return 0;",
    "    while (exponent > 0) {",
    "        if ((exponent & 1) != 0) result *= base;",
    "        base *= base;",
    "        exponent >>= 1;",
    "    }",
    "    return result;",
    "}",
    "static float lusa_pow_f32(float base, float exponent) {",
    "    return (float)pow((double)base, (double)exponent);",
    "}",
    ""
}

-- ---- coroutine runtime ---------------------------------------------------

-- Native coroutines use platform-supported stacks: Windows fibers and
-- POSIX ucontext.  The generated functions receive a hidden `LusaCoro *`
-- parameter, so a yield can unwind through ordinary helper calls while the
-- normal drop paths keep every owned local deterministic.
local COROUTINE_RUNTIME = {
    "#if defined(_WIN32)",
    "#include <windows.h>",
    "#else",
    "#include <ucontext.h>",
    "#endif",
    "",
    "typedef struct LusaCoro LusaCoro;",
    "typedef int32_t (*LusaCoroStep)(LusaCoro *);",
    "",
    "struct LusaCoro {",
    "    int state; /* 0 suspended, 1 running, 2 normal, 3 dead */",
    "    bool started;",
    "    bool closing;",
    "    int32_t arg;",
    "    int32_t value;",
    "    LusaCoroStep step;",
    "    LusaCoro *parent;",
    "#if defined(_WIN32)",
    "    void *fiber;",
    "    void *caller;",
    "#else",
    "    ucontext_t context;",
    "    ucontext_t caller;",
    "    char *stack;",
    "#endif",
    "};",
    "",
    "typedef struct LusaCoroResult {",
    "    bool ok;",
    "    int32_t value;",
    "    LusaString *error;",
    "} LusaCoroResult;",
    "",
    "static LusaCoro *lusa_current_coro = NULL;",
    "",
    "static LusaString *lusa_coro_error(const char *message) {",
    "    return lusa_string_new(message, (uint64_t)strlen(message));",
    "}",
    "",
    "static uint64_t lusa_alloc_mark(void) {",
    "    return lusa_alloc_count;",
    "}",
    "",
    "static void lusa_release_allocs_since(uint64_t mark) {",
    "    while (lusa_alloc_count > mark) {",
    "        lusa_alloc_count = lusa_alloc_count - 1u;",
    "        free(lusa_alloc_list[lusa_alloc_count]);",
    "    }",
    "}",
    "",
    "#if defined(_WIN32)",
    "static VOID CALLBACK lusa_coro_fiber_main(void *raw) {",
    "    LusaCoro *co = (LusaCoro *)raw;",
    "    co->value = co->step(co);",
    "    co->state = 3;",
    "    SwitchToFiber(co->caller);",
    "}",
    "#else",
    "static void lusa_coro_context_main(void) {",
    "    LusaCoro *co = lusa_current_coro;",
    "    co->value = co->step(co);",
    "    co->state = 3;",
    "}",
    "#endif",
    "",
    "static LusaCoro *lusa_coro_new(LusaCoroStep step) {",
    "    LusaCoro *co = (LusaCoro *)calloc(1, sizeof(LusaCoro));",
    '    if (co == NULL) { lusa_panic("out of memory"); return NULL; }',
    "    co->state = 0;",
    "    co->step = step;",
    "#if defined(_WIN32)",
    "    if (!IsThreadAFiber()) {",
    '        if (ConvertThreadToFiber(NULL) == NULL) { free(co); lusa_panic("cannot convert thread to a fiber"); return NULL; }',
    "    }",
    "    co->fiber = CreateFiber((SIZE_T)(256u * 1024u),",
    "        lusa_coro_fiber_main, co);",
    '    if (co->fiber == NULL) { free(co); lusa_panic("cannot create coroutine stack"); return NULL; }',
    "#else",
    "    co->stack = (char *)malloc(256u * 1024u);",
    '    if (co->stack == NULL) { free(co); lusa_panic("cannot create coroutine stack"); return NULL; }',
    "    if (getcontext(&co->context) != 0) {",
    '        free(co->stack); free(co); lusa_panic("cannot initialize coroutine context"); return NULL;',
    "    }",
    "    co->context.uc_stack.ss_sp = co->stack;",
    "    co->context.uc_stack.ss_size = 256u * 1024u;",
    "    co->context.uc_link = &co->caller;",
    "    makecontext(&co->context, lusa_coro_context_main, 0);",
    "#endif",
    "    return co;",
    "}",
    "",
    "static void lusa_coro_free_platform(LusaCoro *co) {",
    "#if defined(_WIN32)",
    "    if (co->fiber != NULL) {",
    "        DeleteFiber(co->fiber);",
    "        co->fiber = NULL;",
    "    }",
    "#else",
    "    if (co->stack != NULL) {",
    "        free(co->stack);",
    "        co->stack = NULL;",
    "    }",
    "#endif",
    "}",
    "",
    "static LusaCoroResult lusa_coro_resume(LusaCoro *co, int32_t arg) {",
    "    LusaCoroResult result;",
    "    LusaCoro *parent;",
    "    result.ok = false;",
    "    result.value = 0;",
    "    result.error = NULL;",
    "    if (co == NULL) {",
    '        result.error = lusa_coro_error("E9999: cannot resume a nil coroutine");',
    "        return result;",
    "    }",
    "    if (co->state == 1 || co->state == 2) {",
    '        result.error = lusa_coro_error("E9999: cannot resume a running coroutine");',
    "        return result;",
    "    }",
    "    if (co->state == 3) {",
    '        result.error = lusa_coro_error("E9999: cannot resume a dead coroutine");',
    "        return result;",
    "    }",
    "    parent = lusa_current_coro;",
    "    if (parent != NULL && parent->state == 1) parent->state = 2;",
    "    co->parent = parent;",
    "    co->arg = arg;",
    "    co->closing = false;",
    "    co->state = 1;",
    "    co->started = true;",
    "    lusa_current_coro = co;",
    "#if defined(_WIN32)",
    "    co->caller = GetCurrentFiber();",
    "    SwitchToFiber(co->fiber);",
    "#else",
    "    swapcontext(&co->caller, &co->context);",
    "#endif",
    "    lusa_current_coro = parent;",
    "    if (parent != NULL && parent->state == 2) parent->state = 1;",
    "    if (lusa_error_pending) {",
    "        result.ok = false;",
    "        result.value = 0;",
    "        result.error = lusa_error_string();",
    "        lusa_error_clear();",
    "    } else {",
    "        result.ok = true;",
    "        result.value = co->value;",
    "        result.error = NULL;",
    "    }",
    "    if (co->state == 3) {",
    "        lusa_coro_free_platform(co);",
    "    }",
    "    return result;",
    "}",
    "",
    "static int32_t lusa_coro_yield(LusaCoro *co, int32_t value) {",
    "    if (co == NULL) {",
    '        lusa_throw("E9999", "yield outside a coroutine");',
    "        return 0;",
    "    }",
    "    co->value = value;",
    "    co->state = 0;",
    "    lusa_current_coro = co->parent;",
    "#if defined(_WIN32)",
    "    SwitchToFiber(co->caller);",
    "#else",
    "    swapcontext(&co->context, &co->caller);",
    "#endif",
    "    lusa_current_coro = co;",
    "    co->state = 1;",
    "    return co->arg;",
    "}",
    "",
    "static bool lusa_coro_closing(LusaCoro *co) {",
    "    return co != NULL && co->closing;",
    "}",
    "",
    "static bool lusa_coro_close(LusaCoro *co) {",
    "    LusaCoro *parent;",
    "    if (co == NULL) return true;",
    "    if (co->state == 1 || co->state == 2) return false;",
    "    if (co->state == 0 && co->started) {",
    "        parent = lusa_current_coro;",
    "        if (parent != NULL && parent->state == 1) parent->state = 2;",
    "        co->parent = parent;",
    "        co->closing = true;",
    "        co->arg = 0;",
    "        co->state = 1;",
    "        lusa_current_coro = co;",
    "#if defined(_WIN32)",
    "        co->caller = GetCurrentFiber();",
    "        SwitchToFiber(co->fiber);",
    "#else",
    "        swapcontext(&co->caller, &co->context);",
    "#endif",
    "        lusa_current_coro = parent;",
    "        if (parent != NULL && parent->state == 2) parent->state = 1;",
    "        co->closing = false;",
    "    }",
    "    co->state = 3;",
    "    lusa_coro_free_platform(co);",
    "    return true;",
    "}",
    "",
    "static LusaString *lusa_coro_status(LusaCoro *co) {",
    '    const char *text = "dead";',
    "    uint64_t length;",
    "    if (co != NULL) {",
    '        if (co->state == 0) text = "suspended";',
    '        else if (co->state == 1) text = "running";',
    '        else if (co->state == 2) text = "normal";',
    "    }",
    "    length = (uint64_t)strlen(text);",
    "    return lusa_string_new(text, length);",
    "}",
    "",
    "static bool lusa_coro_isyieldable(void) {",
    "    return lusa_current_coro != NULL && lusa_current_coro->state == 1;",
    "}",
    "",
    "static void lusa_drop_coroutine(LusaCoro **value) {",
    "    if (value == NULL || *value == NULL) return;",
    "    if (lusa_coro_close(*value)) {",
    "        free(*value);",
    "        *value = NULL;",
    "    }",
    "}",
    ""
}

-- ---- string literals -----------------------------------------------------

local function add_string(value)
    if emit_string_ids[value] == nil then
        emit_strings[#emit_strings + 1] = value
        emit_string_ids[value] = #emit_strings
    end
end

local function add_int(value)
    if emit_int_ids[value] == nil then
        local id = #emit_ints + 1
        local key = value
        emit_ints[id] = value
        emit_int_ids[key] = id
    end
end

local collect_strings_expr
local collect_strings_block

collect_strings_expr = function(expr)
    if expr == nil then
        return
    end
    local tag = expr.tag
    if tag == "String" then
        add_string(expr.value)
        return
    end
    if tag == "Number" then
        if expr.int ~= nil then
            add_int(expr.int)
        end
        return
    end
    if tag == "Paren" or tag == "Unary" or tag == "Clone"
        or tag == "Borrow" or tag == "Move" or tag == "AddrOf" then
        collect_strings_expr(expr.value)
        return
    end
    if tag == "Array" then
        local i = 1
        while i <= #expr.items do
            collect_strings_expr(expr.items[i])
            i = i + 1
        end
        return
    end
    if tag == "Binary" or tag == "Logical" then
        collect_strings_expr(expr.lhs)
        collect_strings_expr(expr.rhs)
        return
    end
    if tag == "Call" then
        collect_strings_expr(expr.callee)
        local i = 1
        while i <= #expr.args do
            collect_strings_expr(expr.args[i])
            i = i + 1
        end
        return
    end
    if tag == "Field" then
        add_string(expr.field_name)
        collect_strings_expr(expr.table)
        return
    end
    if tag == "MethodCall" then
        collect_strings_expr(expr.obj)
        local i = 1
        while i <= #expr.args do
            collect_strings_expr(expr.args[i])
            i = i + 1
        end
        return
    end
    if tag == "Table" then
        local i = 1
        while i <= #expr.items do
            if expr.keys ~= nil and expr.keys[i] ~= nil then
                add_string(expr.keys[i])
            end
            collect_strings_expr(expr.items[i])
            i = i + 1
        end
        return
    end
    if tag == "StructLit" then
        local i = 1
        while i <= #expr.fields do
            local field = expr.fields[i]
            collect_strings_expr(field.value)
            i = i + 1
        end
        return
    end
    if tag == "Index" then
        collect_strings_expr(expr.table)
        collect_strings_expr(expr.index)
    end
end

collect_strings_block = function(body)
    local i = 1
    while i <= #body do
        local stmt = body[i]
        local tag = stmt.tag
        if tag == "Local" then
            local j = 1
            while j <= #stmt.values do
                collect_strings_expr(stmt.values[j])
                j = j + 1
            end
        elseif tag == "Assign" then
            local j = 1
            while j <= #stmt.targets do
                local target = stmt.targets[j]
                if target.tag == "Field" then
                    add_string(target.field_name)
                    collect_strings_expr(target.table)
                elseif target.tag == "Index" then
                    collect_strings_expr(target.table)
                    collect_strings_expr(target.index)
                end
                j = j + 1
            end
            j = 1
            while j <= #stmt.values do
                collect_strings_expr(stmt.values[j])
                j = j + 1
            end
        elseif tag == "CallStmt" then
            collect_strings_expr(stmt.value)
        elseif tag == "If" then
            local j = 1
            while j <= #stmt.branches do
                local branch = stmt.branches[j]
                collect_strings_expr(branch.cond)
                collect_strings_block(branch.body)
                j = j + 1
            end
            if stmt.else_body ~= nil then
                collect_strings_block(stmt.else_body)
            end
        elseif tag == "ForIn" then
            if stmt.iter_kind == "gmatch" then
                collect_strings_expr(stmt.iter.string_source)
                collect_strings_expr(stmt.iter.string_pattern)
            else
                collect_strings_expr(stmt.iter.args[1])
            end
            collect_strings_block(stmt.body)
        elseif tag == "While" then
            collect_strings_expr(stmt.cond)
            collect_strings_block(stmt.body)
        elseif tag == "Repeat" then
            collect_strings_block(stmt.body)
            collect_strings_expr(stmt.cond)
        elseif tag == "Do" or tag == "Unsafe" then
            collect_strings_block(stmt.body)
        elseif tag == "Return" then
            local j = 1
            while j <= #stmt.values do
                collect_strings_expr(stmt.values[j])
                j = j + 1
            end
        elseif tag == "Function" then
            collect_strings_block(stmt.body)
        end
        i = i + 1
    end
end

local function emit_static_strings()
    local i = 1
    while i <= #emit_strings do
        local value = emit_strings[i]
        local bytes = {}
        local j = 1
        while j <= #value do
            local codepoint = string.byte(value, j)
            if codepoint < 0x80 then
                bytes[#bytes + 1] = tostring(codepoint)
            elseif codepoint < 0x800 then
                bytes[#bytes + 1] = tostring(0xC0
                    + math.floor(codepoint / 0x40))
                bytes[#bytes + 1] = tostring(0x80 + codepoint % 0x40)
            elseif codepoint < 0x10000 then
                bytes[#bytes + 1] = tostring(0xE0
                    + math.floor(codepoint / 0x1000))
                bytes[#bytes + 1] = tostring(0x80
                    + math.floor(codepoint / 0x40) % 0x40)
                bytes[#bytes + 1] = tostring(0x80 + codepoint % 0x40)
            else
                bytes[#bytes + 1] = tostring(0xF0
                    + math.floor(codepoint / 0x40000))
                bytes[#bytes + 1] = tostring(0x80
                    + math.floor(codepoint / 0x1000) % 0x40)
                bytes[#bytes + 1] = tostring(0x80
                    + math.floor(codepoint / 0x40) % 0x40)
                bytes[#bytes + 1] = tostring(0x80 + codepoint % 0x40)
            end
            j = j + 1
        end
        local byte_length = #bytes
        bytes[#bytes + 1] = "0"
        line("static unsigned char lusa_bytes_" .. tostring(i) .. "[] = {"
            .. table.concat(bytes, ", ") .. "};")
        line("static LusaString lusa_str_" .. tostring(i)
            .. " = { {LUSA_OBJ_STRING, " .. tostring(byte_length)
            .. "u, 0u, sizeof(LusaString)}, (char *)lusa_bytes_"
            .. tostring(i) .. " };")
        i = i + 1
    end
    if #emit_strings > 0 then
        line("")
    end
end

local function emit_static_ints()
    local i = 1
    while i <= #emit_ints do
        line('static const char lusa_int_' .. tostring(i)
            .. '[] = "' .. emit_ints[i] .. '";')
        i = i + 1
    end
    if #emit_ints > 0 then
        line("")
    end
end

-- ---- expression lowering -------------------------------------------------

local function format_integer(value)
    return tostring(math.floor(value))
end

local function format_float(value)
    local text = string.format("%.9g", value)
    local has_dot = string.find(text, ".", 1, true) ~= nil
    local has_exp = string.find(text, "e", 1, true) ~= nil
    local has_exp_upper = string.find(text, "E", 1, true) ~= nil
    if not has_dot and not has_exp and not has_exp_upper then
        text = text .. ".0"
    end
    return text .. "f"
end

local emit_expr

local function emit_value_payload(expr, value)
    local type_name = expr.ctype
    if type_name == "f32" then
        return "lusa_f32_payload(" .. value .. ")", "LUSA_ELEM_F32"
    end
    if type_name == "string" then
        return "(uint64_t)(uintptr_t)(" .. value .. ")", "LUSA_ELEM_STRING"
    end
    if type_name == "table" or table_element(type_name) ~= nil then
        return "(uint64_t)(uintptr_t)(" .. value .. ")", "LUSA_ELEM_TABLE"
    end
    if type_name == "u32" then
        return "(uint64_t)(" .. value .. ")", "LUSA_ELEM_U32"
    end
    if type_name == "bool" then
        return "(uint64_t)((" .. value .. ") ? 1u : 0u)", "LUSA_ELEM_BOOL"
    end
    if type_name == "i32" then
        return "(uint64_t)(" .. value .. ")", "LUSA_ELEM_I32"
    end
    if type_name == "value" then
        return "((" .. value .. ").payload)", "((" .. value .. ").kind)"
    end
    return "0u", "LUSA_ELEM_UNKNOWN"
end

local function emit_clone_heap(type_name, value)
    if type_name == "string" then
        return "lusa_string_clone(" .. value .. ")"
    end
    if is_table_type(type_name) then
        return "lusa_table_clone(" .. value .. ")"
    end
    if is_struct_type(type_name) then
        return "lusa_clone_" .. type_name .. "(" .. value .. ")"
    end
    return value
end

local function emit_cast_to(type_name, value)
    if is_pointer_type(type_name) then
        return "(" .. c_type(type_name) .. ")(uintptr_t)(" .. value .. ")"
    end
    if type_name == "u32" or type_name == "i32"
        or type_name == "f32" or type_name == "bool" then
        return "(" .. c_type(type_name) .. ")(" .. value .. ")"
    end
    return value
end

local function emit_number(expr)
    local exact_int = expr.int
    local literal_float = expr.float == true
    local value = expr.value
    local type_name = expr.ctype
    local line_number = expr.line
    local column_number = expr.column
    if type_name == "f32" then
        if is_integer(value) then
            return "((float)" .. format_integer(value) .. ")"
        end
        return format_float(value)
    end
    if type_name == "u32" then
        return "((uint32_t)" .. format_integer(value) .. ")"
    end
    if type_name == "i128" then
        -- Pure integer literals carry their exact decimal/hex spelling; never
        -- round-trip them through f64 (the IEEE-754 precision limit).
        if exact_int ~= nil and not literal_float then
            local id = emit_int_ids[exact_int]
            if id == nil then
                fail(line_number, column_number,
                    "internal: exact integer literal was not collected")
            end
            return "lusa_i128_parse(lusa_int_" .. tostring(id) .. ")"
        end
        return "((lusa_i128)" .. format_integer(value) .. ")"
    end
    return "((int32_t)" .. format_integer(value) .. ")"
end

local function emit_string_concat(left, right)
    return "lusa_string_concat(" .. left .. ", " .. right .. ")"
end

local function emit_comparison(expr, lhs, rhs)
    local op = expr.op
    local common = expr.common_type
    if common == "string" then
        if op == "==" then return "lusa_string_eq(" .. lhs .. ", " .. rhs .. ")" end
        if op == "~=" then return "(!lusa_string_eq(" .. lhs .. ", " .. rhs .. "))" end
        if op == "<" then return "(lusa_string_cmp(" .. lhs .. ", " .. rhs .. ") < 0)" end
        if op == "<=" then return "(lusa_string_cmp(" .. lhs .. ", " .. rhs .. ") <= 0)" end
        if op == ">" then return "(lusa_string_cmp(" .. lhs .. ", " .. rhs .. ") > 0)" end
        if op == ">=" then return "(lusa_string_cmp(" .. lhs .. ", " .. rhs .. ") >= 0)" end
    end
    if common == "nil" then
        if op == "==" then return "((" .. lhs .. ") == (" .. rhs .. "))" end
        if op == "~=" then return "((" .. lhs .. ") != (" .. rhs .. "))" end
    end
    local c_op = op
    if c_op == "~=" then
        c_op = "!="
    end
    return "((" .. lhs .. ") " .. c_op .. " (" .. rhs .. "))"
end

local function emit_arithmetic(expr, lhs, rhs)
    local op = expr.op
    local type_name = expr.ctype
    if op == ".." then
        return emit_string_concat(lhs, rhs)
    end
    if op == "^" then
        if type_name == "f32" then
            return "lusa_pow_f32(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "i128" then
            return "lusa_pow_i128(" .. lhs .. ", " .. rhs .. ")"
        end
        return "lusa_pow_i32(" .. lhs .. ", " .. rhs .. ")"
    end
    if op == "/" then
        if type_name == "u32" then
            return "lusa_div_u32(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "i128" then
            return "lusa_div_i128(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "f32" then
            return "((" .. lhs .. ") / (" .. rhs .. "))"
        end
        return "lusa_div_i32(" .. lhs .. ", " .. rhs .. ")"
    end
    if op == "//" then
        if type_name == "u32" then
            return "lusa_floor_div_u32(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "i128" then
            return "lusa_floor_div_i128(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "f32" then
            return "floorf((" .. lhs .. ") / (" .. rhs .. "))"
        end
        return "lusa_floor_div_i32(" .. lhs .. ", " .. rhs .. ")"
    end
    if op == "%" then
        if type_name == "u32" then
            return "lusa_mod_u32(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "i128" then
            return "lusa_mod_i128(" .. lhs .. ", " .. rhs .. ")"
        end
        if type_name == "f32" then
            return "fmodf(" .. lhs .. ", " .. rhs .. ")"
        end
        return "lusa_mod_i32(" .. lhs .. ", " .. rhs .. ")"
    end
    return "((" .. lhs .. ") " .. op .. " (" .. rhs .. "))"
end

local function emit_string_builtin(expr)
    local name = expr.builtin
    if name ~= "string_find" and name ~= "string_match"
        and name ~= "string_gsub" and name ~= "string_gmatch" then
        return nil
    end
    if name == "string_gmatch" then
        fail(expr.line, expr.column,
            "internal: gmatch must be lowered through a generic for loop")
    end
    local source = emit_expr(expr.string_source)
    local pattern = emit_expr(expr.string_pattern)
    if name == "string_find" then
        local init = "1"
        if expr.string_init ~= nil then
            init = emit_expr(expr.string_init)
        end
        local plain = "false"
        if expr.string_plain ~= nil then
            plain = emit_expr(expr.string_plain)
        end
        return "lusa_string_find_start(" .. source .. ", " .. pattern
            .. ", " .. init .. ", " .. plain .. ")"
    end
    if name == "string_match" then
        local init = "1"
        if expr.string_init ~= nil then
            init = emit_expr(expr.string_init)
        end
        return "lusa_string_match(" .. source .. ", " .. pattern
            .. ", " .. init .. ")"
    end
    local replacement = emit_expr(expr.string_replacement)
    local limit = "-1"
    if expr.string_limit ~= nil then
        limit = emit_expr(expr.string_limit)
    end
    return "lusa_string_gsub(" .. source .. ", " .. pattern .. ", "
        .. replacement .. ", " .. limit .. ", NULL)"
end

emit_expr = function(expr)
    if expr == nil then
        fail(0, 0, "internal: nil expression reached the C emitter")
    end
    local tag = expr.tag
    if tag == "Nil" then
        return "NULL"
    end
    if tag == "Bool" then
        if expr.value == true then return "true" end
        return "false"
    end
    if tag == "Number" then
        return emit_number(expr)
    end
    if tag == "String" then
        local id = emit_string_ids[expr.value]
        if id == nil then
            fail(expr.line, expr.column, "internal: string literal was not collected")
        end
        return "(&lusa_str_" .. tostring(id) .. ")"
    end
    if tag == "Name" then
        local entry = emit_value_lookup(expr.name)
        if entry == nil then
            fail(expr.line, expr.column,
                "internal: unbound name `" .. expr.name .. "` reached the C emitter")
        end
        return entry.cname
    end
    if tag == "Paren" then
        return "(" .. emit_expr(expr.value) .. ")"
    end
    if tag == "Unary" then
        if expr.op == "not" then
            return "(!" .. emit_expr(expr.value) .. ")"
        end
        if expr.op == "#" then
            local operand_type = expr.value.ctype
            local array_element, array_length = array_info(operand_type)
            if array_element ~= nil then
                return "((int32_t)" .. tostring(array_length) .. ")"
            end
            local inner = emit_expr(expr.value)
            return "((int32_t)(((const LusaObj *)(" .. inner .. "))->length))"
        end
        if expr.op == "-" then
            return "(-(" .. emit_expr(expr.value) .. "))"
        end
    end
    if tag == "Binary" then
        local lhs = emit_expr(expr.lhs)
        local rhs = emit_expr(expr.rhs)
        local op = expr.op
        if expr.ptr_math then
            -- Raw pointer arithmetic: C scales by the element size.
            return "((" .. lhs .. ") " .. op .. " (" .. rhs .. "))"
        end
        if op == "==" or op == "~=" or op == "<" or op == "<="
            or op == ">" or op == ">=" then
            return emit_comparison(expr, lhs, rhs)
        end
        return emit_arithmetic(expr, lhs, rhs)
    end
    if tag == "Logical" then
        local lhs = emit_expr(expr.lhs)
        local rhs = emit_expr(expr.rhs)
        if expr.op == "and" then
            return "((" .. lhs .. ") && (" .. rhs .. "))"
        end
        return "((" .. lhs .. ") || (" .. rhs .. "))"
    end
    if tag == "Call" then
        local string_value = emit_string_builtin(clone expr)
        if string_value ~= nil then
            return string_value
        end
        if expr.builtin == "unsafe_ptr_cast" then
            return "((uintptr_t)(" .. emit_expr(expr.args[1]) .. "))"
        end
        if expr.builtin == "unsafe_alloc" then
            return "((uintptr_t)(lusa_unsafe_alloc((uint64_t)("
                .. emit_expr(expr.args[1]) .. "))))"
        end
        if expr.builtin == "unsafe_read_mem" then
            return "(*(volatile uint32_t *)(uintptr_t)("
                .. emit_expr(expr.args[1]) .. "))"
        end
        if expr.builtin == "unsafe_write_mem" then
            local address = emit_expr(expr.args[1])
            local value = emit_expr(expr.args[2])
            return "((*(volatile uint32_t *)(uintptr_t)(" .. address
                .. ")) = (uint32_t)(" .. value .. "))"
        end
        if expr.builtin == "volatile_read" then
            local element = expr.elem_type or "u32"
            local base = c_type(element)
            return "(*(volatile " .. base .. " *)(uintptr_t)("
                .. emit_expr(expr.args[1]) .. "))"
        end
        if expr.builtin == "volatile_write" then
            local element = expr.elem_type or "u32"
            local base = c_type(element)
            local address = emit_expr(expr.args[1])
            local value = emit_expr(expr.args[2])
            return "((*(volatile " .. base .. " *)(uintptr_t)(" .. address
                .. ")) = (" .. base .. ")(" .. value .. "))"
        end
        if expr.builtin == "unsafe_nop" then
            return "LUSA_NOP()"
        end
        if expr.builtin == "unsafe_asm" or expr.builtin == "asm" then
            return 'LUSA_ASM("' .. expr.asm_text .. '")'
        end
        if expr.builtin == "coroutine_create" then
            local cname = emit_function_cnames[expr.fn_name]
            if cname == nil then
                fail(expr.line, expr.column,
                    "internal: coroutine entry has no C function")
            end
            return "lusa_coro_new((LusaCoroStep)" .. cname .. ")"
        end
        if expr.builtin == "coroutine_yield" then
            local value = "0"
            if #expr.args >= 1 and expr.args[1] ~= nil then
                value = emit_expr(expr.args[1])
            end
            return "lusa_coro_yield(lusa_co, " .. value .. ")"
        end
        if expr.builtin == "coroutine_status" then
            return "lusa_coro_status(" .. emit_expr(expr.args[1]) .. ")"
        end
        if expr.builtin == "coroutine_close" then
            return "lusa_coro_close(" .. emit_expr(expr.args[1]) .. ")"
        end
        if expr.builtin == "coroutine_isyieldable" then
            return "lusa_coro_isyieldable()"
        end
        if expr.builtin == "print" then
            fail(expr.line, expr.column,
                "internal: `print` must be used as a statement")
        end
        if expr.builtin == "error" then
            local message = emit_expr(expr.args[1])
            return '(lusa_throw("E9000", (' .. message
                .. ') == NULL ? "" : (' .. message .. ')->data), (void)0)'
        end
        if expr.builtin == "assert" then
            local condition = emit_expr(expr.args[1])
            local message = '"assertion failed"'
            if expr.args[2] ~= nil then
                local rendered = emit_expr(expr.args[2])
                message = '((' .. rendered .. ') == NULL ? "" : ('
                    .. rendered .. ')->data)'
            end
            return '(( ' .. condition .. ') ? (void)0 : (lusa_throw('
                .. '"E9100", ' .. message .. '), (void)0))'
        end
        local cname = emit_function_cnames[expr.fn_name]
        if cname == nil then
            fail(expr.line, expr.column, "internal: call has no function name")
        end
        local args = { "lusa_current_coro" }
        local i = 1
        while i <= #expr.args do
            args[#args + 1] = emit_expr(expr.args[i])
            i = i + 1
        end
        return cname .. "(" .. table.concat(args, ", ") .. ")"
    end
    if tag == "Clone" then
        local inner = emit_expr(expr.value)
        if expr.ctype == "string" then
            return "lusa_string_clone(" .. inner .. ")"
        end
        if is_table_type(expr.ctype) then
            return "lusa_table_clone(" .. inner .. ")"
        end
        if is_struct_type(expr.ctype) then
            return "lusa_clone_" .. expr.ctype .. "(" .. inner .. ")"
        end
        return inner
    end
    if tag == "Borrow" then
        return emit_expr(expr.value)
    end
    if tag == "Move" then
        return emit_expr(expr.value)
    end
    if tag == "StructLit" then
        local layout = borrow check_structs[expr.name]
        if layout == nil then
            fail(expr.line, expr.column,
                "internal: unknown struct `" .. tostring(expr.name) .. "`")
        end
        local fields = expr.fields or {}
        local parts = {}
        local i = 1
        while i <= #fields do
            local field = clone fields[i]
            local field_type = clone (borrow layout.fields[field.name]).type
            local value_type = field.value.ctype or "nil"
            local rendered = emit_expr(clone field.value)
            if is_heap_type(value_type) and field.value.own == false
                and field.value.tag ~= "Borrow" then
                -- The literal owns its fields. A view into another value
                -- (notably `other.field`) must be deep-copied.
                rendered = emit_clone_heap(value_type, rendered)
            end
            rendered = emit_cast_to(field_type, rendered)
            parts[#parts + 1] = "." .. field.name .. " = " .. rendered
            i = i + 1
        end
        local name = fresh("struct")
        if #parts == 0 then
            line(expr.name .. " " .. name .. " = (" .. expr.name .. "){0};")
        else
            line(expr.name .. " " .. name .. " = (" .. expr.name .. "){ "
                .. table.concat(parts, ", ") .. " };")
        end
        i = 1
        while i <= #fields do
            local field = fields[i]
            if field.value.own ~= false then
                null_moved_source(field.value, nil)
            end
            i = i + 1
        end
        return name
    end
    if tag == "Array" then
        local array_element, array_length = array_info(expr.ctype)
        if array_element == nil then
            fail(expr.line, expr.column,
                "internal: array literal has no canonical array type")
        end
        local parts = {}
        local i = 1
        while i <= #expr.items do
            local item = expr.items[i]
            local value = emit_expr(clone item)
            if is_heap_type(array_element) and item.own == false then
                value = emit_clone_heap(array_element, clone value)
            end
            parts[#parts + 1] = emit_cast_to(array_element, value)
            if item.own ~= false then
                null_moved_source(item, nil)
            end
            i = i + 1
        end
        return "((" .. c_type(array_element) .. "["
            .. tostring(array_length) .. "]){ "
            .. table.concat(parts, ", ") .. " })"
    end
    if tag == "AddrOf" then
        return "(&(" .. emit_expr(expr.value) .. "))"
    end
    if tag == "Table" then
        local array_count = 0
        local i = 1
        while i <= #expr.items do
            if expr.keys == nil or expr.keys[i] == nil then
                array_count = array_count + 1
            end
            i = i + 1
        end
        local kind = elem_kind(expr.elem_type or "nil")
        local table_name = fresh("table")
        line("LusaTable *" .. table_name .. " = lusa_table_new("
            .. tostring(array_count) .. "u, " .. kind .. ");")
        local position = 0
        i = 1
        while i <= #expr.items do
            local item = expr.items[i]
            local item_type = item.ctype
            local value = emit_expr(clone item)
            if is_heap_type(item_type) and item.own == false then
                -- A table owns its elements, so views and borrowed values are
                -- copied instead of being aliased into the new table.
                value = emit_clone_heap(item_type, value)
            end
            local key = expr.keys ~= nil and expr.keys[i] or nil
            if key ~= nil then
                local string_id = emit_string_ids[key]
                if string_id == nil then
                    fail(item.line, item.column,
                        "internal: table key was not collected")
                end
                local payload, value_kind = emit_value_payload(
                    { ctype = item_type }, value)
                line("lusa_table_set_string(" .. table_name
                    .. ", &lusa_str_" .. tostring(string_id) .. ", "
                    .. payload .. ", " .. value_kind .. ");")
            else
                local pos_text = tostring(position)
                if item_type == "f32" then
                    line("lusa_table_set_f32(" .. table_name .. ", "
                        .. pos_text .. ", " .. value .. ");")
                elseif is_heap_type(item_type) then
                    line(table_name .. "->items[" .. pos_text
                        .. "] = (uint64_t)(uintptr_t)(" .. value .. ");")
                else
                    line(table_name .. "->items[" .. pos_text
                        .. "] = (uint64_t)(" .. value .. ");")
                end
                position = position + 1
            end
            if item.own ~= false then
                null_moved_source(item, nil)
            end
            i = i + 1
        end
        return table_name
    end
    if tag == "Field" then
        if expr.struct_access then
            return "(" .. emit_expr(expr.table) .. ")." .. expr.field_name
        end
        local table_value = emit_expr(expr.table)
        local string_id = emit_string_ids[expr.field_name]
        if string_id == nil then
            fail(expr.line, expr.column,
                "internal: field key was not collected")
        end
        local key = "&lusa_str_" .. tostring(string_id)
        local field_type = expr.ctype
        if field_type == "string" then
            return "lusa_table_get_string(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "i32" then
            return "lusa_table_get_i32_key(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "u32" then
            return "lusa_table_get_u32_key(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "f32" then
            return "lusa_table_get_f32_key(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "bool" then
            return "lusa_table_get_bool_key(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "table" or table_element(field_type) ~= nil then
            return "lusa_table_get_table_key(" .. table_value .. ", " .. key .. ")"
        elseif field_type == "value" then
            return "lusa_table_get_value(" .. table_value .. ", " .. key .. ")"
        end
        fail(expr.line, expr.column,
            "internal: unsupported field type `" .. tostring(field_type) .. "`")
    end
    if tag == "Deref" then
        return "(*(" .. emit_expr(expr.value) .. "))"
    end
    if tag == "MethodCall" then
        local string_value = emit_string_builtin(clone expr)
        if string_value ~= nil then
            return string_value
        end
        local cname = emit_function_cnames[expr.fn_key]
        if cname == nil then
            fail(expr.line, expr.column, "internal: method has no function name")
        end
        local args = { "lusa_current_coro", emit_expr(expr.obj) }
        local i = 1
        while i <= #expr.args do
            args[#args + 1] = emit_expr(expr.args[i])
            i = i + 1
        end
        return cname .. "(" .. table.concat(args, ", ") .. ")"
    end
    if tag == "Index" then
        if expr.array_access then
            local table_value = emit_expr(expr.table)
            local index_value = emit_expr(expr.index)
            return "(" .. table_value .. ")[(int32_t)("
                .. index_value .. ")]"
        end
        local table_type = expr.table.ctype
        local table_value = emit_expr(expr.table)
        local index_value = emit_expr(expr.index)
        if expr.field_name ~= nil then
            local string_id = emit_string_ids[expr.field_name]
            if string_id == nil then
                fail(expr.line, expr.column,
                    "internal: field key was not collected")
            end
            local key = "&lusa_str_" .. tostring(string_id)
            local field_type = expr.ctype
            if field_type == "string" then
                return "lusa_table_get_string(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "i32" then
                return "lusa_table_get_i32_key(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "u32" then
                return "lusa_table_get_u32_key(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "f32" then
                return "lusa_table_get_f32_key(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "bool" then
                return "lusa_table_get_bool_key(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "table" or table_element(field_type) ~= nil then
                return "lusa_table_get_table_key(" .. table_value .. ", " .. key .. ")"
            elseif field_type == "value" then
                return "lusa_table_get_value(" .. table_value .. ", " .. key .. ")"
            else
                fail(expr.line, expr.column,
                    "internal: unsupported indexed field type `"
                    .. tostring(field_type) .. "`")
            end
        end
        if expr.dynamic_key then
            return "lusa_table_get_value(" .. table_value .. ", " .. index_value .. ")"
        end
        local element = expr.elem_type or table_element(table_type)
        local call
        if element == "i32" then
            call = "lusa_table_get_i32_at"
        elseif element == "u32" then
            call = "lusa_table_get_u32_at"
        elseif element == "f32" then
            call = "lusa_table_get_f32_at"
        elseif element == "bool" then
            call = "lusa_table_get_bool_at"
        elseif element == "string" then
            call = "lusa_table_get_string_at"
        elseif element == "table" or table_element(element) ~= nil then
            call = "lusa_table_get_table_at"
        else
            fail(expr.line, expr.column,
                "internal: unsupported table element type `" .. tostring(element) .. "`")
        end
        return call .. "(" .. table_value .. ", (int64_t)(" .. index_value .. "))"
    end
    fail(expr.line, expr.column,
        "internal: unsupported expression node `" .. tostring(tag) .. "`")
end

-- ---- statement lowering --------------------------------------------------

local emit_stmt
local emit_block_statements

local function emit_print_call(call)
    local args = call.args
    local i = 1
    while i <= #args do
        if i > 1 then
            line("putchar(32);")
        end
        local arg = args[i]
        local type_name = arg.ctype
        local arg_line = arg.line
        local arg_column = arg.column
        local arg_builtin = arg.builtin
        local value = emit_expr(arg)
        if type_name == "string" then
            local owned_temp = nil
            if arg_builtin == "string_match" or arg_builtin == "string_gsub" then
                owned_temp = fresh("print_text")
                line("LusaString *" .. owned_temp .. " = " .. value .. ";")
                value = owned_temp
            end
            line("lusa_print_string(" .. value .. ");")
            if owned_temp ~= nil then
                line("lusa_drop_string(&" .. owned_temp .. ");")
            end
        elseif type_name == "i32" then
            line("lusa_print_i32(" .. value .. ");")
        elseif type_name == "u32" then
            line("lusa_print_u32(" .. value .. ");")
        elseif type_name == "i128" then
            line("lusa_print_i128(" .. value .. ");")
        elseif type_name == "f32" then
            line("lusa_print_f32(" .. value .. ");")
        elseif type_name == "bool" then
            line("lusa_print_bool(" .. value .. ");")
        elseif type_name == "table" or table_element(type_name) ~= nil then
            line("lusa_print_table(" .. value .. ");")
        elseif type_name == "value" then
            line("lusa_print_value(" .. value .. ");")
        elseif pointer_element(type_name) ~= nil then
            line("lusa_print_u32((uint32_t)(uintptr_t)(" .. value .. "));")
        elseif type_name == "nil" then
            line("lusa_print_nil();")
        else
            fail(arg_line, arg_column,
                "internal: cannot print type `" .. tostring(type_name) .. "`")
        end
        i = i + 1
    end
    line("putchar(10);")
end

local function emit_pcall_local(stmt)
    local call = stmt.values[1]
    local ret = stmt.pcall.ret
    local has_result = stmt.pcall.has_result
    local alloc_mark = fresh("pcall_mark")
    line("uint64_t " .. alloc_mark .. " = lusa_alloc_mark();")
    line("lusa_error_clear();")
    local result_temp = nil
    if ret == "void" then
        line("(void)(" .. emit_expr(clone call) .. ");")
    else
        result_temp = fresh("pcall_value")
        line(c_type(ret) .. " " .. result_temp .. " = "
            .. emit_expr(clone call) .. ";")
    end
    local ok_temp = fresh("pcall_ok")
    line("bool " .. ok_temp .. " = !lusa_error_pending;")
    line("if (!" .. ok_temp .. ") lusa_release_allocs_since(" .. alloc_mark .. ");")
    local err_temp = fresh("pcall_err")
    line("LusaString *" .. err_temp .. " = " .. ok_temp
        .. ' ? lusa_string_new("", 0u) : lusa_error_string();')
    line("lusa_error_clear();")

    local ok_entry = emit_scope_declare(stmt.names[1], "bool", false, false)
    line("bool " .. ok_entry.cname .. " = " .. ok_temp .. ";")
    if has_result then
        local result_entry = emit_scope_declare(stmt.names[2], ret,
            is_heap_type(ret), false)
        line(c_type(ret) .. " " .. result_entry.cname .. " = "
            .. result_temp .. ";")
        local err_entry = emit_scope_declare(stmt.names[3], "string", true, false)
        line("LusaString *" .. err_entry.cname .. " = " .. err_temp .. ";")
        return
    end

    -- Two names mean `ok, err`; release an owned result that is discarded.
    if result_temp ~= nil and is_heap_type(ret) then
        if ret == "string" then
            line("lusa_drop_string(&" .. result_temp .. ");")
        elseif ret == "coroutine" then
            line("lusa_drop_coroutine(&" .. result_temp .. ");")
        else
            line("lusa_drop_table(&" .. result_temp .. ");")
        end
    end
    local err_entry = emit_scope_declare(stmt.names[2], "string", true, false)
    line("LusaString *" .. err_entry.cname .. " = " .. err_temp .. ";")
end

local function emit_coroutine_resume_local(stmt)
    local call = stmt.values[1]
    local has_error = stmt.coroutine_resume.has_error
    local co = emit_expr(call.args[1])
    local arg = "0"
    if #call.args >= 2 and call.args[2] ~= nil then
        arg = emit_expr(call.args[2])
    end
    local result_temp = fresh("coro_result")
    line("LusaCoroResult " .. result_temp .. " = lusa_coro_resume("
        .. co .. ", " .. arg .. ");")
    local ok_entry = emit_scope_declare(stmt.names[1], "bool", false, false)
    line("bool " .. ok_entry.cname .. " = " .. result_temp .. ".ok;")
    local value_entry = emit_scope_declare(stmt.names[2], "i32", false, false)
    line("int32_t " .. value_entry.cname .. " = " .. result_temp .. ".value;")
    if has_error then
        local err_entry = emit_scope_declare(stmt.names[3], "string", true, false)
        line("LusaString *" .. err_entry.cname .. " = " .. result_temp
            .. '.error != NULL ? ' .. result_temp
            .. '.error : lusa_string_new("", 0u);')
    else
        line("lusa_drop_string(&" .. result_temp .. ".error);")
    end
end

local function emit_string_result_local(stmt)
    local call = stmt.values[1]
    local source = emit_expr(call.string_source)
    local pattern = emit_expr(call.string_pattern)
    if stmt.string_result == "find" then
        local init = "1"
        if call.string_init ~= nil then
            init = emit_expr(call.string_init)
        end
        local plain = "false"
        if call.string_plain ~= nil then
            plain = emit_expr(call.string_plain)
        end
        local start_value = fresh("find_start")
        local end_value = fresh("find_end")
        line("int32_t " .. start_value .. " = 0;")
        line("int32_t " .. end_value .. " = 0;")
        line("(void)lusa_string_find_values(" .. source .. ", " .. pattern
            .. ", " .. init .. ", " .. plain .. ", &" .. start_value
            .. ", &" .. end_value .. ");")
        local first = emit_scope_declare(stmt.names[1], "i32", false, false)
        local second = emit_scope_declare(stmt.names[2], "i32", false, false)
        line("int32_t " .. first.cname .. " = " .. start_value .. ";")
        line("int32_t " .. second.cname .. " = " .. end_value .. ";")
        return
    end
    local replacement = emit_expr(call.string_replacement)
    local limit = "-1"
    if call.string_limit ~= nil then
        limit = emit_expr(call.string_limit)
    end
    local text_value = fresh("gsub_text")
    local count_value = fresh("gsub_count")
    line("int32_t " .. count_value .. " = 0;")
    line("LusaString *" .. text_value .. " = lusa_string_gsub("
        .. source .. ", " .. pattern .. ", " .. replacement .. ", "
        .. limit .. ", &" .. count_value .. ");")
    local first = emit_scope_declare(stmt.names[1], "string", true, false)
    local second = emit_scope_declare(stmt.names[2], "i32", false, false)
    line("LusaString *" .. first.cname .. " = " .. text_value .. ";")
    line("int32_t " .. second.cname .. " = " .. count_value .. ";")
end

local function emit_array_initializer(type_name, value)
    local element = array_info(type_name)
    if value == nil then
        return "{0}"
    end
    if value.tag ~= "Array" then
        fail(value.line, value.column,
            "fixed arrays can only be initialized from an array literal in the native backend")
    end
    local parts = {}
    local i = 1
    while i <= #value.items do
        local item = value.items[i]
        local rendered = emit_expr(clone item)
        if is_heap_type(element) and item.own == false then
            rendered = emit_clone_heap(element, rendered)
        end
        parts[#parts + 1] = emit_cast_to(element, rendered)
        i = i + 1
    end
    return "{ " .. table.concat(parts, ", ") .. " }"
end

local function emit_local(stmt)
    if stmt.string_result ~= nil then
        emit_string_result_local(stmt)
        return
    end
    if stmt.pcall ~= nil then
        emit_pcall_local(stmt)
        return
    end
    if stmt.coroutine_resume ~= nil then
        emit_coroutine_resume_local(stmt)
        return
    end
    local names = stmt.names
    local types = stmt.types
    local values = stmt.values
    local temporaries = {}
    local entries = {}
    local array_values = {}
    local i = 1

    while i <= #names do
        local type_name = types[i]
        local value = values[i]
        if is_array_type(type_name) then
            array_values[i] = value
        else
            local temp_name = fresh("init")
            if value ~= nil then
                local rendered = emit_expr(clone value)
                if (type_name == "string" or is_struct_type(type_name))
                    and value.own == false and value.tag ~= "Borrow" then
                    -- Strings and structs are value types: reading a field/index
                    -- copies it, including nested heap fields.
                    rendered = emit_clone_heap(type_name, rendered)
                end
                rendered = emit_cast_to(type_name, rendered)
                line(c_type(type_name) .. " " .. temp_name .. " = " .. rendered .. ";")
                if value.own ~= false then
                    null_moved_source(value, nil)
                end
            else
                line(c_type(type_name) .. " " .. temp_name .. " = "
                    .. default_c(type_name) .. ";")
            end
            temporaries[i] = temp_name
        end
        i = i + 1
    end

    i = 1
    while i <= #names do
        local own = stmt.own[i]
        local entry = emit_scope_declare(names[i], types[i], own,
            values[i] ~= nil and values[i].tag == "Borrow")
        if is_array_type(types[i]) then
            local value = array_values[i]
            line(c_decl(types[i], entry.cname) .. " = "
                .. emit_array_initializer(types[i], clone value) .. ";")
            if value ~= nil then
                local j = 1
                while j <= #value.items do
                    if value.items[j].own ~= false then
                        null_moved_source(value.items[j], nil)
                    end
                    j = j + 1
                end
            end
        else
            line(c_type(types[i]) .. " " .. entry.cname .. " = "
                .. temporaries[i] .. ";")
        end
        entries[i] = entry
        i = i + 1
    end
end

local function emit_assign(stmt)
    local targets = stmt.targets
    local values = stmt.values
    local target_types = stmt.target_types
    local entries = {}
    local temporaries = {}
    local moved = {}
    local moved_seen = {}
    local targets_seen = {}
    local i = 1

    while i <= #values do
        moved, moved_seen = collect_move_entries(
            clone values[i], moved, moved_seen)
        i = i + 1
    end

    i = 1
    while i <= #targets do
        if targets[i].tag == "Name" then
            local entry = emit_value_lookup(targets[i].name)
            if entry == nil then
                fail(targets[i].line, targets[i].column,
                    "internal: assignment target `" .. targets[i].name
                    .. "` was not declared")
            end
            local cname = entry.cname
            entries[i] = entry
            targets_seen[cname] = true
        end
        i = i + 1
    end

    i = 1
    while i <= #targets do
        local temp_name = fresh("assign")
        if i <= #values then
            local rendered = emit_expr(clone values[i])
            line(c_type(target_types[i]) .. " " .. temp_name .. " = "
                .. rendered .. ";")
        else
            line(c_type(target_types[i]) .. " " .. temp_name .. " = "
                .. default_c(target_types[i]) .. ";")
        end
        temporaries[i] = temp_name
        i = i + 1
    end

    i = 1
    while i <= #targets do
        local target = targets[i]
        if target.tag == "Name" then
            local entry = clone entries[i]
            local assigned = temporaries[i]
            if i <= #values and values[i].own == false
                and is_heap_type(target_types[i]) then
                assigned = emit_clone_heap(target_types[i], assigned)
            end
            if moved_seen[entry.cname] ~= true then
                if entry.own and not entry.moved then
                    emit_drop_entry(clone entry)
                end
            end
            assigned = emit_cast_to(target_types[i], assigned)
            line(entry.cname .. " = " .. assigned .. ";")
        elseif target.tag == "Deref" then
            local pointer_value = emit_expr(target.value)
            local value_expr = emit_cast_to(target_types[i], temporaries[i])
            line("(*(" .. pointer_value .. ")) = " .. value_expr .. ";")
        elseif target.tag == "Index" and target.array_access then
            local table_value = emit_expr(target.table)
            local index_value = emit_expr(target.index)
            local access = "(" .. table_value .. ")["
                .. index_value .. "]"
            local assigned = temporaries[i]
            if i <= #values and values[i].own == false
                and is_heap_type(target_types[i]) then
                assigned = emit_clone_heap(target_types[i], assigned)
            end
            assigned = emit_cast_to(target_types[i], assigned)
            if is_heap_type(target_types[i]) then
                emit_drop_place(target_types[i], access)
            end
            line(access .. " = " .. assigned .. ";")
        elseif target.struct_access then
            local table_value = emit_expr(target.table)
            local assigned = temporaries[i]
            if i <= #values and values[i].own == false
                and is_heap_type(target_types[i]) then
                assigned = emit_clone_heap(target_types[i], assigned)
            end
            assigned = emit_cast_to(target_types[i], assigned)
            local access = "(" .. table_value .. ")." .. target.field_name
            if is_heap_type(target_types[i]) then
                if target_types[i] == "string" then
                    line("lusa_drop_string(&" .. access .. ");")
                elseif is_table_type(target_types[i]) then
                    line("lusa_drop_table(&" .. access .. ");")
                elseif is_struct_type(target_types[i]) then
                    line("lusa_drop_" .. target_types[i] .. "(&"
                        .. access .. ");")
                end
            end
            line(access .. " = " .. assigned .. ";")
        else
            local table_value = emit_expr(target.table)
            local string_id = emit_string_ids[target.field_name]
            if string_id == nil then
                fail(target.line, target.column,
                    "internal: field key was not collected")
            end
            local value_expr = temporaries[i]
            if is_heap_type(target_types[i]) and values[i] ~= nil
                and values[i].own == false then
                value_expr = emit_clone_heap(target_types[i], value_expr)
            end
            local payload, value_kind = emit_value_payload(
                { ctype = target_types[i] }, value_expr)
            line("lusa_table_set_string(" .. table_value
                .. ", &lusa_str_" .. tostring(string_id) .. ", "
                .. payload .. ", " .. value_kind .. ");")
            if i <= #values and values[i].own ~= false then
                null_moved_source(values[i], nil)
            end
        end
        i = i + 1
    end

    -- Transfer ownership out of direct source names.  A source that is also
    -- an assignment target now owns the new value and must not be cleared.
    i = 1
    while i <= #values do
        local value = unwrap_paren(values[i])
        if value ~= nil and value.tag == "Name" and value.own ~= false then
            local source = direct_heap_name(value)
            if source ~= nil and targets_seen[source.cname] ~= true then
                null_moved_source(value, targets_seen)
            end
        end
        i = i + 1
    end
end

local function table_getter_for_type(type_name)
    if type_name == "i32" then return "lusa_table_get_i32_at" end
    if type_name == "u32" then return "lusa_table_get_u32_at" end
    if type_name == "f32" then return "lusa_table_get_f32_at" end
    if type_name == "bool" then return "lusa_table_get_bool_at" end
    if type_name == "string" then return "lusa_table_get_string_at" end
    if type_name == "table" or table_element(type_name) ~= nil then
        return "lusa_table_get_table_at"
    end
    return "lusa_table_get_value_at"
end

local function emit_for_in(stmt)
    if stmt.iter_kind == "gmatch" then
        local call = stmt.iter
        local source = emit_expr(call.string_source)
        local pattern = emit_expr(call.string_pattern)
        emit_scope_enter()
        local iter_entry = emit_scope_declare("__lusa_gmatch", "gmatch",
            true, false)
        line("LusaGmatch *" .. iter_entry.cname .. " = lusa_string_gmatch_new("
            .. source .. ", " .. pattern .. ");")
        local loop_scope = emit_scope_count
        emit_loop_stack[#emit_loop_stack + 1] = loop_scope
        local captures = fresh("gmatch_captures")
        local count = stmt.gmatch_count
        local zeros = {}
        local i = 1
        while i <= count do
            zeros[i] = "NULL"
            i = i + 1
        end
        line("LusaString *" .. captures .. "[" .. tostring(count) .. "] = {"
            .. table.concat(zeros, ", ") .. "};")
        line("while (!lusa_error_pending && lusa_string_gmatch_next("
            .. iter_entry.cname .. ", " .. captures .. ", "
            .. tostring(count) .. ")) {")
        emit_indent = emit_indent + 1
        emit_scope_enter()
        i = 1
        while i <= count do
            local entry = emit_scope_declare(stmt.vars[i], "string", true, false)
            line("LusaString *" .. entry.cname .. " = " .. captures
                .. "[" .. tostring(i - 1) .. "];")
            i = i + 1
        end
        emit_block_statements(stmt.body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
        line("}")
        emit_loop_stack[#emit_loop_stack] = nil
        emit_leave_scope()
        return
    end
    local iter_expr = stmt.iter.args[1]
    -- Only a freshly constructed iterator value is owned by the loop; a
    -- variable or field passed to pairs/ipairs stays owned by its scope.
    local iter_tag = unwrap_paren(clone iter_expr).tag
    local iter_owns = iter_tag == "Table" or iter_tag == "Clone"
        or iter_tag == "Call" or iter_tag == "MethodCall"
    emit_scope_enter()
    local iter_entry = emit_scope_declare("__lusa_iter", "table",
        iter_owns and is_table_type(iter_expr.ctype), false)
    local iter_table = iter_entry.cname
    line("LusaTable *" .. iter_table .. " = "
        .. emit_expr(clone iter_expr) .. ";")
    local loop_scope = emit_scope_count
    emit_loop_stack[#emit_loop_stack + 1] = loop_scope
    if stmt.iter_kind == "ipairs" then
        local index = fresh("i")
        line("for (int64_t " .. index .. " = 1; " .. index
            .. " <= (int64_t)(" .. iter_table .. "->obj.length); "
            .. index .. "++) {")
        emit_indent = emit_indent + 1
        emit_scope_enter()
        local key_entry = emit_scope_declare(stmt.vars[1], stmt.key_type,
            false, false)
        line(c_type(stmt.key_type) .. " " .. key_entry.cname
            .. " = (int32_t)(" .. index .. ");")
        if #stmt.vars >= 2 then
            local value_entry = emit_scope_declare(stmt.vars[2],
                stmt.value_type, false, false)
            line(c_type(stmt.value_type) .. " " .. value_entry.cname .. " = "
                .. table_getter_for_type(stmt.value_type) .. "("
                .. iter_table .. ", " .. index .. ");")
        end
        emit_block_statements(stmt.body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
        line("}")
    else
        local cursor = fresh("cursor")
        local key_value = fresh("key")
        local item_value = fresh("value")
        line("uint64_t " .. cursor .. " = 0u;")
        line("LusaString *" .. key_value .. " = NULL;")
        line("LusaValue " .. item_value .. " = {LUSA_ELEM_UNKNOWN, 0u};")
        line("while (lusa_table_next_pair(" .. iter_table .. ", &" .. cursor
            .. ", &" .. key_value .. ", &" .. item_value .. ")) {")
        emit_indent = emit_indent + 1
        emit_scope_enter()
        local key_entry = emit_scope_declare(stmt.vars[1], "string", false, false)
        line("LusaString *" .. key_entry.cname .. " = " .. key_value .. ";")
        if #stmt.vars >= 2 then
            local value_entry = emit_scope_declare(stmt.vars[2], "value", false, false)
            line("LusaValue " .. value_entry.cname .. " = " .. item_value .. ";")
        end
        emit_block_statements(stmt.body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
        line("}")
    end
    emit_loop_stack[#emit_loop_stack] = nil
    emit_leave_scope()
end

local function emit_if(stmt)
    local i = 1
    while i <= #stmt.branches do
        local branch = stmt.branches[i]
        if branch == nil then
            fail(stmt.line, stmt.column, "internal: if branch is nil")
        end
        if branch.cond == nil then
            fail(stmt.line, stmt.column, "internal: if condition is nil")
        end
        if branch.body == nil then
            fail(stmt.line, stmt.column, "internal: if body is nil")
        end
        local condition = emit_expr(branch.cond)
        if i == 1 then
            line("if (" .. condition .. ") {")
        else
            line("} else if (" .. condition .. ") {")
        end
        emit_indent = emit_indent + 1
        emit_scope_enter()
        emit_block_statements(branch.body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
        i = i + 1
    end
    if stmt.else_body ~= nil then
        line("} else {")
        emit_indent = emit_indent + 1
        emit_scope_enter()
        emit_block_statements(stmt.else_body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
    end
    line("}")
end

local function emit_while(stmt)
    local loop_scope = emit_scope_count
    emit_loop_stack[#emit_loop_stack + 1] = loop_scope
    local condition = emit_expr(stmt.cond)
    line("while (1) {")
    emit_indent = emit_indent + 1
    line("if (!(" .. condition .. ")) break;")
    emit_scope_enter()
    emit_block_statements(stmt.body)
    emit_leave_scope()
    emit_indent = emit_indent - 1
    line("}")
    emit_loop_stack[#emit_loop_stack] = nil
end

local function emit_repeat(stmt)
    local loop_scope = emit_scope_count
    emit_loop_stack[#emit_loop_stack + 1] = loop_scope
    line("while (1) {")
    emit_indent = emit_indent + 1
    emit_scope_enter()
    emit_block_statements(stmt.body)
    local condition = emit_expr(stmt.cond)
    line("if (" .. condition .. ") {")
    emit_indent = emit_indent + 1
    emit_scope_drops(emit_scope_count)
    line("break;")
    emit_indent = emit_indent - 1
    line("}")
    emit_scope_drops(emit_scope_count)
    emit_scope_pop_without_drops()
    emit_indent = emit_indent - 1
    line("}")
    emit_loop_stack[#emit_loop_stack] = nil
end

local function emit_do(stmt)
    line("{")
    emit_indent = emit_indent + 1
    emit_scope_enter()
    emit_block_statements(stmt.body)
    emit_leave_scope()
    emit_indent = emit_indent - 1
    line("}")
end

local function emit_return(stmt)
    local values = stmt.values
    local return_type = stmt.ret_type or emit_return_type
    if #values == 0 then
        emit_all_drops()
        if emit_is_main then
            emit_global_drops()
            line("return 0;")
        else
            line("return;")
        end
        return
    end

    local value = values[1]
    local rendered = emit_expr(clone value)
    if value.own == false and is_heap_type(return_type) then
        -- The caller receives an owned value; a view into a local table (or a
        -- borrowed parameter) must be copied before this scope is torn down.
        rendered = emit_clone_heap(return_type, rendered)
    end
    rendered = emit_cast_to(return_type, rendered)
    local temp_name = fresh("ret")
    line(c_type(return_type) .. " " .. temp_name .. " = " .. rendered .. ";")
    line("if (lusa_error_pending) {")
    emit_indent = emit_indent + 1
    emit_all_drops()
    if emit_is_main then
        emit_global_drops()
        line("return lusa_error_report();")
    elseif return_type == "void" then
        line("return;")
    else
        line("return " .. default_c(return_type) .. ";")
    end
    emit_indent = emit_indent - 1
    line("}")
    if value.own ~= false then
        null_moved_source(value, nil)
    end
    emit_all_drops()
    if emit_is_main then
        emit_global_drops()
        line("return (int)(" .. temp_name .. ");")
    else
        line("return " .. temp_name .. ";")
    end
end

local function emit_break(stmt)
    if #emit_loop_stack == 0 then
        fail(stmt.line, stmt.column, "internal: break outside a loop")
    end
    emit_coro_closing_check()
    local loop_scope = emit_loop_stack[#emit_loop_stack]
    local i = emit_scope_count
    while i > loop_scope do
        emit_scope_drops(i)
        i = i - 1
    end
    line("break;")
end

emit_stmt = function(stmt)
    local tag = stmt.tag
    if tag == "Local" then
        emit_local(stmt)
        return
    end
    if tag == "Assign" then
        emit_assign(stmt)
        return
    end
    if tag == "CallStmt" then
        if stmt.value.builtin == "print" then
            emit_print_call(stmt.value)
        else
            line("(void)(" .. emit_expr(stmt.value) .. ");")
        end
        return
    end
    if tag == "If" then
        emit_if(stmt)
        return
    end
    if tag == "While" then
        emit_while(stmt)
        return
    end
    if tag == "Repeat" then
        emit_repeat(stmt)
        return
    end
    if tag == "ForIn" then
        emit_for_in(stmt)
        return
    end
    if tag == "Do" then
        emit_do(stmt)
        return
    end
    if tag == "Unsafe" then
        line("/* unsafe: raw memory access */ {")
        emit_indent = emit_indent + 1
        emit_scope_enter()
        emit_block_statements(stmt.body)
        emit_leave_scope()
        emit_indent = emit_indent - 1
        line("}")
        return
    end
    if tag == "Return" then
        emit_return(stmt)
        return
    end
    if tag == "Break" then
        emit_break(stmt)
        return
    end
    if tag == "Function" then
        return
    end
    if tag == "Struct" then
        -- The typedef is emitted once in the preamble; the statement itself
        -- produces no runtime code.
        return
    end
    fail(stmt.line, stmt.column,
        "internal: unsupported statement node `" .. tostring(tag) .. "`")
end

emit_block_statements = function(body)
    if body == nil then
        fail(0, 0, "internal: nil statement block reached the C emitter")
    end
    local count = #body
    local i = 1
    while i <= count do
        local stmt = body[i]
        local tag = stmt.tag
        emit_stmt(stmt)
        if tag ~= "Return" and tag ~= "Break"
            and tag ~= "Function" and tag ~= "Struct" then
            emit_error_check()
            emit_coro_closing_check()
        end
        i = i + 1
    end
end

-- ---- program assembly ----------------------------------------------------

local function setup_symbols(ast)
    local i = 1
    while i <= #ast.globals do
        local global = ast.globals[i]
        local cname = fresh("g")
        global.cname = cname
        global.moved = false
        local drop_entry = clone global
        emit_globals[global.name] = global
        emit_global_order[#emit_global_order + 1] = drop_entry
        i = i + 1
    end

    i = 1
    while i <= #ast.function_names do
        local name = ast.function_names[i]
        local signature = clone ast.signatures[name]
        local cname = fresh("f")
        signature.cname = cname
        signature.param_cnames = {}
        local j = 1
        while j <= #signature.params do
            signature.param_cnames[j] = fresh("p")
            j = j + 1
        end
        emit_function_cnames[name] = cname
        emit_functions[#emit_functions + 1] = signature
        i = i + 1
    end
end

local function emit_struct_declarations(ast)
    local names = ast.struct_names or {}
    if #names == 0 then
        return
    end
    local i = 1
    while i <= #names do
        local name = clone names[i]
        local layout = borrow ast.structs[name]
        local packed = layout.packed == true
        local align = layout.align
        if packed then
            line("LUSA_PACK_BEGIN")
            line("typedef struct LUSA_PACKED {")
        else
            line("typedef struct {")
        end
        emit_indent = emit_indent + 1
        local j = 1
        while j <= #layout.order do
            local field_name = clone layout.order[j]
            local field_type = clone (borrow layout.fields[field_name]).type
            local declaration = c_decl(field_type, field_name) .. ";"
            if j == 1 and align ~= nil then
                -- Member alignment raises the enclosing struct's alignment
                -- and remains valid C11 on every supported toolchain.
                declaration = "LUSA_ALIGNAS(" .. tostring(align) .. ") "
                    .. declaration
            end
            line(declaration)
            j = j + 1
        end
        emit_indent = emit_indent - 1
        line("} " .. name .. ";")
        if packed then
            line("LUSA_PACK_END")
        end
        line("")
        i = i + 1
    end

    -- Deep drop/clone helpers. Structs may only contain previously declared
    -- structs, so declaration order also defines helper dependency order.
    i = 1
    while i <= #names do
        local name = clone names[i]
        local layout = borrow ast.structs[name]
        line("static void lusa_drop_" .. name .. "(" .. name .. " *value) {")
        emit_indent = emit_indent + 1
        line("if (value == NULL) return;")
        local j = 1
        while j <= #layout.order do
            local field_name = clone layout.order[j]
            local field_type = clone (borrow layout.fields[field_name]).type
            local access = "value->" .. field_name
            local array_element, array_length = array_info(field_type)
            if array_element ~= nil then
                if is_heap_type(array_element) then
                    line("for (int32_t lusa_i = 0; lusa_i < "
                        .. tostring(array_length) .. "; lusa_i++) {")
                    emit_indent = emit_indent + 1
                    emit_drop_place(array_element,
                        access .. "[lusa_i]")
                    emit_indent = emit_indent - 1
                    line("}")
                end
            else
                emit_drop_place(field_type, access)
            end
            j = j + 1
        end
        emit_indent = emit_indent - 1
        line("}")
        line("")

        line("static " .. name .. " lusa_clone_" .. name .. "("
            .. name .. " value) {")
        emit_indent = emit_indent + 1
        j = 1
        while j <= #layout.order do
            local field_name = clone layout.order[j]
            local field_type = clone (borrow layout.fields[field_name]).type
            local access = "value." .. field_name
            local array_element, array_length = array_info(field_type)
            if array_element ~= nil then
                if is_heap_type(array_element) then
                    line("for (int32_t lusa_i = 0; lusa_i < "
                        .. tostring(array_length) .. "; lusa_i++) {")
                    emit_indent = emit_indent + 1
                    emit_clone_place(array_element,
                        access .. "[lusa_i]")
                    emit_indent = emit_indent - 1
                    line("}")
                end
            else
                emit_clone_place(field_type, access)
            end
            j = j + 1
        end
        line("return value;")
        emit_indent = emit_indent - 1
        line("}")
        line("")
        i = i + 1
    end
end

local function emit_globals_declarations()
    local i = 1
    while i <= #emit_global_order do
        -- Declaration only inspects metadata; cloning keeps the entry in the
        -- drop list for the normal and error exits of `main`.
        local global = clone emit_global_order[i]
        line("static " .. c_decl(global.type, global.cname)
            .. " = " .. default_c(global.type) .. ";")
        i = i + 1
    end
    if #emit_global_order > 0 then
        line("")
    end
end

local function emit_function_prototypes()
    local i = 1
    while i <= #emit_functions do
        local signature = clone emit_functions[i]
        local params = { "LusaCoro *lusa_co" }
        local j = 1
        while j <= #signature.params do
            params[#params + 1] = c_type(signature.params[j].type) .. " "
                .. signature.param_cnames[j]
            j = j + 1
        end
        local param_text = table.concat(params, ", ")
        line("static " .. c_type(signature.ret) .. " " .. signature.cname
            .. "(" .. param_text .. ");")
        i = i + 1
    end
    if #emit_functions > 0 then
        line("")
    end
end

local function emit_function_definition(signature)
    local params = { "LusaCoro *lusa_co" }
    local j = 1
    while j <= #signature.params do
        params[#params + 1] = c_type(signature.params[j].type) .. " "
            .. signature.param_cnames[j]
        j = j + 1
    end
    local param_text = table.concat(params, ", ")

    line("static " .. c_type(signature.ret) .. " " .. signature.cname
        .. "(" .. param_text .. ") {")
    emit_indent = emit_indent + 1

    local previous_return = emit_return_type
    local previous_main = emit_is_main
    local previous_loops = emit_loop_stack
    emit_return_type = signature.ret
    emit_is_main = false
    emit_loop_stack = {}

    emit_scope_enter()
    local param_count = #signature.params
    j = 1
    while j <= param_count do
        local param = signature.params[j]
        local entry = {
            name = param.name,
            cname = signature.param_cnames[j],
            type = param.type,
            own = false,
            borrowed = true,
            moved = false
        }
        local scope = emit_scopes[emit_scope_count]
        local order_entry = clone entry
        scope.vars[param.name] = entry
        local order = scope.order
        order[#order + 1] = order_entry
        scope.order = order
        emit_scopes[emit_scope_count] = scope
        j = j + 1
    end

    emit_block_statements(signature.node.body)
    emit_leave_scope()
    if signature.ret == "void" then
        line("return;")
    else
        line("return " .. default_c(signature.ret) .. ";")
    end

    emit_indent = emit_indent - 1
    line("}")
    line("")

    emit_return_type = previous_return
    emit_is_main = previous_main
    emit_loop_stack = previous_loops
end

local function emit_main(ast)
    emit_is_main = true
    emit_return_type = "i32"
    line("int main(void) {")
    emit_indent = emit_indent + 1
    emit_scope_enter()
    emit_block_statements(ast.body)
    emit_leave_scope()
    emit_global_drops()
    line("lusa_free_allocs();")
    line("return 0;")
    emit_indent = emit_indent - 1
    line("}")
end

local function emit_c_impl(ast)
    reset_emitter()
    collect_strings_block(clone ast.body)
    setup_symbols(clone ast)

    put("/* generated by Lusa " .. tostring(COMPILER_VERSION)
        .. " - C11 backend.  Do not edit by hand. */")
    put("")
    local i = 1
    while i <= #RUNTIME do
        put(RUNTIME[i])
        i = i + 1
    end
    i = 1
    while i <= #COROUTINE_RUNTIME do
        put(COROUTINE_RUNTIME[i])
        i = i + 1
    end
    put("")
    emit_static_strings()
    emit_static_ints()
    emit_struct_declarations(borrow ast)
    emit_globals_declarations()
    emit_function_prototypes()

    i = 1
    while i <= #emit_functions do
        emit_function_definition(emit_functions[i])
        i = i + 1
    end
    emit_main(clone ast)
    return table.concat(emit_out, "\n") .. "\n"
end

-- =========================================================================
-- Memory ABI description
-- =========================================================================

function Compiler.memory_layout()
    return {
        scalar = "native C scalar in a local or function argument",
        c_types = {
            u32 = "uint32_t",
            i32 = "int32_t",
            i128 = "lusa_i128 (__int128 when the C compiler provides it)",
            f32 = "float",
            bool = "bool (<stdbool.h>)",
            string = "LusaString * (LusaObj length + NUL-terminated data)",
            table = "LusaTable *",
            ["struct"] = "native C typedef struct with fields in declaration order"
        },
        value_header = {
            size = 32,
            type = "u64 at +0: 1 = string, 2 = table",
            length = "u64 at +8: string bytes or table element count",
            flags = "u64 at +16: bit 0 = owned by the program",
            allocation = "u64 at +24: logical allocation size",
            payload = "the C struct begins at +0"
        },
        string = "LusaString { LusaObj obj; char *data; } with UTF-8 + NUL data",
        table = "LusaTable { LusaObj obj; elem_kind; capacity; items; key_count; map_capacity; LusaEntry *entries; } with 1-based array access and string-keyed open addressing",
        keyed_table = "LusaEntry { LusaString *key; uint64_t value; uint64_t kind; } with linear probing and FNV-1a hashing",
        methods = "colon methods lower to static C functions; `self` is a non-owning LusaTable pointer",
        iterators = "ipairs walks the 1-based array part; pairs walks the keyed hash entries",
        structs = "both `struct Name { field: type, ... }` and `struct Name field: type, ... end` become a C typedef struct with natural alignment; `Name{field: value}` literals initialize fields by name, and `value.field` compiles to a direct member offset",
        struct_drop = "each struct receives a generated `lusa_drop_Name`/`lusa_clone_Name` pair; heap fields (string, table, nested heap-bearing structs) are dropped in declaration order and deep-cloned on copy",
        ["match"] = "`match value with | literal => ... | name => ... | _ => ... end` lowers to a hidden local plus an ordinary if/elseif chain; ownership is checked per arm at compile time with no runtime dispatch",
        imports = "`import 'file.lusa'` and `mod name` are expanded at compile time relative to the importing file; the merged source shares one symbol table and each module is included once",
        pointers = "*mut u32/*const u32 and *mut i32/*const i32 lower to volatile C pointers; pointer arithmetic scales by the element size and dereferences are volatile reads/writes",
        intrinsics = "asm!/unsafe_asm/unsafe_nop lower to LUSA_ASM(text)/LUSA_NOP() - `__asm__ __volatile__ (text : : );` on GCC/Clang, no-ops elsewhere",
        table_kinds = {
            unknown = 0, i32 = 1, u32 = 2, i128 = 3,
            f32 = 4, bool = 5, string = 6, table = 7
        },
        allocator = {
            create = "malloc/calloc/realloc",
            release = "free",
            table = "realloc-backed reserve, deep drop recursively frees string/table items"
        },
        drop_rule = "reverse declaration order at lexical exit, before return/break, and before assignment overwrites an owned value; compile-time drop lists are never consumed by declarations or error paths; struct locals use their generated deep-drop helper",
        move_rule = "the destination takes the pointer, the source slot is cleared, and the source drop is cancelled; moved struct values have no NULL sentinel, so the persisted moved flag alone cancels their drop",
        borrow_rule = "no allocation and no drop; the alias is only valid while the owner lives",
        clone_rule = "deep clone for strings, tables, and structs with heap fields; scalar clone is a copy",
        ["unsafe"] = {
            block = "`unsafe do ... end`; disables the local borrow-assignment rule",
            pointer_cast = "unsafe_ptr_cast(address) -> i128 (C uintptr_t)",
            read_mem = "unsafe_read_mem(address) -> u32",
            write_mem = "unsafe_write_mem(address, value) -> void",
            c_access = "writes: *(volatile uint32_t *)(uintptr_t)address = value; reads: (*(volatile uint32_t *)(uintptr_t)address)"
        }
    }
end

-- =========================================================================
-- Public API
-- =========================================================================

local function snapshot_program(borrow_ast)
    if type(borrow_ast) ~= "table" or borrow_ast.tag ~= "Program" then
        fail(0, 0, "expected a Program AST")
    end
    return {
        tag = "Program",
        body = clone borrow_ast.body,
        line = borrow_ast.line,
        column = borrow_ast.column
    }
end

local function compile_checked(borrow_ast)
    local snapshot = snapshot_program(borrow_ast)
    local optimized = optimize_impl(snapshot)
    optimized = check_program(optimized)
    return emit_c_impl(optimized)
end

function Compiler.emit_c(borrow_ast)
    return compile_checked(borrow_ast)
end

local function bootstrap_impl(lexer, parser, source)
    local tokens = lexer.lex(source)
    local ast = parser.parse(tokens)
    local c_source = compile_checked(ast)
    return {
        target = "c11",
        source_bytes = #source,
        c_source = c_source,
        c_bytes = #c_source
    }
end

function Compiler.bootstrap(lexer, parser, source)
    return bootstrap_impl(lexer, parser, source)
end

function Compiler.write_c(path, c_source)
    return io_write_binary(path, c_source)
end

function Compiler.verify_fixpoint(lexer, parser, source)
    local first = bootstrap_impl(clone lexer, clone parser, source)
    local second = bootstrap_impl(clone lexer, clone parser, source)
    return {
        equal = first.c_source == second.c_source,
        first = first,
        second = second
    }
end

function Compiler.self_compile(lexer, parser, path)
    local source = io_read_file(path or "compiler_bootstrap.lusa")
    local lex_ok, tokens = pcall(function()
        return lexer.lex(source)
    end)
    if not lex_ok then
        return {
            ok = false, stage = "lexer", error = tokens,
            note = "the self-hosted lexer could not process the compiler source"
        }
    end
    local parse_ok, ast = pcall(function()
        return parser.parse(tokens)
    end)
    if not parse_ok then
        return {
            ok = false, stage = "frontend", error = ast,
            note = "the reference parser still lacks some front-end constructs used by the compiler source"
        }
    end
    local emit_ok, c_source = pcall(function()
        return compile_checked(ast)
    end)
    if not emit_ok then
        return {
            ok = false, stage = "backend", error = c_source,
            note = "the C backend rejected a construct used by the compiler source"
        }
    end
    return {
        ok = true, target = "c11", c_source = c_source, c_bytes = #c_source
    }
end

return transfer(Compiler)
