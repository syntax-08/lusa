-- Module 10 example: keyed tables, methods, and generic iterators.
--   lusalang run examples/keyed_objects.lusa
--   lusalang run examples/keyed_objects.lusa --vm
--   lusalang build examples/keyed_objects.lusa

local user = {
    id = 1,
    name = "Lusa",
    profile = { city = "Oslo" },
}

print(user.id, user.name, user.profile.city)
user.name = "New"
user.profile.city = "Bergen"

function user:greet(prefix: string): string
    return prefix .. self.name
end

print(user:greet("hello "))

local settings = { width = 800, height = 600 }
local setting_count = 0
for key, value in pairs(settings) do
    setting_count = setting_count + 1
end

local total = 0
for index, value in ipairs({10, 20, 30}) do
    total = total + value
end

print("settings:", setting_count, "total:", total)
return 0
