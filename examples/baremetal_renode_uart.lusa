-- Module 24 example: bare-metal UART output on the Renode RISC-V `virt` board.
--
--   lusalang build examples/baremetal_renode_uart.lusa --target riscv32-virt
--   lusalang build examples/baremetal_renode_uart.lusa --target riscv64-virt
--   lusalang build examples/baremetal_renode_uart.lusa --emit-c
--
-- The program parks forever after writing, so it is intended for Renode or a
-- real board rather than `lusalang run`.
--
-- The Renode `riscv_virt` platform maps an NS16550 UART at 0x10000000 and
-- loads RAM at 0x80000000. This program writes a banner one `u32` at a time;
-- Lusa currently has no `u8` scalar, so bytes travel through the 32-bit
-- register alias that Renode's NS16550 accepts. `#[no_std]` keeps libc out of
-- the image, and `#[entry]` exports `_start` for the startup stub. The same
-- source builds for `riscv32-virt` and `riscv64-virt`, so the banner names the
-- board family rather than one word size.
--
-- On real hardware, poll the line-status register (bit 5, THRE) before each
-- write, or use the driver supplied by the board vendor.

#[no_std]

function uart_putc(byte: u32): void
    unsafe do
        local uart: *mut u32 = 0x10000000
        uart.write_volatile(byte)
    end
end

#[entry]
function _start(): void
    -- The local array keeps the banner in the generated C as an aggregate
    -- initializer; no libc `memcpy` or string runtime is involved.
    -- "LUSA RENODE UART OK\nlusa virt v2.0.0\n\n"
    local message: [u32; 38] = [
        76, 85, 83, 65, 32, 82, 69, 78, 79, 68, 69, 32, 85, 65, 82, 84,
        32, 79, 75, 10,
        108, 117, 115, 97, 32, 118, 105, 114, 116, 32, 118, 50, 46, 48,
        46, 48, 10, 10
    ]

    local i: u32 = 0
    while i < 38 do
        uart_putc(message[i])
        i = i + 1
    end

    -- The reset stub has nowhere to return to on the emulated board.
    while true do
    end
end
