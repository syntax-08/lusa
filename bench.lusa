-- bench.lusa — typical loads: recursion, arithmetic, strings, tables

-- 1) recursion (frame pressure + calls)
local function fib(n)
    if n < 2 then return n end
    return fib(n - 1) + fib(n - 2)
end
print("fib(24) =", fib(24))

-- 2) arithmetic loop (2M iterations)
local acc = 0
for i = 1, 2000000 do
    acc = acc + (i % 7) * 3
end
print("acc =", acc)

-- 3) strings + interpolation (200K strings)
local parts = ""
for i = 1, 200000 do
    parts = "x\{i%97}"
end
print("str-loop ok:", parts == "x\{200000 % 97}")

-- 4) tables: creates 100K rows
local rows = {}
for i = 1, 100000 do
    rows[i] = {i, i * 2}
end
print("rows:", #rows, "last:", rows[100000][1], rows[100000][2])
