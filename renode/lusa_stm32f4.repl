// Minimal STM32F4 platform: 1 MiB flash, 128 KiB SRAM, USART2, GPIOA/B, TIM2,
// SPI1, I2C1, and the Cortex-M4 NVIC/SysTick.  The `lusa::hal` tests (Module
// 27) talk to an SPI loopback (MISO wired to MOSI) on SPI1 and an echo device
// at I2C address 0x55, which replays the bytes last written to it.  RCC is
// plain memory so clock-enable writes read back.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

uart0: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x40020000, +0x400>
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x40020400, +0x400>
    numberOfAFs: 16

rcc: Memory.MappedMemory @ sysbus 0x40023800
    size: 0x400

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ -> nvic@35

spiLoopback: SPI.SPILoopback @ spi1

// The STM32F4 I2C block is register-compatible with Renode's STM32F1 model.
i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2cEcho: Mocks.EchoI2CDevice @ i2c1 0x55

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 168000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
