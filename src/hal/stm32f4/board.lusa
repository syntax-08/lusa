-- STM32F4 board support shared by the drivers (`super::` from each driver).
--
-- Lusa has no bitwise operators, so register fields are updated with
-- arithmetic: a power-of-two `mask` selects one bit, and a field is described
-- by its lowest bit value `unit` and its number of states `span`.  Addresses
-- are decimal; the hexadecimal value is in the comment.

function mmio_read(address: u32): u32
    local value: u32 = 0
    unsafe do
        local reg: *mut u32 = unsafe_ptr_cast(address)
        value = reg.read_volatile()
    end
    return value
end

function mmio_write(address: u32, value: u32): void
    unsafe do
        local reg: *mut u32 = unsafe_ptr_cast(address)
        reg.write_volatile(value)
    end
end

function has_bit(value: u32, mask: u32): bool
    return (value // mask) % 2 ~= 0
end

function with_bit(value: u32, mask: u32): u32
    if has_bit(value, mask) then
        return value
    end
    return value + mask
end

function without_bit(value: u32, mask: u32): u32
    if has_bit(value, mask) then
        return value - mask
    end
    return value
end

-- `value` with the field [unit, unit * span) replaced by `field`.
function with_field(value: u32, unit: u32, span: u32, field: u32): u32
    local old: u32 = (value // unit) % span
    return value - old * unit + (field % span) * unit
end

function mmio_set(address: u32, mask: u32): void
    mmio_write(address, with_bit(mmio_read(address), mask))
end

function mmio_field(address: u32, unit: u32, span: u32, field: u32): void
    mmio_write(address, with_field(mmio_read(address), unit, span, field))
end

function pow2(exponent: u32): u32
    local value: u32 = 1
    local i: u32 = 0
    while i < exponent do
        value = value * 2
        i = i + 1
    end
    return value
end

-- NVIC_ISERn (0xE000E100) is write-one-to-set, so other lines are untouched.
function nvic_enable(irq: u32): void
    mmio_write(3758153984 + (irq // 32) * 4, pow2(irq % 32))
end

-- RCC_AHB1ENR (0x40023830), RCC_APB1ENR (0x40023840), RCC_APB2ENR
-- (0x40023844): peripheral clock gates.
function clock_ahb1(mask: u32): void
    mmio_set(1073887280, mask)
end

function clock_apb1(mask: u32): void
    mmio_set(1073887296, mask)
end

function clock_apb2(mask: u32): void
    mmio_set(1073887300, mask)
end

-- Puts GPIO `pin` of the port at `port` into alternate function `af`.
-- MODER is at +0x00 (2 bits per pin), AFRL/AFRH at +0x20/+0x24 (4 bits).
function gpio_alternate(port: u32, pin: u32, af: u32): void
    mmio_field(port, pow2(pin * 2), 4, 2)
    if pin < 8 then
        mmio_field(port + 32, pow2(pin * 4), 16, af)
    else
        mmio_field(port + 36, pow2((pin - 8) * 4), 16, af)
    end
end

-- The bus clocks after reset: 16 MHz HSI with APB1 = APB2 = AHB.
function pclk(): u32
    return 16000000
end
